# =============================================================================
# MangosSuperUI .gitignore
# =============================================================================

# ----- .NET Build Artifacts -----
bin/
obj/
*.user
*.suo
*.cache
*.dll
*.pdb
*.exe
publish/

# ----- IDE / Editor -----
.vs/
.vscode/
*.swp
*.swo
*~
.idea/

# ----- NuGet -----
*.nupkg
packages/

# ----- Per-Install Configuration -----
# Generated by the setup script — contains DB credentials and local paths
server-config.json

# ----- WoW Client Assets (Blizzard copyrighted — NOT distributable) -----
# These are extracted from the user's own WoW 1.12.1 client via the Extractor tool.
**/wwwroot/icons/
**/wwwroot/models/
**/wwwroot/item_models/
**/wwwroot/minimap/
**/wwwroot/character_models/
**/wwwroot/character_textures/
**/wwwroot/armor_forge_cache/
**/wwwroot/body_atlas_cache/

# Keep the directories in the repo with .gitkeep so the folder structure exists
!**/wwwroot/icons/.gitkeep
!**/wwwroot/models/.gitkeep
!**/wwwroot/item_models/.gitkeep
!**/wwwroot/minimap/.gitkeep
!**/wwwroot/character_models/.gitkeep
!**/wwwroot/character_textures/.gitkeep

# ----- OS Junk -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- Logs -----
*.log

# ----- Owner-local tooling + planning docs (NOT for the public repo) -----
# The root tools/ tree (port research, worldstate-clinical-check, etc.) plus the internal planning
# docs are owner-local — they contain homeserver IPs, SSH key names, DB details, and internal paths,
# so they are transferred privately, never published.
#
# Each rule is anchored to the file's actual location. The study docs now live under /docs/, and
# these paths must move with them: an anchored rule silently stops matching when the file moves,
# which would republish an owner-local document as an ordinary untracked file.
/tools/
/CMANGOS_PORT.md
/WEAPON_GEN.md
/docs/WORLD_STATE.md
/docs/CIRCUIT_BOARD.md
/docs/CIRCUIT_BOARD_CL_DISC1.md
/docs/ADDENDUM_FINDINGS_WRAP_UP.md

# ----- Weapon Forge: docs + sample art only (code IS committed) -----
/WEAPON_FORGE.md
/MangosSuperUI/wwwroot/weapon-forge/
/.claude
/docs/SUPERUI_CORE_CONTENT_REORGANIZATION.md
/CMANGOS_PORT.md
/WEAPON_GEN.md
/ARMOR_FORGE.md
/MangosSuperUI.Tests/Properties/PublishProfiles/FolderProfile.pubxml

# ----- Local rollback bundles -----
# backups/<change>/{original,patched}/ are point-in-time copies made before a
# risky edit. They are pure duplicates of files git already versions — "original"
# is the committed state and "patched" is the working tree — so committing them
# doubles the diff for no recoverable information. One bundle was 23,503 lines,
# roughly 87% of everything untracked in the repo.
# They stay on disk for local restore; git is the real history.
/backups/

# ----- Equipment / world-building QA output -----
# Review captures, fitted renders, packed MPQs and GLBs derived from original-client art.
# Tens of thousands of generated files; the web app's review pages read
# wwwroot/equipment-workshop locally, but none of it belongs in the repo.
/artifacts/
/scratch/
/MangosSuperUI/wwwroot/equipment-workshop/
imgui.ini
