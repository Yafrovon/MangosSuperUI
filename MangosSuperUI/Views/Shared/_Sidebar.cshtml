<!-- ========== Customize Modal ========== -->
<div class="customize-overlay" id="customizeOverlay">
    <div class="customize-modal">
        <div class="customize-header">
            <h3><i class="fa-solid fa-palette"></i> Customize</h3>
            <button class="customize-close" id="btnCloseCustomize"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Tabs -->
        <div class="customize-tabs">
            <button class="customize-tab active" data-tab="order"><i class="fa-solid fa-arrows-up-down"></i> Order</button>
            <button class="customize-tab" data-tab="visibility"><i class="fa-solid fa-eye"></i> Visibility</button>
            <button class="customize-tab" data-tab="theme"><i class="fa-solid fa-droplet"></i> Theme</button>
        </div>

        <!-- Tab: Reorder -->
        <div class="customize-body customize-tab-content active" data-tab-content="order">
            <p class="customize-hint">Drag groups (within their section) or items within groups to reorder. Changes apply instantly.</p>
            <div class="reorder-list" id="reorderGroupList">
                <!-- Populated by JS -->
            </div>
        </div>

        <!-- Tab: Visibility -->
        <div class="customize-body customize-tab-content" data-tab-content="visibility">
            <p class="customize-hint">Toggle sidebar groups on or off. Hidden groups won't appear under their section. The group containing the current page is always visible.</p>
            <div id="visibilityList">
                <!-- Populated by JS -->
            </div>
        </div>

        <!-- Tab: Theme -->
        <div class="customize-body customize-tab-content" data-tab-content="theme">
            <p class="customize-hint">Pick a theme and change any color options to your liking. Changes preview live.</p>

            <div class="theme-section">
                <div class="theme-row">
                    <label>Theme</label>
                    <select class="theme-mode-select" id="themeModeSelect">
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </div>
            </div>

            <div class="theme-section">
                <div class="theme-section-label">Sidebar &amp; Top Bar</div>
                <div class="theme-row">
                    <label>Background</label>
                    <input type="color" class="theme-color-input" data-var="--bg-sidebar" />
