@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action = "Index")
    {
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    // Which group contains the active page? (used by JS to auto-expand)
    string activeGroup = currentController.ToLower() switch
    {
        "home" or "console" or "players" or "accounts" or "realm" => "operations",
        "serverlogs" or "livelogs" or "config" => "server",
        "worlds" or "changes" or "activity" => "state",
        "spells" or "spellcompleter" => "spells",
        "patch" => currentAction.Equals("VisualLab", StringComparison.OrdinalIgnoreCase) ? "archive" : "spells",
        "gameobjects" => "archive",
        "items" or "retextureengine" => "content",
        "loottuner" or "instances" or "lootifier" or "questlootifier" or "craftinglootifier" or "professiontuning" => "loot",
        "worldeditor" or "worldmap" => "world",
        "database" or "functiongraph" or "sourcemap" => "data",
        "circuittrace" => "devtools",
        "weaponforge" or "armorforge" => "gamedev",
        "bots" or "chatsettings" => "bots",
        "wiki" => "wiki",
        "armory" => "gameworld",
        "downloads" or "settings" => "superui",
        _ => ""
    };

    // Which macro section contains that group?
    string activeSection = activeGroup switch
    {
        "operations" or "server" or "state" => "admin",
        "content" or "loot" or "spells" or "world" or "archive" => "tuning",
        "bots" => "aibots",
        "data" or "devtools" or "gamedev" => "devdata",
        "wiki" => "wiki",
        "gameworld" or "superui" => "superui",
        _ => "admin"
    };

    // Macro sections. Ctl/Act is the fallback landing page for the tab;
    // site.js upgrades each tab's href to the first visible page in the section.
    var macroSections = new[]
    {
        new { Key = "admin",   Label = "Server Administration", Icon = "fa-server",   Sub = "Operations, players & server health", Ctl = "Home",      Act = "Index" },
        new { Key = "tuning",  Label = "Gameplay Tuning",       Icon = "fa-sliders",  Sub = "Items, loot, spells & the world",     Ctl = "Items",     Act = "Index" },
        new { Key = "aibots",  Label = "AI Bot Control",        Icon = "fa-robot",    Sub = "Fleet, brains & chat",                Ctl = "Bots",      Act = "Fleet" },
        new { Key = "devdata", Label = "Data & Development",    Icon = "fa-database", Sub = "Database, source & tooling",          Ctl = "Database",  Act = "Index" },
        new { Key = "wiki",    Label = "Wiki",                  Icon = "fa-book",     Sub = "Documentation",                       Ctl = "Wiki",      Act = "Index" },
        new { Key = "superui", Label = "SuperUI",               Icon = "fa-toolbox",  Sub = "Armory, downloads & settings",                Ctl = "Downloads", Act = "Index" }
    };

    var activeMeta = macroSections[0];
    foreach (var s in macroSections)
    {
        if (s.Key == activeSection) { activeMeta = s; }
    }
}

<!-- ========== Top Navigation (macro sections) ========== -->
<nav class="topnav">
    <a class="topnav-brand" asp-controller="Home" asp-action="Index">
        <span class="topnav-brand-sub">SuperUI</span>
    </a>
    <div class="topnav-sections" id="topNavSections">
        @foreach (var s in macroSections)
        {
            <a class="topnav-tab @(s.Key == activeSection ? "active" : "")"
               data-section="@s.Key"
               asp-controller="@s.Ctl" asp-action="@s.Act">
                <i class="fa-solid @s.Icon"></i>
                <span>@s.Label</span>
            </a>
        }
    </div>
</nav>

