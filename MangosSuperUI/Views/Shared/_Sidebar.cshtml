<style>
    /* ── Customize modal: macro-section headers ── */
    .customize-section-label {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--text-muted);
        padding: 12px 2px 6px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .customize-section-label:first-child {
            padding-top: 2px;
        }

        .customize-section-label i {
            color: var(--accent);
            font-size: 11px;
        }

    /* ── Visibility Tab ── */
    .visibility-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border-light);
        transition: opacity 0.2s;
    }

        .visibility-row:last-child {
            border-bottom: none;
        }

        .visibility-row.hidden-group {
            opacity: 0.45;
        }

    .visibility-info {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .visibility-active-badge {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1px 6px;
        border-radius: 3px;
        background: rgba(59,130,196,0.15);
        color: var(--accent);
    }

    .visibility-toggle {
        position: relative;
        width: 36px;
        height: 20px;
        flex-shrink: 0;
    }

        .visibility-toggle input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .visibility-slider {
        position: absolute;
        inset: 0;
        border-radius: 10px;
        background: var(--border-medium);
        transition: background 0.2s;
        cursor: pointer;
    }

        .visibility-slider::before {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            left: 2px;
            top: 2px;
            border-radius: 50%;
            background: white;
            transition: transform 0.2s;
        }

    .visibility-toggle input:checked + .visibility-slider {
        background: var(--accent);
    }

        .visibility-toggle input:checked + .visibility-slider::before {
            transform: translateX(16px);
        }

    .visibility-toggle input:disabled + .visibility-slider {
        opacity: 0.5;
        cursor: default;
    }
</style>
