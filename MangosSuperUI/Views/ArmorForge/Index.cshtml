        (d.pieces || []).forEach(function (p) { h += '<b class="' + (p.ok ? 'ok' : 'bad') + '">' + (p.ok ? '✓' : '✗') + ' ' + esc(p.name || p.tbcEntry) + '</b><span>' + (p.ok ? 'entry ' + p.itemEntry + ' · display ' + p.displayId : esc(p.message)) + '</span>'; });
