        }

        var bonuses = collectBonuses();
        if (bonuses.attempted > bonuses.length) {
            if (!confirm((bonuses.attempted - bonuses.length) + ' bonus row(s) are incomplete and will be DROPPED.\n\nA bonus needs both a piece count and an effect picked from the search list. Import with only ' + bonuses.length + ' bonus(es)?')) return;
        }

        var pieces = setState.pieces.map(function (p) {
            var c = setState.configs[p.entry];
            // The set-level restriction wins for every piece — a tier set is class-locked as a unit.
            if (setMask != null) c = Object.assign({}, c || {}, { allowableClass: setMask });
            return { entry: p.entry, itemConfig: c ? JSON.stringify(c) : null };
        });
        var vanillaSet = s.expansion === 'vanilla';
        var body = { expansion: s.expansion || 'tbc', sourceSetId: s.setId, name: $('setNameInput').value.trim() || s.name, pieces: pieces, bonuses: bonuses.slice(), requiredSkill: 0, requiredSkillRank: 0 };
        // Appearance rides along only where it can be baked. A cloned set ships no art, and the server
        // rejects the request outright if these arrive — so a glow toggle left on from an earlier
        // preview would have blocked an otherwise fine set clone.
        if (!vanillaSet) {
            if (apActive) { body.recolorHue = apActive.hue; body.recolorSat = apActive.sat; body.recolorLight = apActive.light; body.recolorTheory = apActive.theory; body.recolorTier = apActive.tier; }
            if ($('apGlowOn').checked) body.glowColor = $('apGlowColor').value; // bake flame/glow colour
            var giSet = +$('apGlowIntensity').value / 100;
