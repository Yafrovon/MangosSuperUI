    wireSet();

    // ── Appearance (live recolor of the previewed piece) ──
    var apCurrent = null, apTheory = 'none', apActive = null; // apActive = the recolor to BAKE on import
    // Whether the CURRENT preview target can carry its appearance into the shipped item. True for the
    // import lanes, false for a vanilla clone (which ships no art at all). The preview still works
    // either way — this only governs what the panel promises and what gets sent on submit.
    var apBakeable = true;
    function apSetBakeable(on) {
        apBakeable = !!on;
        var note = $('apBakeNote');
        if (!note) return;
        note.style.display = on ? 'none' : '';
        note.textContent = 'Preview only for a vanilla clone. A clone reuses the source item’s own display, and new '
            + 'art needs a new display plus a patch rebuild — which is what the TBC and WotLK import lanes do. '
            + 'Recolor and glow here to see how a piece could look, then import it from a lane to keep it.';
        if (!on) apActive = null;
    }
    // 'none' first and default: the picked colour, straight, on every material.
    var AP_THEORIES = [['none', 'None'], ['fan', 'Fan'], ['identity', 'Shift'], ['analogous', 'Analogous'], ['accent', 'Accent'], ['luminance', 'Luminance'], ['bank', 'Palette']];
    // Body-atlas (painted) slots — colour detection must sample one of these, not a helm/shoulder model.
    var PAINTED_INV = [5, 20, 7, 10, 6, 9, 8, 16]; // chest, robe, legs, hands, waist, wrists, feet, back
    function apPickDetectPiece(pieces) {
        for (var i = 0; i < pieces.length; i++) if (PAINTED_INV.indexOf(pieces[i].inventoryType) >= 0) return pieces[i];
        return pieces[0];
    }

    function apSetTarget(t) {
        apCurrent = t; apActive = null; // a fresh preview clears any pending bake
        var s = $('apStatus');
        if (!t || !t.pieces || !t.pieces.length) { if (s) s.textContent = ''; apSetBakeable(true); return; }
        // A vanilla piece can be recolored in the PREVIEW — the retexture engine repaints its display's
        // textures on the fly — but a clone cannot ship that recolor: it reuses the source's display,
        // and new art needs a new display plus a patch rebuild, which only the import lanes do. The
        // panel used to say "will bake on import" here regardless, the clone endpoint silently dropped
        // the colour, and the operator got the original art with nothing explaining why.
        apSetBakeable(!t.pieces.some(function (p) { return p.expansion === 'vanilla'; }));
        if (s) s.textContent = 'Reading ' + (t.name || 'piece') + '’s colours…';
        // Seed the primary-colour picker from the item's own majority colour. Foreign (pre-import)
        // pieces sample their extracted source atlas; vanilla/forged pieces use the retexture engine.
        var pc0 = apPickDetectPiece(t.pieces);
        var foreign = (pc0.expansion === 'tbc' || pc0.expansion === 'wotlk') && pc0.entry;
        var url = foreign ? ('/ArmorForge/PrimaryColor?expansion=' + pc0.expansion + '&entry=' + pc0.entry) : ('/RetextureEngine/Primary?displayId=' + pc0.displayId);
        fetch(url).then(function (r) { return r.json(); }).then(function (d) {
            if (apCurrent !== t) return;
            if (d.success && d.primaryHex) { $('apColor').value = d.primaryHex; if (s) s.textContent = 'Primary colour of ' + (t.name || 'piece') + ' loaded. Pick a colour or theory to recolor.'; }
            else if (s) s.textContent = 'Ready to recolor ' + (t.name || 'piece') + '.';
        }).catch(function () { if (apCurrent === t && s) s.textContent = 'Ready to recolor ' + (t.name || 'piece') + '.'; });
    }
    // Saturation + lightness of the pick (0..1), so white/grey/black picks mean what they say.
    function hexToSL(hex) {
        var m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex); if (!m) return { s: 1, l: 0.5 };
        var r = parseInt(m[1], 16) / 255, g = parseInt(m[2], 16) / 255, b = parseInt(m[3], 16) / 255;
        var mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, d = mx - mn;
        var sat = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
        return { s: +sat.toFixed(3), l: +l.toFixed(3) };
    }
    function hexToHue(hex) {
        var m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex); if (!m) return 0;
        var r = parseInt(m[1], 16) / 255, g = parseInt(m[2], 16) / 255, b = parseInt(m[3], 16) / 255;
        var mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn, h = 0;
        if (d === 0) h = 0; else if (mx === r) h = ((g - b) / d) % 6; else if (mx === g) h = (b - r) / d + 2; else h = (r - g) / d + 4;
