            setGenerate().then(function () { submitSetConfigure(); }, function () { submitSetConfigure(); });
            return;
        }
        var setMask = readClassSelect('setClassRestrict');
        missing = setState.pieces.filter(function (p) { return !setState.configs[p.entry]; });
        if (missing.length) {
            var warn = missing.length + ' of ' + setState.pieces.length + ' pieces have no gameplay config'
                + (setMask != null ? '' : ' and no class restriction')
                + '.\n\nThey import with donor defaults'
                + (setMask != null ? ' (the class restriction still applies).' : ' and ANY class will be able to wear them (allowable_class = -1).')
                + '\n\nImport anyway?';
