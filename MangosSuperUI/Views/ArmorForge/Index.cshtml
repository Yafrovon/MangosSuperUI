    // Recolor every previewed piece (a single piece OR a whole set) coherently with one primary hue.
    // Single-flight + trailing coalesce: only ONE recolor runs at a time; rapid colour drags set a
    // pending flag and re-run once at the end, so the latest colour always wins and calls never
    // interleave (the interleave was the green↔red flicker — overlapping atlas repaints finishing
    // out of order and settling on a stale colour).
    var apBusy = false, apPending = false;
    function apApply() {
        if (!apCurrent || !apCurrent.pieces || !apCurrent.pieces.length || !window.afViewer) { $('apStatus').textContent = 'Preview a piece or set first.'; return; }
        if (apBusy) { apPending = true; return; }
        apBusy = true; apPending = false;
