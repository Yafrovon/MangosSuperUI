    }

    // ── Multi-select delete ──
    // A ticked set row means the whole set; ticking a set also ticks its pieces so the count is honest.
    function selectedArmor() {
        var sets = [], pieces = [];
        $('afList').querySelectorAll('.af-sel:checked').forEach(function (cb) {
            if (cb.hasAttribute('data-set')) sets.push({ id: +cb.getAttribute('data-set'), name: cb.getAttribute('data-name') });
            else pieces.push({ id: +cb.getAttribute('data-piece'), name: cb.getAttribute('data-name') });
        });
        return { sets: sets, pieces: pieces };
    }
    function updateSelection() {
        var all = $('afList').querySelectorAll('.af-sel'), checked = $('afList').querySelectorAll('.af-sel:checked');
        var btn = $('afDeleteSelected'); if (!btn) return;
        btn.disabled = checked.length === 0;
        btn.textContent = checked.length ? 'Delete selected (' + checked.length + ')' : 'Delete selected';
        var head = $('afSelAll');
        if (head) { head.checked = all.length > 0 && checked.length === all.length; head.indeterminate = checked.length > 0 && checked.length < all.length; }
        all.forEach(function (cb) { cb.closest('tr').classList.toggle('selected', cb.checked); });
    }
    function wireSelection() {
        var list = $('afList');
        list.querySelectorAll('.af-sel').forEach(function (cb) { cb.addEventListener('change', function () {
            // A set's checkbox drives its member rows (they follow the set row until the next group header).
            if (cb.hasAttribute('data-set')) {
                var tr = cb.closest('tr').nextElementSibling;
                while (tr && !tr.classList.contains('af-grp')) { var c = tr.querySelector('.af-sel'); if (c) c.checked = cb.checked; tr = tr.nextElementSibling; }
            }
            updateSelection();
        }); });
        var head = list.querySelector('#afSelAll');
        if (head) head.addEventListener('change', function () { list.querySelectorAll('.af-sel').forEach(function (cb) { cb.checked = head.checked; }); updateSelection(); });
    }
    (function () {
        var btn = $('afDeleteSelected'); if (!btn) return;
        btn.addEventListener('click', function () {
            var sel = selectedArmor();
            var n = sel.sets.length + sel.pieces.length; if (!n) return;
            var names = sel.sets.map(function (s) { return '• set: ' + s.name; }).concat(sel.pieces.map(function (p) { return '• ' + p.name; }));
            var shown = names.slice(0, 8).join('\n') + (names.length > 8 ? '\n• …and ' + (names.length - 8) + ' more' : '');
            if (!confirm('Delete ' + sel.sets.length + ' set(s) and ' + sel.pieces.length + ' piece(s)?\n\n' + shown + '\n\nRemoves them from the world database and the registry; the client patch rebuild is queued once for the whole batch. IDs return to the pool.')) return;
            btn.disabled = true;
            post('/ArmorForge/DeleteMany', { displayIds: sel.pieces.map(function (p) { return p.id; }), setIds: sel.sets.map(function (s) { return s.id; }) }, false).then(function (res) {
                var d = null; try { d = JSON.parse(res.body); } catch (e) { }
                if (!d) { result('<div class="title bad">Delete failed</div><div class="bad" style="white-space:pre-wrap;">' + esc(res.body) + '</div>'); return; }
                var h = '<div class="title ' + (d.ok ? 'ok' : 'bad') + '">' + (d.ok ? 'Deleted ' + n + ' item(s)' : 'Delete incomplete') + '</div>' +
                    '<div class="' + (d.ok ? 'muted' : 'bad') + '" style="white-space:pre-wrap;">' + esc(d.message || '') + '</div><div class="af-kv" style="margin-top:6px;">';
                (d.items || []).forEach(function (it) { h += '<b class="' + (it.ok ? 'ok' : 'bad') + '">' + (it.ok ? '✓' : '✗') + ' ' + esc(it.kind) + ' ' + it.id + '</b><span class="' + (it.ok ? 'muted' : 'bad') + '">' + esc(it.message || '') + '</span>'; });
                h += '</div><div class="muted" style="margin-top:6px;">The pieces stay in the client until you close WoW and click Rebuild patch.</div>';
                result(h);
            }).catch(function (e) { result('<div class="title bad">Delete failed</div><div class="bad">' + esc(String(e)) + '</div>'); })
              .then(function () { loadList(); refreshStatus(); });
        });
    })();

    // Delete results report what actually happened. A set delete can come back ok:false when some
    // pieces survived — in that case the set row is deliberately KEPT so the delete can be retried,
    // and saying "Deleted" would be a lie.
    function showDeleteResult(res, what) {
        var d = null;
        try { d = JSON.parse(res.body); } catch (e) { }
        if (!d) { result('<div class="title bad">Delete ' + what + ' failed</div><div class="bad" style="white-space:pre-wrap;">' + esc(res.body) + '</div>'); return; }
        var ok = d.ok !== false;
        result('<div class="title ' + (ok ? 'ok' : 'bad') + '">' + (ok ? 'Deleted ' + what : 'Delete ' + what + ' incomplete') + '</div>' +
            '<div class="' + (ok ? 'muted' : 'bad') + '" style="white-space:pre-wrap;">' + esc(d.message || '') + '</div>' +
            (ok ? '' : '<div class="muted" style="margin-top:6px;">The set was left in place so you can try again once the cause is cleared (a running game client locks the patch).</div>'));
    }

    // ── Optional vanilla set bonuses ──
    var curSets = [], curPieces = [];
    function fillSetPicker(sets, pieces) {
        curSets = sets; curPieces = pieces;
        var sel = $('setPick'); var cur = sel.value;
        sel.innerHTML = '<option value="0">— pick a forged set —</option>';
        sets.forEach(function (s) { sel.add(new Option(s.name + ' (' + s.memberCount + 'pc)', s.setId)); });
        sel.value = cur; renderSetEditor();
    }
    $('setPick').addEventListener('change', renderSetEditor);
    function renderSetEditor() {
        var sid = +$('setPick').value; var s = curSets.filter(function (x) { return x.setId === sid; })[0];
        $('setBonuses').innerHTML = ''; $('setMembers').innerHTML = '';
        if (!s) { $('setName').value = ''; $('setMembers').innerHTML = '<span class="muted" style="font-size:11px;">Pick a set.</span>'; return; }
        $('setName').value = s.name;
        curPieces.forEach(function (p) {
            var d = document.createElement('label'); d.className = 'af-member';
            d.innerHTML = '<input type="checkbox" value="' + p.itemEntry + '"' + (p.setId === sid ? ' checked' : '') + '> ' + esc(p.name) + ' <span class="muted" style="font-size:10px;">(' + esc(p.family) + ')</span>';
            $('setMembers').appendChild(d);
        });
        (s.bonuses || []).forEach(function (b) { addBonusRow(b.threshold, b.spellId); });
    }
    $('addBonus').addEventListener('click', function () { addBonusRow(2, 0); });
    function addBonusRow(t, sp) {
        var d = document.createElement('div'); d.className = 'af-bonus-row';
        d.innerHTML = '<input type="number" min="1" max="8" value="' + t + '" class="af-input bThr" placeholder="pc"><input type="number" min="0" value="' + sp + '" class="af-input bSpell" placeholder="spell id"><button class="af-del bRm">✕</button>';
        d.querySelector('.bRm').addEventListener('click', function () { d.remove(); });
        $('setBonuses').appendChild(d);
    }
    function saveSet(btn) {
        var sid = +$('setPick').value;
        var members = Array.prototype.slice.call($('setMembers').querySelectorAll('input:checked')).map(function (c) { return parseInt(c.value, 10); });
        if (!sid && !members.length) { result('<div class="title bad">Pick a set</div>'); return; }
        // Same silent-drop guard as the set modal's collector: this card is a SEPARATE control (raw
        // numeric spell id), so the check has to exist here too.
        var rows = Array.prototype.slice.call($('setBonuses').querySelectorAll('.af-bonus-row'));
        var attempted = rows.filter(function (row) {
            return row.querySelector('.bThr').value.trim() !== '' || row.querySelector('.bSpell').value.trim() !== '';
        }).length;
        var bonuses = rows.map(function (row) { return { threshold: +row.querySelector('.bThr').value || 0, spellId: +row.querySelector('.bSpell').value || 0 }; }).filter(function (b) { return b.threshold > 0 && b.spellId > 0; });
        if (attempted > bonuses.length &&
            !confirm((attempted - bonuses.length) + ' bonus row(s) are incomplete and will be DROPPED.\n\nEach bonus needs both a piece count and a spell id. Save with only ' + bonuses.length + ' bonus(es)?')) return;
        btn.disabled = true;
        post('/ArmorForge/SaveSet', { setId: sid, name: $('setName').value, memberEntries: members, bonuses: bonuses }, false).then(function (r) {
            btn.disabled = false;
            if (!r.ok) { result('<div class="title bad">Set save failed</div><div class="bad">' + esc(r.body) + '</div>'); return; }
            var d = JSON.parse(r.body);
            result('<div class="title ok">Set ' + d.setId + ' saved</div><div class="muted">' + esc(d.message) + '</div>' +
                (d.serverDbcDeployed ? '<div class="muted" style="margin-top:6px;"><strong>Restart mangosd</strong> for this to take effect — the core only reads ItemSet.dbc at startup.</div>' : ''));
            loadList(); refreshStatus();
        });
    }

    document.querySelectorAll('[data-action]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var a = btn.getAttribute('data-action');
            if (a === 'rebuildPatch') { btn.disabled = true; post('/ArmorForge/RebuildPatch', new FormData(), true).then(function (r) { btn.disabled = false; var d = JSON.parse(r.body); result('<div class="title ok">Patch rebuilt</div><div class="muted">' + esc(d.message) + '</div>'); refreshStatus(); }); }
            else if (a === 'saveSet') saveSet(btn);
            else if (a === 'restartMangosd') restartMangosd(btn);
        });
    });

    function setChar() { if (window.afViewer) window.afViewer.setChar($('cvRace').value, $('cvGender').value); }
    $('cvRace').addEventListener('change', setChar); $('cvGender').addEventListener('change', setChar);
    $('cvStrip').addEventListener('click', function () { $('cvEquipped').textContent = ''; if (window.afViewer) window.afViewer.reset(); });

    loadList();
})();
</script>
}
