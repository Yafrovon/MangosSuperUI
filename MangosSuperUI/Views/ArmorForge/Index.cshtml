            h += '<div class="muted" style="margin-top:6px;"><strong>Restart mangosd</strong> to activate this set'
                + (d.bonusCount > 0 ? ' and its ' + d.bonusCount + ' bonus(es)' : ' — until then the core zeroes its set_id, so the tooltip shows no set block')
                + '. Use the <strong>Restart mangosd</strong> button in the Registry card.</div>';
