        var foreign = apCurrent.pieces.some(function (p) { return (p.expansion === 'tbc' || p.expansion === 'wotlk') && p.entry; });
        $('apStatus').textContent = 'Recoloring…';
        function done(ok, n) {
            apBusy = false;
