    <div class="af-modal-foot">
      <button class="af-btn secondary" id="setCancel" type="button">Cancel</button>
      <button class="af-btn" id="setSubmit" type="button">Import set</button>
    </div>
  </div>
</div>

    </div>
</div>

@section Scripts {
<script type="importmap">
{ "imports": { "three": "/lib/three/build/three.module.js", "three/addons/": "/lib/three/examples/jsm/" } }
</script>
<script type="module">
    import { mountCharacterViewer } from '/js/character-viewer/embed.js';
    // Starter clothes so the preview character isn't naked (Apprentice's Robe — validated by the viewer's geoset rules).
    var DEFAULT_OUTFIT = [{ displayId: 12647, itemId: 56 }];
    var handle = null, curRace = 'Human', curGender = 'Male', pending = null;

    async function mount() {
        var hint = document.getElementById('afViewerHint');
        try {
            var res = await fetch('/Items/CharacterPreview?race=' + curRace + '&gender=' + curGender, { credentials: 'same-origin' });
            var html = await res.text();
            var glbUrl = (/data-glb-url="([^"]+)"/.exec(html) || [])[1];
            var skinUrl = (/data-skin-url="([^"]+)"/.exec(html) || [])[1];
            if (!glbUrl) { if (hint) { hint.style.display = 'flex'; hint.textContent = 'Character preview unavailable — client data not mounted.'; } return; }
            if (handle) { try { handle.dispose(); } catch (e) { } handle = null; }
            if (hint) { hint.style.display = 'flex'; hint.textContent = 'Loading character…'; }
            handle = await mountCharacterViewer({ canvas: document.getElementById('char-preview-canvas'), glbUrl: glbUrl, skinUrl: skinUrl });
            window.afViewerHandle = handle; // debug/diagnostic access (same shape as the Items page's window.cv)
            if (hint) hint.style.display = 'none';
            try { if (DEFAULT_OUTFIT.length) await handle.cv.equip.equipMultiple(handle.character, DEFAULT_OUTFIT); } catch (e) { console.warn('default outfit failed', e); }
            if (pending) { var p = pending; pending = null; p(); }
        } catch (e) {
            if (hint) { hint.style.display = 'flex'; hint.textContent = 'Character preview failed to load.'; }
            console.warn('armor viewer mount failed', e);
        }
    }

    // Live glow/flame recolor: walk the whole character (body + every equipped attachment), tint
    // additive-glow materials and M2Emitter particle materials, and re-apply each frame so the m2fx
    // engine's per-frame colour writes don't clobber it. Works for a whole SET, not just one piece.
    // Live glow tint/intensity. The override rides each M2Emitter material's userData and the
    // particle engine reads it AT RAMP-EVALUATION TIME (m2particles.js) — the same transform the
    // forge bakes (tint replaces the colour keys, intensity scales them, a dim shrinks the
    // particle). The old approach wrote mat.color from a competing rAF loop: that MULTIPLIED the
    // ramp instead of replacing it, fought the engine's own per-frame writes, and also tinted
    // additive PASSES the bake never touches — the preview never matched the committed result.
    var _glowOverride = null; // {tint:[r,g,b]|null, intensity, sizeMul} or null
    function _applyGlowOverride() {
        var n = 0;
        if (!handle || !handle.character || !handle.character.root) return 0;
        handle.character.root.traverse(function (node) {
            if (node.name !== 'M2Emitter' || !node.material) return;
            var mats = Array.isArray(node.material) ? node.material : [node.material];
            mats.forEach(function (mat) {
                if (!mat) return;
                mat.userData = mat.userData || {};
                if (_glowOverride) mat.userData.suiGlowOverride = _glowOverride;
                else delete mat.userData.suiGlowOverride;
                n++;
            });
        });
        return n;
    }

    window.afViewer = {
        // Forged piece (has a vanilla display row): composites/attaches via /Items/ItemDressing.
        equip: async function (displayId, itemId) {
            if (!handle || !handle.character) { pending = function () { window.afViewer.equip(displayId, itemId); }; return; }
            try { await handle.cv.equip.equipDisplay(handle.character, displayId, itemId || undefined); } catch (e) { console.warn('equip failed', e); }
            _applyGlowOverride();
        },
        // Pre-import later-client preview: dress EXACTLY like the Items page (geosets, paint order,
        // cape) by feeding equipMultiple dressing payloads from /ArmorForge/{Tbc|Wotlk}Dressing for
        // source entries (tbc:true + expansion) and the normal /Items/ItemDressing for vanilla ones
        // (the default outfit and forged pieces).
        dressTbc: async function (items) {
            if (!handle || !handle.character) { pending = function () { window.afViewer.dressTbc(items); }; return; }
            var fetchFn = function (e, identity) {
                var q = '&race=' + encodeURIComponent(curRace) + '&gender=' + encodeURIComponent(curGender);
                var lanePrefix = e.expansion === 'wotlk' ? 'Wotlk' : 'Tbc';
                var url = e.tbc ? '/ArmorForge/' + lanePrefix + 'Dressing?entry=' + e.entry + q
                                : '/Items/ItemDressing?displayId=' + e.displayId + (e.itemId ? '&itemId=' + e.itemId : '') + q;
                return fetch(url).then(function (r) { return r.ok ? r.json() : null; });
            };
            try { await handle.cv.equip.equipMultiple(handle.character, items, { fetchDressing: fetchFn }); }
            catch (e) { console.warn('tbc dress failed', e); }
            _applyGlowOverride(); // a re-dress rebuilds emitter materials; keep the live glow override on them
        },
        // Live recolor of the currently-previewed piece: fetch retextured assets at the chosen
        // primary hue + palette theory and swap them onto the model without a reload (painted armor
        // repaints its atlas; a model item re-mounts its recolored attachment GLB).
        applyRecolor: async function (displayId, opts) {
            if (!handle || !handle.character) return false;
            opts = opts || {};
            // Foreign (not-yet-imported) TBC/WotLK pieces recolor their extracted source atlas via the
            // Armor Forge; vanilla/forged pieces resolve their vanilla display via the retexture engine.
            var foreign = (opts.expansion === 'tbc' || opts.expansion === 'wotlk') && opts.entry;
            var q = new URLSearchParams({ theory: opts.theory || 'fan', tier: opts.tier || 'improved' });
            if (opts.hue != null) q.append('hue', Math.round(opts.hue));
            if (opts.sat != null) { q.append('sat', opts.sat); q.append('light', opts.light); }
            var url;
            if (foreign) { q.append('expansion', opts.expansion); q.append('entry', opts.entry); url = '/ArmorForge/RecolorDressing?' + q; }
            else { q.append('displayId', displayId); url = '/RetextureEngine/PreviewOnModel?' + q; }
            try {
                var d = await (await fetch(url)).json();
                if (!d.success) return false;
                if (d.kind === 'atlas') await handle.cv.equip.equipBodyAtlasRetextureDirect(handle.character, d.slotUrls, {});
                else if (d.kind === 'weapon') await handle.cv.equip.equipWeaponGlbDirect(handle.character, d.glbUrl, opts.inventoryType || 0, d.attachments);
                _applyGlowOverride();
                return true;
            } catch (e) { console.warn('recolor apply failed', e); return false; }
        },
        // Re-dress the previewed items with RECOLORED textures in ONE layered pass (equipMultiple) — no
        // per-piece flicker, and it recolors body + cape + helm/shoulder together. Only tbc/wotlk pieces
        // are recolored; vanilla/default-outfit items dress normally so they stay their own colour.
        dressRecolor: async function (items, opts) {
            if (!handle || !handle.character) return false;
            opts = opts || {};
            var gq = '&race=' + encodeURIComponent(curRace) + '&gender=' + encodeURIComponent(curGender);
            var rq = '&hue=' + Math.round(opts.hue || 0) + (opts.sat != null ? '&sat=' + opts.sat + '&light=' + opts.light : '') + '&theory=' + (opts.theory || 'fan') + '&tier=' + (opts.tier || 'improved') + gq;
            var fetchFn = function (e) {
                var url = e.tbc
                    ? '/ArmorForge/RecolorDressing?expansion=' + e.expansion + '&entry=' + e.entry + rq
                    : '/Items/ItemDressing?displayId=' + e.displayId + (e.itemId ? '&itemId=' + e.itemId : '') + gq;
                return fetch(url).then(function (r) { return r.ok ? r.json() : null; });
            };
            try { await handle.cv.equip.equipMultiple(handle.character, items, { fetchDressing: fetchFn }); _applyGlowOverride(); return true; }
            catch (e) { console.warn('recolor dress failed', e); return false; }
        },
        // Glow tint/intensity preview — mirrors the commit-time bake (emitters only).
        // opts = { tint:[r,g,b] 0..1 | null, intensity:number, sizeMul:number }.
        // Returns the count of emitter materials found (0 = no animated emitter to affect).
        setGlow: function (opts) { _glowOverride = opts || null; return _applyGlowOverride(); },
        clearGlow: function () { _glowOverride = null; _applyGlowOverride(); },
        // Back-compat shim: flat tint at full intensity.
        tintGlow: function (rgb) { return window.afViewer.setGlow({ tint: rgb, intensity: 1, sizeMul: 1 }); },
        hasGlow: function () { return _applyGlowOverride(); },
        defaultOutfit: DEFAULT_OUTFIT,
        setChar: async function (race, gender) { curRace = race; curGender = gender; await mount(); },
        reset: async function () { await mount(); }
    };
    mount();
</script>
<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
    function result(html) { $('afResult').innerHTML = html; }
    function post(url, body, isForm) {
        var opt = { method: 'POST' };
        if (isForm) opt.body = body; else { opt.headers = { 'Content-Type': 'application/json' }; opt.body = JSON.stringify(body); }
        return fetch(url, opt).then(function (r) { return r.text().then(function (t) { return { ok: r.ok, body: t }; }); });
    }
    document.querySelectorAll('.af-card > h3').forEach(function (h) { h.addEventListener('click', function () { h.parentElement.classList.toggle('collapsed'); }); });

    var FAMILIES = { helm: 'Head', shoulder: 'Shoulder', cloak: 'Back', chest: 'Chest', robe: 'Robe', shirt: 'Shirt', tabard: 'Tabard', bracers: 'Wrist', gloves: 'Hands', belt: 'Waist', legs: 'Legs', boots: 'Feet' };
    Object.keys(FAMILIES).forEach(function (k) { $('tbcFamily').add(new Option(FAMILIES[k], k)); $('wotlkFamily').add(new Option(FAMILIES[k], k)); $('vanillaFamily').add(new Option(FAMILIES[k], k)); });

    // The import lanes share one UI; only ids (`${key}Search` …), labels and the expansion key differ.
    // The vanilla lane CLONEs from the live world DB (not a client archive) but drives the same UI.
    var LANES = {
        tbc: { key: 'tbc', label: 'TBC', pill: 'pillTbc', state: 'tbcState', search: 'tbcSearch', family: 'tbcFamily', results: 'tbcResults', other: 'tbcOtherBtn', showOther: false },
        wotlk: { key: 'wotlk', label: 'WotLK', pill: 'pillWotlk', state: 'wotlkState', search: 'wotlkSearch', family: 'wotlkFamily', results: 'wotlkResults', other: 'wotlkOtherBtn', showOther: false },
        // looseIsPrimary: this lane has no set cards, so its pieces list IS the answer and must render
        // expanded. TBC/WotLK leave it falsy and keep collapsing a browse-all (thousands of rows under
        // the set cards that are the point of those lanes).
        vanilla: { key: 'vanilla', label: 'Vanilla', pill: 'pillVanilla', state: 'vanillaState', search: 'vanillaSearch', family: 'vanillaFamily', results: 'vanillaResults', other: 'vanillaOtherBtn', showOther: false, looseIsPrimary: true }
    };
    var KIND_ICON = { Painted: 'fa-brush', Modelled: 'fa-cube', Cloak: 'fa-wind' };

    // ── Status ──
    fetch('/ArmorForge/Status').then(function (r) { return r.json(); }).then(function (s) {
        var f = $('pillFixture'); f.textContent = s.fixtureOk ? 'fixture ✓' : 'fixture ✗'; f.className = 'af-pill ' + (s.fixtureOk ? 'ok' : 'bad');
        [LANES.tbc, LANES.wotlk].forEach(function (lane) {
            var ls = s[lane.key] || {};
            var t = $(lane.pill), st = $(lane.state);
            if (ls.configured && ls.archiveCount > 0) {
                t.textContent = lane.label + ': ' + ls.pieces + ' pieces · ' + ls.sets + ' sets'; t.className = 'af-pill ok';
                st.textContent = lane.label + ' mounted (' + ls.archiveCount + ' archives): ' + ls.pieces + ' armor pieces, ' + ls.sets + ' sets. Search below — sets come first.';
                $(lane.search).disabled = false; if (lane.key === 'tbc') $(lane.search).focus(); laneSearch(lane, '');
            } else {
                t.textContent = ls.configured ? lane.label + ': no archives' : lane.label + ' not set'; t.className = 'af-pill warn';
                st.innerHTML = ls.error ? lane.label + ': ' + esc(ls.error) : 'Set the <strong>' + lane.label + ' Data Path</strong> on the <a href="/Settings">Settings page</a> to enable import.';
            }
        });
        applyDeployPills(s);
    });

    // The patch / deploy / server-set pills are the ones that change when the operator rebuilds or
    // restarts, so they live in their own function that can be re-run without disturbing the lane
    // searches (re-running the whole Status handler would reset every search box).
    function applyDeployPills(s) {
        var p = $('pillPatch'); p.textContent = s.patchPresent ? 'patch-4 built' : 'no patch yet'; p.className = 'af-pill ' + (s.patchPresent ? 'ok' : '');
        var dp = s.deployedPatch || {}, dpEl = $('pillDeploy');
        // Queue depth first: it is the thing the operator acts on. Stale is the failure mode (client
        // was running during the deploy); the rest is plain state.
        dpEl.textContent = !dp.configured ? 'deploy: no client path'
            : dp.pending > 0 ? dp.pending + ' change' + (dp.pending === 1 ? '' : 's') + ' queued — close WoW, Rebuild patch'
            : dp.stale ? 'patch-4 STALE in client — close WoW, Rebuild patch'
            : dp.deployedExists ? 'patch-4 deployed ✓'
            : dp.built ? 'patch-4 not deployed yet' : 'no patch yet';
        dpEl.className = 'af-pill ' + (!dp.configured ? 'warn' : dp.pending > 0 ? 'warn' : dp.stale ? 'bad' : dp.deployedExists ? 'ok' : '');
        dpEl.title = (dp.message || '') + (dp.pendingReasons && dp.pendingReasons.length ? '\n\nPending:\n• ' + dp.pendingReasons.join('\n• ') : '');
        // Server-side sets: the client patch alone is not enough — the core needs ItemSet.dbc in its own
        // dbc dir, and only picks it up at startup.
        var si = s.serverItemSet || {}, siEl = $('pillItemSet');
        siEl.textContent = !si.configured ? 'sets: no server dbc dir'
            : si.stale ? 'server sets STALE — Rebuild patch'
            : si.restartRequired ? 'sets deployed — RESTART mangosd'
            : 'server sets ✓';
        siEl.className = 'af-pill ' + (!si.configured ? 'warn' : (si.stale || si.restartRequired) ? 'bad' : 'ok');
        if (si.message) siEl.title = si.message + (si.restartRequired ? '\n\nItemSet.dbc was written after mangosd started (' + (si.serverStarted || '?') + '), so the running core is still reading the old copy.' : '');
        $('btnRestartMangosd').style.display = si.restartRequired ? '' : 'none';
    }
    function refreshStatus() {
        return fetch('/ArmorForge/Status').then(function (r) { return r.json(); })
            .then(applyDeployPills).catch(function (e) { console.warn('status refresh', e); });
    }

    // mangosd reads DBCs only at startup, so a deployed ItemSet.dbc is inert until this runs.
    function restartMangosd(btn) {
        if (!confirm('Restart the world server (mangosd) now?\n\nEveryone online is disconnected. This is what makes newly deployed set data live — the core only reads ItemSet.dbc at startup.')) return;
        btn.disabled = true;
        result('<div class="title">Restarting mangosd…</div><div class="muted">The core re-reads ItemSet.dbc on startup; forged sets become live once it is back up.</div>');
        fetch('/Home/ProcessAction', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ service: 'mangosd', action: 'restart' })
        }).then(function (r) { return r.json(); }).then(function (d) {
            btn.disabled = false;
            var ok = d && d.success !== false;
            result('<div class="title ' + (ok ? 'ok' : 'bad') + '">' + (ok ? 'mangosd restart issued' : 'Restart failed') + '</div><div class="muted">' + esc((d && (d.message || d.error)) || '') + '</div>' +
                (ok ? '<div class="muted" style="margin-top:6px;">Give it a few seconds, then reload this page — the <strong>sets</strong> pill should go green.</div>' : ''));
            setTimeout(refreshStatus, 6000);
        }).catch(function (e) { btn.disabled = false; result('<div class="title bad">Restart failed</div><div class="muted">' + esc(String(e)) + '</div>'); });
    }

    // ── Search (grouped), one handler per lane ──
    [LANES.tbc, LANES.wotlk, LANES.vanilla].forEach(function (lane) {
        var timer;
        $(lane.search).addEventListener('input', function () { clearTimeout(timer); var v = this.value; timer = setTimeout(function () { laneSearch(lane, v); }, 220); });
        $(lane.family).addEventListener('change', function () { laneSearch(lane, $(lane.search).value); });
        // The drawer is a pure view toggle over the payload already in hand — no refetch, so it
        // stays instant and keeps its state across searches within the session.
        $(lane.other).addEventListener('click', function () { lane.showOther = !lane.showOther; applyOther(lane); });
    });
    // The vanilla lane's browse is a live world-DB query, so it is seeded on FIRST USE rather than at
    // page load — the TBC/WotLK lanes can seed eagerly because they read a mounted archive already in
    // memory. Without this the card sat on "Search to browse vanilla armor." until something was typed,
    // which is the whole reason the lane read as dead next to the other two.
    // Latched only once a browse actually SUCCEEDS. Setting it up front meant a first open against a
    // dead world DB left the card permanently stuck — both triggers were no-ops from then on, and the
    // whole reason this lane is seeded lazily is that it depends on a database that fails intermittently.
    var vanillaSeeded = false, vanillaSeedInFlight = false;
    function seedVanillaLane() {
        if (vanillaSeeded || vanillaSeedInFlight) return;
        vanillaSeedInFlight = true;
        loadVanillaStatus();
        laneSearch(LANES.vanilla, '').then(function (ok) {
            vanillaSeeded = !!ok;
        }).finally(function () { vanillaSeedInFlight = false; });
    }

    // The vanilla lane's status is its OWN fetch, not part of /ArmorForge/Status. Status is a pure
    // file/process probe and the TBC + WotLK search boxes are enabled inside its callback, so putting a
    // world-DB round trip in it left two lanes that need no database disabled for the whole MySQL
    // connect timeout whenever the DB was down.
    function loadVanillaStatus() {
        var vp = $('pillVanilla');
        vp.textContent = 'Vanilla: checking…'; vp.className = 'af-pill';
        fetch('/ArmorForge/VanillaStatus').then(function (r) { return r.json(); }).then(function (vs) {
            if (vs.configured) {
                vp.textContent = 'Vanilla: ' + (vs.pieces || 0).toLocaleString() + ' pieces';
                vp.className = 'af-pill ok';
                $('vanillaState').innerHTML = (vs.pieces || 0).toLocaleString() + ' stock armor pieces available to clone, grouped into their sets below. Each piece reuses the source’s own model/textures and can be re-itemized. <strong>A single piece packages nothing</strong> — no patch, no download, no client restart. <strong>Cloning a SET ships an ItemSet.dbc row in the client patch</strong> (rebuilt on request), so it needs a Rebuild patch, a client restart and a mangosd restart to take effect. A recolor or glow tint cannot ride along either way.';
                $('vanillaState').style.color = '';
            } else {
                vp.textContent = 'Vanilla: world DB unreachable';
                vp.className = 'af-pill bad';
                vp.title = vs.error || '';
                $('vanillaState').textContent = 'The vanilla clone lane reads the live world database, which is not answering: ' + (vs.error || 'unknown error');
                $('vanillaState').style.color = '#b42318';
            }
        }).catch(function (e) {
            vp.textContent = 'Vanilla: status failed'; vp.className = 'af-pill bad'; vp.title = String(e);
        });
    }
    $('vanillaSearch').addEventListener('focus', seedVanillaLane);
    (function () {
        var card = $('vanillaSearch').closest('.af-card');
        if (!card) return;
        var head = card.querySelector('h3');
        if (head) head.addEventListener('click', function () { if (!card.classList.contains('collapsed')) seedVanillaLane(); });
        if (!card.classList.contains('collapsed')) seedVanillaLane();
    })();

    // Show/hide a lane's "other sets" drawer and keep the button's label + pressed look in sync.
    function applyOther(lane) {
        var btn = $(lane.other), box = document.getElementById(lane.results + 'Other');
        var n = lane.otherCount || 0;
        btn.textContent = (lane.showOther ? 'Hide other sets' : 'Other sets') + (n ? ' (' + n + ')' : '');
        btn.classList.toggle('on', lane.showOther);
        btn.disabled = !n;
        if (box) box.style.display = lane.showOther ? '' : 'none';
    }

    // Returns a promise resolving to whether a usable payload arrived, so the vanilla lane's lazy seed
    // can decide whether it is really seeded. Also catches: a rejected fetch (or a 500 — ImportBrowse
    // can now answer one for an unrecognised lane key) used to leave the lane stuck on "Searching…".
    function laneSearch(lane, q) {
        var host = $(lane.results); host.innerHTML = '<div class="af-empty">Searching…</div>';
        return fetch('/ArmorForge/ImportBrowse?expansion=' + lane.key + '&search=' + encodeURIComponent(q) + '&family=' + encodeURIComponent($(lane.family).value))
            .then(function (r) { return r.json(); }).then(function (d) {
                host.innerHTML = '';
                var other = d.otherSets || [];
                lane.otherCount = d.otherSetCount || other.length;
                // A failed browse used to be indistinguishable from an empty one: the vanilla branch
                // returns { error } with three empty arrays, and this printed "No matches."
                if (d.error) {
                    host.innerHTML = '<div class="af-empty" style="color:#b42318;">Browse failed: ' + esc(d.error) + '</div>';
                    applyOther(lane); return false;
                }
                if (!d.sets.length && !other.length && !d.loose.length) { host.innerHTML = '<div class="af-empty">No matches.</div>'; applyOther(lane); return true; }

                if (d.sets.length) {
                    var fh = document.createElement('div'); fh.className = 'af-loose-h';
                    // Vanilla has no arenas; its headline group is the raid/dungeon tiers plus the PvP
                    // rank sets, and it is selected on piece count as well as item level (see
                    // VanillaArmorSetCatalog), so the caption has to match what the server actually did.
                    var vanillaLane = lane.key === 'vanilla';
                    fh.textContent = (vanillaLane ? 'Tier & PvP sets (' : 'Tier & arena sets (') + d.sets.length + (d.featuredSetCount > d.sets.length ? ' of ' + d.featuredSetCount : '') + ')';
                    fh.title = vanillaLane
                        ? 'Multi-piece sets at item level ' + d.featuredMinItemLevel + ' or above — Tier 0 through Tier 3 and the PvP rank sets. Smaller and lower sets are under "Other sets".'
                        : 'Epic sets at item level ' + d.featuredMinItemLevel + ' or above — the tier and arena sets of this expansion.';
                    host.appendChild(fh);
                    d.sets.forEach(function (s) { host.appendChild(renderSet(s)); });
                } else if (other.length) {
                    var none = document.createElement('div'); none.className = 'af-empty';
                    none.textContent = 'No tier or arena sets match — ' + other.length + ' other set(s) did. Use "Other sets".';
                    host.appendChild(none);
                }

                // The vanilla lane's set cards come from the client's ItemSet.dbc; with no mount there are
                // no cards at all, and the loose list alone would read as the whole lane.
                if (d.setsError) {
                    var se = document.createElement('div'); se.className = 'af-empty';
                    se.style.color = '#b42318';
                    se.textContent = 'Sets unavailable: ' + d.setsError;
                    host.appendChild(se);
                }

                // Everything that is not a current-expansion tier/arena set lives here, rendered but
                // hidden: a click flips it open with no round-trip.
                if (other.length) {
                    var drawer = document.createElement('div'); drawer.id = lane.results + 'Other';
                    var oh = document.createElement('div'); oh.className = 'af-loose-h';
                    oh.textContent = 'Other sets (' + other.length + (d.otherSetCount > other.length ? ' of ' + d.otherSetCount : '') + ')';
                    drawer.appendChild(oh);
                    other.forEach(function (s) { drawer.appendChild(renderSet(s)); });
                    host.appendChild(drawer);
                }

                if (d.loose.length) {
                    var h = document.createElement('div'); h.className = 'af-loose-h';
                    // A slot-word search ("boots") returns the slot's pieces regardless of set — label accordingly.
                    var looseLabel = (d.slotSearch ? 'Matching pieces (' : 'Pieces not in a set (') + d.loose.length + (d.total > d.loose.length + d.sets.length ? '+' : '') + ')';
                    host.appendChild(h);
                    var box = document.createElement('div'); box.className = 'af-set';
                    var body = document.createElement('div'); body.className = 'af-set-body';
                    d.loose.forEach(function (p) { body.appendChild(renderPiece(p, null)); });
                    box.appendChild(body); host.appendChild(box);
                    // Collapsed only for the browse-all view (the loose list is thousands of rows there).
                    // With a typed search the pieces ARE the answer — open them, or the search looks dead.
                    var open = !!(q && q.trim()) || !!lane.looseIsPrimary;
                    if (open) box.classList.add('open');
                    h.style.cursor = 'pointer';
                    h.title = 'Show / hide these pieces';
                    h.textContent = (open ? '▾ ' : '▸ ') + looseLabel;
                    h.addEventListener('click', function () {
                        box.classList.toggle('open');
                        h.textContent = (box.classList.contains('open') ? '▾ ' : '▸ ') + looseLabel;
                    });
                }
                applyOther(lane);
                return true;
            })
            .catch(function (e) {
                host.innerHTML = '<div class="af-empty" style="color:#b42318;">Browse failed: ' + esc(String(e)) + '</div>';
                applyOther(lane);
                return false;
            });
    }

    function renderSet(s) {
        var box = document.createElement('div'); box.className = 'af-set';
        var head = document.createElement('div'); head.className = 'af-set-head';
        // droppedMembers: the set's non-armor members (weapons, rings, trinkets) that this forge cannot
        // clone. Stated on the card so a 5-of-8 set never reads as the whole thing.
        var dropped = s.droppedMembers > 0 ? ' · ' + s.droppedMembers + ' non-armor' : '';
        head.innerHTML = '<span class="chev">▸</span><span class="nm">' + esc(s.name) + '</span><span class="cnt">' + (s.maxItemLevel ? 'ilvl ' + s.maxItemLevel + ' · ' : '') + s.pieces.length + ' pieces' + dropped + '</span>';
        if (s.droppedMembers > 0) head.title = s.droppedMembers + ' member(s) of this set are weapons, rings or trinkets — the Armor Forge clones armor only, so they are not included.';
        var imp = document.createElement('button'); imp.className = 'af-btn small'; imp.innerHTML = '<i class="fa-solid fa-download"></i> Import set';
        imp.title = 'Import every piece of this set as one forged set'; imp.addEventListener('click', function (e) { e.stopPropagation(); importSet(s, imp); });
        var prev = document.createElement('button'); prev.className = 'af-btn secondary small'; prev.textContent = 'Preview'; prev.title = 'Dress the character in this whole set (pre-import preview)';
        prev.addEventListener('click', function (e) {
            e.stopPropagation(); markPreviewing(box); previewSet(s);
            // Fold the pieces list shut: once the set is on the character, the highlighted header
            // row is enough, and the collapsed list leaves the column visibly scrollable.
            box.classList.remove('open'); head.querySelector('.chev').textContent = '▸';
        });
        head.appendChild(prev); head.appendChild(imp);
        head.addEventListener('click', function () { box.classList.toggle('open'); head.querySelector('.chev').textContent = box.classList.contains('open') ? '▾' : '▸'; });
        var body = document.createElement('div'); body.className = 'af-set-body';
        s.pieces.forEach(function (p) { body.appendChild(renderPiece(p, s)); });
        box.appendChild(head); box.appendChild(body);
        return box;
    }

    function renderPiece(p, set) {
        var row = document.createElement('div'); row.className = 'af-piece';
        var note = p.renderKind === 'Modelled' ? (p.family === 'helm' ? '16 variants' : 'L/R model') : (p.renderKind === 'Cloak' ? 'cape texture' : 'painted');
        row.innerHTML = '<i class="fa-solid ' + (KIND_ICON[p.renderKind] || 'fa-circle') + ' ico" title="' + esc(p.renderKind) + '"></i>' +
            '<span class="q' + p.quality + '">' + esc(p.name) + ' <span class="muted" style="font-size:10px;color:var(--text-muted)">· ilvl ' + p.itemLevel + ' · ' + note + '</span></span>' +
            '<span class="slot">' + esc(p.familyLabel) + '</span>';
        // Preview has always worked from a click on the item NAME, but the only visible button said
        // Import/Clone — and the vanilla lane never renders a set card, whose header carries the only
        // labelled Preview button on the page. So in that lane there was no visible way to preview at
        // all. Every row now offers it explicitly; the name-click shortcut stays.
        var prev = document.createElement('button'); prev.className = 'af-btn secondary small'; prev.textContent = 'Preview';
        prev.title = 'Dress the character in this piece (over the default outfit)';
        prev.addEventListener('click', function (e) { e.stopPropagation(); markPreviewing(row); previewPainted(p); });
        row.appendChild(prev);
        var btn = document.createElement('button'); btn.className = 'af-btn secondary small'; btn.textContent = p.expansion === 'vanilla' ? 'Clone' : (set ? 'Import piece' : 'Import');
        btn.addEventListener('click', function (e) { e.stopPropagation(); importPiece(p, btn); });
        row.appendChild(btn);
        // Click the name to preview this piece (default outfit + piece). No hover previews: a
        // hover fired while the pointer crossed the rows after a set Preview and re-dressed the
        // character with just one piece — that was the "loads, then drops off" bug.
        var nameEl = row.children[1]; nameEl.style.cursor = 'pointer'; nameEl.title = 'Preview this piece on the character';
        nameEl.addEventListener('click', function (e) { e.stopPropagation(); markPreviewing(row); previewPainted(p); });
        return row;
    }

    // Highlight the set / piece row the preview character is currently wearing.
    function markPreviewing(el) {
        document.querySelectorAll('.af-set.previewing, .af-piece.previewing').forEach(function (x) { x.classList.remove('previewing'); });
        if (el) el.classList.add('previewing');
    }

    // Preview a single piece: default outfit + that piece (so it's in context, not on a naked body).
    // Vanilla pieces already have a real display, so they dress via the normal /Items/ItemDressing path
    // (no tbc flag); TBC/WotLK pieces dress from their client archive.
    function previewPainted(p) {
        if (!window.afViewer) return;
        var items = window.afViewer.defaultOutfit.map(function (d) { return { displayId: d.displayId, itemId: d.itemId }; });
        if (p.expansion === 'vanilla')
            items.push({ displayId: p.displayId, itemId: p.entry });
        else
            items.push({ tbc: true, expansion: p.expansion, entry: p.entry, displayId: p.displayId, inventoryType: p.inventoryType });
        window.afViewer.dressTbc(items);
        $('cvEquipped').textContent = 'preview: ' + p.name;
        apSetTarget({ pieces: [{ displayId: p.displayId, inventoryType: p.inventoryType, entry: p.entry, expansion: p.expansion }], items: items, name: p.name });
    }
    // Preview a whole set: the set's pieces alone (they cover the body; helm/shoulder geometry comes after import).
    function previewSet(s) {
        if (!window.afViewer) return;
        // tbc:true routes the piece to the lane-dressing endpoint, which only import lanes can serve.
        // Hard-coding it was safe only while the vanilla browse returned no sets — derive it instead.
        var items = s.pieces.map(function (p) {
            return p.expansion === 'vanilla'
                ? { displayId: p.displayId, itemId: p.entry }
                : { tbc: true, expansion: p.expansion, entry: p.entry, displayId: p.displayId, inventoryType: p.inventoryType };
        });
        window.afViewer.dressTbc(items);
        $('cvEquipped').textContent = 'preview: ' + s.name;
        apSetTarget({ pieces: s.pieces.map(function (p) { return { displayId: p.displayId, inventoryType: p.inventoryType, entry: p.entry, expansion: p.expansion }; }), items: items, name: s.name });
    }

    // ── Import ──
    // A piece is now configured first (value/stats/effects/tier), then imported (or cloned, for vanilla).
    function importPiece(p, btn) { openConfigure(p); }

    function doImport(p, itemConfigJson) {
        var laneLabel = (LANES[p.expansion] || LANES.tbc).label;
        var vanilla = p.expansion === 'vanilla';
        var verbing = vanilla ? 'Cloning ' : 'Importing ';
        // A clone packages nothing, so neither packaging line is true of it.
        var detail = vanilla
            ? 'Copying the item row and applying your configuration — no art is packaged.'
            : (p.renderKind === 'Modelled' ? 'Re-emitting ' + laneLabel + ' model(s) as native vanilla and storing them; the client patch rebuild is queued…' : 'Storing textures; the client patch rebuild is queued…');
        result('<div class="title">' + verbing + esc(p.name) + '…</div><div class="muted">' + detail + '</div>');
        var fd = new FormData(); fd.append('expansion', p.expansion || 'tbc'); fd.append('entry', p.entry);
        if (itemConfigJson) fd.append('itemConfig', itemConfigJson);
        // Appearance is only sent when the target can actually carry it. A vanilla clone cannot (it
        // reuses the source display), and sending it anyway is what the server now refuses outright —
        // so a glow toggle left on from an earlier preview would have blocked an otherwise fine clone.
        if (!vanilla) {
            // ...and only when the previewed recolor is actually THIS piece's. showPiece re-dresses the
            // character without re-targeting the panel, so a bake could otherwise outlive its subject
            // and be baked into the next piece imported.
            if (apActive && apActive.entries && apActive.entries.indexOf(+p.entry) >= 0) {
                fd.append('recolorHue', apActive.hue); fd.append('recolorTheory', apActive.theory); fd.append('recolorTier', apActive.tier);
                if (apActive.sat != null) { fd.append('recolorSat', apActive.sat); fd.append('recolorLight', apActive.light); }
            }
            if ($('apGlowOn').checked) fd.append('glowColor', $('apGlowColor').value); // bake flame/glow colour
            var giPiece = +$('apGlowIntensity').value / 100;
            if (Math.abs(giPiece - 1) > 0.01) fd.append('glowIntensity', giPiece); // bake glow strength
        }
        return post('/ArmorForge/Import', fd, true).then(function (r) { showPiece(r); return r; });
    }
    // Import set now opens the Set Configure modal (per-piece stats + set bonuses) first.
    function importSet(s, btn) { openSetConfigure(s); }
    function showPiece(r) {
        if (!r.ok) { result('<div class="title bad">Import failed</div><div class="bad" style="white-space:pre-wrap;">' + esc(r.body) + '</div>'); return; }
        var d = JSON.parse(r.body), a = d.apply || {};
        // A queued client-patch rebuild is pending work, not a failure: render it as such.
        function line(o, label) { return o ? ('<b>' + label + '</b><span class="' + (o.queued ? 'muted' : o.ok ? 'ok' : 'bad') + '">' + (o.queued ? '⏳ ' : '') + esc(o.msg) + '</span>') : ''; }
        // A clone ships no art: no patch, no download, no client restart. Calling it "Imported" above a
        // red empty Deploy row made a finished job read as a half-failed import. (The server now omits
        // `deploy` entirely when there was no patch step, so line() renders nothing for it.)
        var cloned = d.expansion === 'vanilla';
        var tail = cloned
            ? '<code>.additem ' + d.itemEntry + '</code> once the core reloads — no patch and no client restart, it reuses display ' + d.displayId + '.'
            : (a.deploy && a.deploy.queued
                ? 'The client patch was <strong>not rebuilt</strong> — import anything else you want first, then close WoW and click <strong>Rebuild patch</strong> (Registry card) to ship ' + (a.deploy.pending > 1 ? 'all ' + a.deploy.pending + ' pending changes' : 'it') + ' at once. Then start the client and <code>.additem ' + d.itemEntry + '</code>.'
                : 'Restart the client, then <code>.additem ' + d.itemEntry + '</code>.');
        result('<div class="title ok">' + (cloned ? 'Cloned: ' : 'Imported: ') + esc(d.name) + '</div><div class="af-kv"><b>Item entry</b><span>' + d.itemEntry + '</span><b>Display id</b><span>' + d.displayId + (cloned ? ' (the source’s own)' : '') + '</span>' +
            '<b>Piece</b><span>' + esc(d.family) + ' (' + esc(d.renderKind) + ')' + (d.models ? ' · ' + d.models + ' model file(s)' : '') + (d.components ? ' · ' + d.components + ' texture(s)' : '') + '</span>' +
            line(a.sql, 'World DB') + line(a.reload, 'Reload') + line(a.deploy, 'Deploy') + line(a.serverSets, 'Server sets') + '</div>' +
            (d.diagnostics && d.diagnostics.length ? '<div class="af-diag">' + esc(d.diagnostics.slice(0, 20).join('\n')) + '</div>' : '') +
            '<div class="muted" style="margin-top:6px;">' + tail + '</div>');
        loadList(); refreshStatus();
        if (window.afViewer) {
            var items = window.afViewer.defaultOutfit.map(function (o) { return { displayId: o.displayId, itemId: o.itemId }; });
            items.push({ displayId: d.displayId, itemId: d.itemEntry });
            window.afViewer.dressTbc(items);
        }
        // The import consumed the bake; drop it so it cannot attach itself to the next piece.
        apSetTarget(null);
    }

    // ── Configure-item modal (gameplay parity + tier/spec generator) ──
    var cfg = { piece: null, specCatalog: null, spells: [] };

    function openConfigure(p, opts) {
        opts = opts || {};
        cfg.piece = p; cfg.spells = []; cfg.allowableClass = null; cfg.onSubmit = opts.onSubmit || defaultConfigureImport;
        $('cfgTitle').textContent = opts.title || ('Configure — ' + p.name);
        $('cfgSubmit').textContent = opts.verb || (p.expansion === 'vanilla' ? 'Clone' : 'Import');
        $('cfgName').value = ''; $('cfgName').placeholder = 'keep source name (' + p.name + ')';
        $('cfgQuality').value = String(p.quality != null ? p.quality : 4);
        $('cfgItemLevel').value = ''; $('cfgItemLevel').placeholder = 'source (' + (p.itemLevel || '') + ')';
        $('cfgReqLevel').value = '';
        ['cfgBuyG', 'cfgBuyS', 'cfgBuyC', 'cfgSellG', 'cfgSellS', 'cfgSellC'].forEach(function (id) { $(id).value = ''; });
        ['cfgArmor', 'cfgHolyRes', 'cfgFireRes', 'cfgNatureRes', 'cfgFrostRes', 'cfgShadowRes', 'cfgArcaneRes', 'cfgDurability'].forEach(function (id) { $(id).value = ''; });
        $('cfgBonding').value = ''; $('cfgStats').innerHTML = ''; $('cfgSpells').innerHTML = '';
        $('cfgSpellResults').style.display = 'none'; $('cfgSpellResults').innerHTML = ''; $('cfgSpellSearch').value = '';
        $('cfgError').style.display = 'none'; $('cfgGenSummary').textContent = ''; $('cfgGenHints').innerHTML = '';
