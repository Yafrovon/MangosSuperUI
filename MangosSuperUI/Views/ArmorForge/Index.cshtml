            var b = document.createElement('button'); b.className = 'af-btn secondary small'; b.textContent = t[1]; b.type = 'button';
            if (t[0] === 'none') b.title = 'No palette theory — every material takes the picked colour straight, keeping its own shade and shine.';
            b.onclick = function () { apTheory = t[0]; host.querySelectorAll('button').forEach(function (x) { x.classList.remove('on'); }); b.classList.add('on'); apApply(); };
