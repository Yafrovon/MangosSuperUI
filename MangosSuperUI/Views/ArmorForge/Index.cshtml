                        '<td style="white-space:nowrap;"><button class="af-btn secondary small" data-view="' + r.displayId + '" data-entry="' + r.itemEntry + '" style="margin-right:5px;">View</button><button class="af-del" data-del="' + r.displayId + '">Delete</button></td></tr>';
