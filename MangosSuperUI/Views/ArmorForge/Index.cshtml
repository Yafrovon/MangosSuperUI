@{
    ViewData["Title"] = "Armor Forge";
}

@section Styles {
    <style>
        .af-wrap { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .af-header { padding: 16px 28px 10px; border-bottom: 1px solid var(--border-light); }
        .af-header h1 { font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px; display: flex; align-items: center; gap: 10px; }
        .af-sub { font-size: 12.5px; color: var(--text-muted); max-width: 900px; line-height: 1.5; }
        .af-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
        .af-pill { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border-light); color: var(--text-muted); background: var(--bg-card); }
        .af-pill.ok { color: #14804a; border-color: #14804a55; background: #14804a14; }
        .af-pill.bad { color: #b42318; border-color: #b4231855; background: #b4231814; }
        .af-pill.warn { color: #b54708; border-color: #b5470855; background: #b5470814; }

        .af-body { flex: 1; display: grid; grid-template-columns: 1fr minmax(380px, 42%); gap: 18px; padding: 16px 28px; overflow: hidden; }
        @@media (max-width: 1100px) { .af-body { grid-template-columns: 1fr; overflow-y: auto; } }
        .af-controls { overflow-y: auto; padding-right: 6px; display: flex; flex-direction: column; gap: 14px; min-height: 0; }
        .af-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 10px; padding: 15px 17px; }
        .af-card > h3 { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px; display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
        .af-card > h3::before { content: '▾'; font-size: 10px; color: var(--text-muted); }
        .af-card.collapsed > h3 { margin-bottom: 0; } .af-card.collapsed > h3::before { content: '▸'; }
        .af-card.collapsed > :not(h3) { display: none !important; }
        .af-card .phase { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); border: 1px solid var(--border-light); border-radius: 4px; padding: 1px 6px; }
        .af-card p { font-size: 12px; color: var(--text-muted); margin: 0 0 10px; line-height: 1.5; }
        .af-btn { padding: 7px 13px; font-size: 12.5px; font-weight: 600; border-radius: 7px; cursor: pointer; border: 1px solid var(--accent, #2563eb); background: var(--accent, #2563eb); color: #fff; white-space: nowrap; }
        .af-btn.secondary { background: transparent; color: var(--text-primary); border-color: var(--border-light); }
        .af-btn.small { padding: 3px 9px; font-size: 11.5px; }
        .af-other-btn.on { background: var(--accent, #2563eb); color: #fff; border-color: var(--accent, #2563eb); }
        .af-btn:disabled { opacity: .55; cursor: default; }
        .af-input { width: 100%; padding: 8px 10px; font-size: 13px; border-radius: 7px; box-sizing: border-box; border: 1px solid var(--border-light); background: var(--bg-input, var(--bg-card)); color: var(--text-primary); }
        select.af-input { width: auto; }

        /* TBC search + grouped results */
        .af-search { display: flex; gap: 8px; align-items: center; }
        /* flex-shrink:0 — with 60 sets in a max-height column flexbox, default shrink crushed each set to a hairline. */
        /* The set list scrolls with its bar on the LEFT (direction:rtl trick), away from the page
           column's own right-edge scrollbar — and the boxes stand off it so the bar has its own
           visible gutter instead of hugging the content. */
        .af-results { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; max-height: 62vh; overflow-y: auto; padding-left: 12px; direction: rtl; }
        .af-results > * { flex-shrink: 0; direction: ltr; }
        .af-set { border: 1px solid var(--border-light); border-radius: 9px; overflow: hidden; }
        .af-set-head { display: flex; align-items: center; gap: 10px; padding: 9px 12px; cursor: pointer; background: #ffffff05; }
        .af-set-head:hover { background: #ffffff0b; }
        .af-set-head .nm { font-weight: 700; color: var(--text-primary); font-size: 13px; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .af-set-head .cnt { font-size: 11px; color: var(--text-muted); }
        .af-set-head .chev { font-size: 10px; color: var(--text-muted); width: 10px; }
        .af-set-body { display: none; border-top: 1px dashed var(--border-light); }
        .af-set.open .af-set-body { display: block; }
        /* icon · name · slot · Preview · Import|Clone — the fourth auto column is the Preview button. */
        .af-piece { display: grid; grid-template-columns: 20px 1fr auto auto auto; align-items: center; gap: 8px; padding: 5px 12px; font-size: 12px; border-bottom: 1px dashed var(--border-light); color: var(--text-primary); }
        .af-piece:last-child { border-bottom: 0; }
        .af-piece .slot { font-size: 10.5px; color: var(--text-muted); min-width: 110px; text-align: right; }
        .af-piece .q0 { color: #9d9d9d; } .af-piece .q1 { color: var(--text-primary); } .af-piece .q2 { color: #1eff00; } .af-piece .q3 { color: #0070dd; } .af-piece .q4 { color: #a335ee; } .af-piece .q5 { color: #ff8000; }
        .af-piece .ico { font-size: 11px; color: var(--text-muted); }
        /* The set / piece currently dressed on the preview character. */
        .af-set.previewing { border-color: color-mix(in srgb, var(--accent, #3b82c4) 55%, transparent);
            box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent, #3b82c4) 40%, transparent); }
        .af-set.previewing > .af-set-head { background: color-mix(in srgb, var(--accent, #3b82c4) 10%, transparent); }
        .af-piece.previewing { background: color-mix(in srgb, var(--accent, #3b82c4) 10%, transparent); }
        .af-loose-h { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); margin: 6px 0 2px; }
        .af-empty { font-size: 12px; color: var(--text-muted); padding: 10px 2px; }

        /* registry */
        .af-list table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .af-list th { text-align: left; color: var(--text-muted); font-weight: 600; font-size: 11px; padding: 4px 8px 4px 0; border-bottom: 1px solid var(--border-light); }
        .af-list td { padding: 5px 8px 5px 0; color: var(--text-primary); border-bottom: 1px dashed var(--border-light); }
        .af-list td.muted { color: var(--text-muted); }
        .af-del { padding: 3px 9px; font-size: 11.5px; font-weight: 600; border-radius: 6px; cursor: pointer; border: 1px solid #b4231855; background: #b4231814; color: #b42318; }
        .af-grp { background: #ffffff06; font-weight: 700; }
        .af-list td.sel, .af-list th.sel { width: 22px; padding-right: 4px; }
        .af-list input[type=checkbox] { margin: 0; cursor: pointer; }
        .af-list tr.selected td { background: #4f8ef714; }

        /* right panel */
        .af-right { display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow: hidden; }
        .af-viewer-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 11px; color: var(--text-muted); font-weight: 600; }
        .af-viewer-toolbar select { padding: 5px 8px; font-size: 12px; border-radius: 6px; border: 1px solid var(--border-light); background: var(--bg-input, var(--bg-card)); color: var(--text-primary); }
        .cv-canvas-wrap { position: relative; flex: 1; min-height: 340px; border: 1px solid var(--border-light); border-radius: 10px; overflow: hidden; background: linear-gradient(180deg, #1a1d24, #0f1115); }
        #char-preview-canvas { width: 100%; height: 100%; display: block; }
        .af-viewer-hint { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #8a93a6; font-size: 12px; text-align: center; padding: 0 20px; pointer-events: none; }
        .af-result { border: 1px solid var(--border-light); border-radius: 10px; padding: 12px 14px; background: var(--bg-card); font-size: 12px; overflow-y: auto; max-height: 36%; flex-shrink: 0; }
        .af-result .title { font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
        .af-result .ok { color: #46b77a; } .af-result .bad { color: #d46a64; } .af-result .muted { color: var(--text-muted); }
        .af-kv { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; }
        .af-kv b { color: var(--text-primary); font-weight: 600; }
        .af-diag { margin-top: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 10.5px; line-height: 1.45; color: var(--text-muted); white-space: pre-wrap; max-height: 120px; overflow-y: auto; }

        /* bonus editor */
        .af-bonus-row { display: grid; grid-template-columns: 70px 1fr 32px; gap: 7px; align-items: center; margin-top: 6px; }
        .af-members { max-height: 150px; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 7px; padding: 6px 8px; margin-top: 6px; }
        .af-member { display: flex; align-items: center; gap: 7px; font-size: 12px; padding: 2px 0; color: var(--text-primary); }

        /* Configure-item modal (gameplay parity with the weapon forge) */
        .af-modal { position: fixed; inset: 0; background: #000a; display: none; align-items: center; justify-content: center; z-index: 1000; }
        .af-modal.open { display: flex; }
        .af-modal-box { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px; width: min(760px, 94vw); max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px #000a; }
        .af-modal-head { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--border-light); }
        .af-modal-head .t { font-weight: 700; font-size: 15px; color: var(--text-primary); flex: 1; }
        .af-modal-x { background: transparent; border: 0; color: var(--text-muted); font-size: 22px; line-height: 1; cursor: pointer; padding: 0 4px; }
        .af-modal-body { padding: 14px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }
        .af-modal-foot { display: flex; gap: 8px; justify-content: flex-end; padding: 12px 18px; border-top: 1px solid var(--border-light); }
        .cfg-sec { border: 1px solid var(--border-light); border-radius: 9px; padding: 11px 13px; }
        .cfg-sec-h { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
        .cfg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 9px 12px; }
        .cfg-grid label, .cfg-field { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--text-muted); font-weight: 600; }
        .cfg-grid label input, .cfg-grid label select { margin-top: 2px; }
        .cfg-coins { display: flex; gap: 5px; align-items: center; }
        .cfg-coins input { width: 62px; }
        .cfg-stat-row, .cfg-spell-row { display: grid; grid-template-columns: 1fr 90px 28px; gap: 7px; align-items: center; margin-top: 6px; }
        .cfg-spell-row { grid-template-columns: 1fr 28px; }
        .cfg-hints { margin-top: 8px; font-size: 11.5px; color: var(--text-muted); line-height: 1.5; }
        .cfg-hints ul { margin: 4px 0 0; padding-left: 18px; }
        .cfg-summary { font-size: 11.5px; color: var(--accent, #2563eb); font-weight: 600; }
        .cfg-search-results { max-height: 180px; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 7px; margin-top: 6px; }
        .cfg-search-item { padding: 6px 9px; font-size: 12px; cursor: pointer; border-bottom: 1px dashed var(--border-light); color: var(--text-primary); }
        .cfg-search-item:hover { background: #ffffff0b; }
        .cfg-search-item:last-child { border-bottom: 0; }
        .cfg-chip { display: flex; align-items: center; gap: 6px; font-size: 12px; padding: 4px 8px; border: 1px solid var(--border-light); border-radius: 7px; margin-top: 6px; color: var(--text-primary); }
        .cfg-chip .x { margin-left: auto; cursor: pointer; color: #b42318; font-weight: 700; }
        .cfg-err { color: #d46a64; font-size: 12px; white-space: pre-wrap; margin-top: 6px; }
        #apTheories .af-btn.on { background: var(--accent, #2563eb); color: #fff; border-color: var(--accent, #2563eb); }
        #cfgModal { z-index: 1100; } /* per-piece editor stacks above the set modal */
    </style>
}

<div class="app-shell">
    <partial name="_Sidebar" />
    <div class="main-content">
<div class="af-wrap">
    <div class="af-header">
        <h1><i class="fa-solid fa-shield-halved"></i> Armor Forge</h1>
        <div class="af-sub">
            Import armor from a <strong>TBC (2.4.3)</strong> or <strong>WotLK (3.3.5a) client</strong> into the live vanilla server — whole <strong>sets</strong> at once
            (they're grouped from the client's own set data so the pieces that belong together come across together), or a single piece.
            Painted pieces carry their body textures; helms &amp; shoulders are re-emitted as native vanilla models (all 16 race/gender
            variants, L/R shoulders); cloaks carry their cape texture. Ships in <code>patch-4.MPQ</code> — restart the client, then <code>.additem</code>.
            Set bonuses are yours to define. The TBC and WotLK lanes cannot carry theirs across (their spell
            ids belong to a later client), but a VANILLA set clone pre-fills the source set's own bonuses,
            because those spells already exist in your core — edit or clear them like any other row.
        </div>
        <div class="af-pills">
            <span class="af-pill" id="pillFixture">fixture …</span>
            <span class="af-pill" id="pillTbc">TBC …</span>
            <span class="af-pill" id="pillWotlk">WotLK …</span>
            <span class="af-pill" id="pillVanilla" title="Checked when you open the Clone Vanilla card — it is a live world-database query">Vanilla: clone</span>
            <span class="af-pill" id="pillPatch">patch …</span>
            <span class="af-pill" id="pillDeploy" title="Imports and deletes are queued; the patch-4.MPQ in the client is only rebuilt and deployed when you click Rebuild patch. The game client locks its MPQs while running, so close it first.">deploy …</span>
            <span class="af-pill" id="pillItemSet" title="Set membership and n-piece bonuses need ItemSet.dbc in the SERVER's dbc directory, not just in the client patch. The core reads it once at startup and zeroes item_template.set_id for any set it cannot find — so a freshly deployed file does nothing until mangosd restarts.">sets …</span>
        </div>
    </div>

    <div class="af-body">
        <div class="af-controls">

            <div class="af-card collapsed">
                <h3><span class="phase">Import</span> TBC armor &amp; sets</h3>
                <p id="tbcState">Checking TBC mount…</p>
                <div class="af-search">
                    <input type="text" id="tbcSearch" class="af-input" placeholder="Search sets or pieces — e.g. Netherblade, Tier 4, Warbringer… or a slot: boots, helm, waist" disabled>
                    <select id="tbcFamily" class="af-input" title="Filter loose pieces by slot">
                        <option value="">All slots</option>
                    </select>
                    <button type="button" class="af-btn secondary small af-other-btn" id="tbcOtherBtn"
                            title="Levelling greens, dungeon blues, crafted sets and the earlier expansions' tiers — the client's ItemSet.dbc ships them all. Hidden by default so the tier and arena sets are readable.">Other sets</button>
                </div>
                <div class="af-results" id="tbcResults"><div class="af-empty">Set the TBC Data Path on <a href="/Settings">Settings</a> to browse.</div></div>
            </div>

            <div class="af-card collapsed">
                <h3><span class="phase">Import</span> WotLK armor &amp; sets</h3>
                <p id="wotlkState">Checking WotLK mount…</p>
                <div class="af-search">
                    <input type="text" id="wotlkSearch" class="af-input" placeholder="Search WotLK sets or pieces — e.g. Wrathful, Sanctified, Tier 10… or a slot: boots, helm, waist" disabled>
                    <select id="wotlkFamily" class="af-input" title="Filter loose pieces by slot">
                        <option value="">All slots</option>
                    </select>
                    <button type="button" class="af-btn secondary small af-other-btn" id="wotlkOtherBtn"
                            title="Levelling greens, dungeon blues, crafted sets and the earlier expansions' tiers — the client's ItemSet.dbc ships them all. Hidden by default so the tier and arena sets are readable.">Other sets</button>
                </div>
                <div class="af-results" id="wotlkResults"><div class="af-empty">Set the WotLK Data Path on <a href="/Settings">Settings</a> to browse.</div></div>
            </div>

            <div class="af-card collapsed">
                <h3><span class="phase">Clone</span> Vanilla armor</h3>
                <p id="vanillaState">Clone an existing vanilla armor piece — or a whole stock set — into new custom items. Each piece reuses the source's own model/textures (already in your client) and can be re-itemized (value, stats, effects). <strong>A single piece packages nothing</strong>: no patch, no download, no client restart, usable via <code>.additem</code> as soon as the core reloads. <strong>Cloning a SET does package one thing</strong> — the set itself is a row in ItemSet.dbc, so it ships in the client patch (rebuilt on request) and needs a client restart plus a mangosd restart to take effect. A recolor or glow tint cannot ride along either way: new art needs a new display, which is what the import lanes build.</p>
                <div class="af-search">
                    <input type="text" id="vanillaSearch" class="af-input" placeholder="Search vanilla armor by name, item id, or slot — e.g. Cenarion, 16795, boots…">
                    <select id="vanillaFamily" class="af-input" title="Filter by slot">
                        <option value="">All slots</option>
                    </select>
                    <button type="button" class="af-btn secondary small af-other-btn" id="vanillaOtherBtn"
                            title="Levelling greens, crafted sets, the small two- and three-piece sets, and anything below item level 63 — the client's ItemSet.dbc ships them all. Hidden by default so the tier and PvP sets are readable.">Other sets</button>
                </div>
                <div class="af-results" id="vanillaResults"><div class="af-empty">Search to browse vanilla armor.</div></div>
            </div>

            <div class="af-card collapsed">
                <h3><span class="phase">Registry</span> Forged Armor</h3>
                <p>The forged armor inside <code>patch-4.MPQ</code>, grouped by set. <strong>View</strong> shows a piece on the character.
                   Delete removes it from the world DB and the patch; ids return to the pool.</p>
                <div id="afList" class="af-list"><span class="muted" style="font-size:12px;">Loading…</span></div>
                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                    <button class="af-btn secondary" id="afDeleteSelected" disabled title="Delete every ticked set and piece in one go: one world reload, one repack, one queued patch rebuild.">Delete selected</button>
                    <button class="af-btn secondary" data-action="rebuildPatch" title="Package every queued change into patch-4.MPQ and deploy it to the client Data folder. Close WoW first — a running client locks the file.">Rebuild patch</button>
                    <a class="af-btn secondary" href="/ArmorForge/DownloadPatch" style="text-decoration:none;"><i class="fa-solid fa-download"></i> Download patch-4.MPQ</a>
                    <button class="af-btn secondary" id="btnRestartMangosd" data-action="restartMangosd" style="display:none;"
                            title="ItemSet.dbc has been written to the server's dbc directory but mangosd has not restarted since. The core only reads DBCs at startup, so forged sets stay inert until it does.">
                        <i class="fa-solid fa-rotate"></i> Restart mangosd (sets pending)</button>
                </div>
            </div>

            <div class="af-card collapsed">
                <h3><span class="phase">Optional</span> Vanilla set bonuses</h3>
                <p>Imported sets come across with <em>no</em> bonuses — this is vanilla. If you want a set to do something, pick it and add
                   bonuses (piece count → effect). They write into <code>ItemSet.dbc</code>, which is deployed to the server's own dbc
                   directory automatically; the core reads it at startup, so <strong>bonuses apply after a mangosd restart</strong>.
                   Watch the <strong>sets</strong> pill above — it turns red when a restart is owed.</p>
                <select id="setPick" class="af-input"><option value="0">— pick a forged set —</option></select>
                <input type="text" id="setName" class="af-input" placeholder="Set name" style="margin-top:8px;">
                <label style="font-size:11px;color:var(--text-muted);font-weight:600;display:block;margin-top:10px;">Member pieces</label>
                <div class="af-members" id="setMembers"><span class="muted" style="font-size:11px;">Pick a set.</span></div>
                <label style="font-size:11px;color:var(--text-muted);font-weight:600;display:block;margin-top:10px;">Bonuses</label>
                <div id="setBonuses"></div>
                <div style="display:flex;gap:8px;margin-top:10px;">
                    <button class="af-btn secondary small" id="addBonus">+ Add bonus</button>
                    <button class="af-btn" data-action="saveSet"><i class="fa-solid fa-floppy-disk"></i> Save set</button>
                </div>
            </div>

            <div class="af-card collapsed">
                <h3><span class="phase">Appearance</span> Recolor preview</h3>
                <p id="apHint">Preview a piece <strong>or a whole set</strong>, then pick a <strong>primary colour</strong> — the palette engine shifts the rest to match and recolors every previewed piece together. Cycle the theories to compare. Tick <strong>Recolor glow</strong> to tint the animated flame/particle effects.</p>
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);font-weight:600;">Primary
                        <input type="color" id="apColor" value="#3b6fd4" style="width:44px;height:28px;padding:0;border:1px solid var(--border-light);border-radius:6px;background:none;">
                    </label>
                    <button class="af-btn secondary small" id="apDetect" type="button">Detect from item</button>
                    <label style="font-size:12px;color:var(--text-muted);font-weight:600;">Tier
                        <select id="apTier" class="af-input" style="width:auto;">
                            <option value="subtle">Subtle</option>
                            <option value="improved" selected>Improved</option>
                            <option value="bold">Bold</option>
                            <option value="extreme">Extreme</option>
                        </select>
                    </label>
                </div>
                <div id="apTheories" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;"></div>
                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px;padding-top:10px;border-top:1px dashed var(--border-light);">
                    <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);font-weight:600;">
                        <input type="checkbox" id="apGlowOn"> Recolor glow / flame effects
                    </label>
                    <input type="color" id="apGlowColor" value="#33aaff" style="width:44px;height:28px;padding:0;border:1px solid var(--border-light);border-radius:6px;background:none;">
                    <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);font-weight:600;"
                           title="Glow strength: scales the emitter colour keys — additive flames render colour as brightness. Below 100% the particles also shrink slightly. Bakes on import even when the recolor tint is off.">
                        Intensity
                        <input type="range" id="apGlowIntensity" min="10" max="200" step="5" value="100" style="width:110px;">
                        <span id="apGlowIntensityVal" style="min-width:38px;font-family:ui-monospace,Consolas,monospace;">100%</span>
                    </label>
                    <span id="apGlowNote" class="muted" style="font-size:11px;">Tints animated glow/particle effects on the previewed piece(s).</span>
                </div>
