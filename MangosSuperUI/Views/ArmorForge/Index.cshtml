        }
    }
    function apDetect() {
        if (!apCurrent || !apCurrent.pieces || !apCurrent.pieces.length) { $('apStatus').textContent = 'Preview a piece or set first.'; return; }
        $('apStatus').textContent = 'Detecting primary colour…';
        fetch('/RetextureEngine/Primary?displayId=' + apCurrent.pieces[0].displayId).then(function (r) { return r.json(); }).then(function (d) {
            if (d.success && d.primaryHex) { $('apColor').value = d.primaryHex; apApply(); }
            else $('apStatus').textContent = 'Could not detect a primary colour.';
        }).catch(function () { $('apStatus').textContent = 'Detect failed.'; });
    }
    function apGlowApply() {
