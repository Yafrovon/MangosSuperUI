        async function resolveExactItemSpell(card) {
            const idInput = card.querySelector('.ib-spell-id');
            const triggerInput = card.querySelector('.ib-spell-trigger');
            const id = +idInput.value;
            const trigger = +triggerInput.value;
            const mine = String((+card.dataset.exactSerial || 0) + 1);
            card.dataset.exactSerial = mine;
            const isCurrent = () => card.isConnected && card.dataset.exactSerial === mine &&
                +idInput.value === id && +triggerInput.value === trigger;
            if (!(id > 0)) { setSpellResolution(card, false, 'Enter a positive Spell ID.'); return false; }
            setSpellResolution(card, null, 'Checking the native stock-item effect pair…');
            try {
                const rows = await queryItemSpellEffects(id, trigger, 10);
                if (!isCurrent()) return false;
                const exactMatches = rows.filter(r => +r.id === id);
                if (!exactMatches.length) { setSpellResolution(card, false, `Spell #${id} is not a native stock-item effect for this trigger.`); return false; }
                if (exactMatches.length > 1) {
                    // Several stock items install this same spell and differ only in the slot numbers
                    // (Thunderfury 19019 procs at 8 PPM; the deprecated 17802 carries the identical
                    // spell at 0). The card is ALREADY pre-filled from the source item, so those
                    // numbers are the answer — narrow on them before demanding a choice.
                    const cur = {
                        charges: +card.querySelector('.ib-spell-charges').value || 0,
                        ppm: +card.querySelector('.ib-spell-ppm').value || 0,
                        category: +card.querySelector('.ib-spell-category').value || 0,
                    };
                    const narrowed = exactMatches.filter(r =>
                        (r.charges ?? 0) === cur.charges &&
                        (r.ppmRate ?? 0) === cur.ppm &&
                        (r.category ?? 0) === cur.category);
                    if (narrowed.length === 1) { selectItemSpell(card, { ...narrowed[0], trigger }); return true; }

                    // Still ambiguous. Offer the list, and ALSO spell the variants out in the message:
                    // the results dropdown is absolutely positioned and can be clipped inside the
                    // modal, and an unreachable picker is the same as no picker.
                    renderItemSpellResults(card, exactMatches);
                    const summary = exactMatches
                        .map(r => `charges ${r.charges ?? 0} / PPM ${r.ppmRate ?? 0} / category ${r.category ?? 0}`)
                        .join('  —  ');
                    setSpellResolution(card, false,
                        `Spell #${id} has ${exactMatches.length} stock item variants: ${summary}. ` +
                        `Pick one from the list, or type those numbers into the fields below to choose it.`);
                    return false;
                }
                selectItemSpell(card, { ...exactMatches[0], trigger });
                return true;
            } catch (e) {
                if (isCurrent()) setSpellResolution(card, false, String(e));
                return false;
            }
        }
        function setSpellResolution(card, ok, text) {
