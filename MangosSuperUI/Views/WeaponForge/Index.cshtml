            // Generator inputs (#ibGenCard) are not part of the item config — never let them block a forge.
            const invalid = [...modal.querySelectorAll('input, select, textarea')].find(x => !x.disabled && !x.closest('#ibGenCard') && !x.checkValidity());
            if (invalid) {
                errors.push('One or more fields are missing or outside the allowed range.');
                const pane = invalid.closest('[data-build-pane]');
                if (pane) setItemBuildTab(pane.dataset.buildPane);
                setTimeout(() => { invalid.focus(); invalid.reportValidity(); }, 0);
            }
            if (!config.name) errors.push('Item name is required.');
            if (config.name.length > 255) errors.push('Item name must be 255 characters or fewer.');
            if ((config.description || '').length > 255) errors.push('Description must be 255 characters or fewer.');
            if (!Number.isInteger(config.quality) || config.quality < 0 || config.quality > 6) errors.push('Choose a valid vanilla item quality.');
            if (!ITEM_SLOT_VALUES.includes(config.inventoryType)) errors.push('Choose a valid weapon equip slot.');
            if (!Number.isInteger(config.itemLevel) || config.itemLevel < 1 || config.itemLevel > 255) errors.push('Item level must be between 1 and 255.');
            if (!Number.isInteger(config.requiredLevel) || config.requiredLevel < 0 || config.requiredLevel > 60) errors.push('Required level must be between 0 and 60.');
            if (!Number.isInteger(config.requiredHonorRank) || config.requiredHonorRank < 0 || config.requiredHonorRank > 14) errors.push('Honor rank must be between 0 and 14.');
            if (!Number.isInteger(config.requiredReputationRank) || config.requiredReputationRank < 0 || config.requiredReputationRank > 7) errors.push('Reputation rank must be between 0 and 7.');
            if (!Number.isInteger(config.requiredSkillRank) || config.requiredSkillRank < 0 || config.requiredSkillRank > 300) errors.push('Skill rank must be between 0 and 300.');
            if (config.requiredSkill === 0 && config.requiredSkillRank > 0) errors.push('Skill rank must be zero when no required skill is selected.');
            // Faction 0 plus a rank is Vanilla's native vendor-faction requirement.
            if (!Number.isFinite(config.damageMin) || config.damageMin < 0 || !Number.isFinite(config.damageMax) || config.damageMax < config.damageMin) errors.push('Damage maximum must be at least the non-negative minimum.');
            if (config.delayMs !== undefined && (!Number.isInteger(config.delayMs) || config.delayMs < 100 || config.delayMs > 65535)) errors.push('Swing speed must produce a delay between 100 and 65,535 ms.');
            if (config.stats.length > 10) errors.push('No more than 10 direct stats may be added.');
