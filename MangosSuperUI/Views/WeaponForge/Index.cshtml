            if (speed !== '') q.append('delayMs', Math.round(+speed * 1000));
            btn.disabled = true;
            try {
                const d = await (await fetch('/WeaponForge/Itemize?' + q)).json();
                if (!d.ok) { summary.textContent = d.error || 'Generate failed.'; return; }
                const set = (id, v) => { document.getElementById(id).value = v; };
                set('ibQuality', String(d.quality));
                set('ibItemLevel', d.itemLevel); set('ibRequiredLevel', d.requiredLevel);
                const meta = weaponTypeMeta.get(itemBuildState.familyKey);
                if (meta && meta.isShield) {
