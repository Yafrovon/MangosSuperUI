                <div class="wf-review-line"><span>Source</span><b>${esc(itemBuildSourceKindLabel())}</b></div>
                <div class="wf-review-line"><span>Family</span><b>${esc(itemBuildState.familyLabel)}</b></div>
                <div class="wf-review-line"><span>Quality / slot</span><b>${esc(ITEM_QUALITY_NAMES[config.quality] || '?')} · ${esc(ITEM_SLOT_NAMES[config.inventoryType] || '?')}</b></div></div>
                <div class="wf-review-block"><h5>Power</h5>
                <div class="wf-review-line"><span>Levels</span><b>ilvl ${config.itemLevel} · requires ${config.requiredLevel || 'none'}</b></div>
                <div class="wf-review-line"><span>Damage</span><b>${config.damageMin}–${config.damageMax} ${esc(ITEM_DAMAGE_NAMES[config.damageType] || '?')}</b></div>
                <div class="wf-review-line"><span>Speed</span><b>${config.delayMs ? `${(config.delayMs / 1000).toFixed(2)} sec` : 'Preserve source default'}</b></div>
                <div class="wf-review-line"><span>Direct stats</span><b>${esc(statText)}</b></div>
                <div class="wf-review-line"><span>Defense</span><b>${config.armor} armor · ${config.block} block${resistTotal ? ` · ${resistTotal} total resist` : ''}</b></div></div>
                <div class="wf-review-block"><h5>Effects & rules</h5>
                <div class="wf-review-line"><span>Spell slots</span><b>${spellText}</b></div>
                <div class="wf-review-line"><span>Allowed</span><b>${classCount} classes · ${raceCount} races</b></div>
                <div class="wf-review-line"><span>Durability / bind</span><b>${config.maxDurability} · ${document.getElementById('ibBonding').selectedOptions[0]?.textContent || '?'}</b></div>
                <div class="wf-review-line"><span>Vendor</span><b>Buy ${formatCopper(config.buyPrice)} · Sell ${formatCopper(config.sellPrice)}</b></div></div>`;
        }
        function updateQualityReadout() {
            const q = +document.getElementById('ibQuality').value;
            const el = document.getElementById('ibQualityReadout');
            el.textContent = ITEM_QUALITY_NAMES[q] || 'Unknown'; el.style.color = QUALITY_COLORS[q] || 'inherit';
        }
        function updateItemBuildReview() {
            if (!document.getElementById('itemBuildModal').classList.contains('open')) return;
            updateQualityReadout();
            const html = itemReviewHtml(collectItemConfig());
            document.getElementById('ibReviewSide').innerHTML = html;
            document.getElementById('ibReviewFull').innerHTML = html;
        }
        function itemBuildSourceKindLabel() {
            const mode = itemBuildState.mode;
            if (mode === 'glb') return 'GLB import';
            if (mode === 'vanilla')
                return vanillaRecolorOn() ? 'Vanilla recolor (forged)' : 'Vanilla clone';
            return `${LEGACY[mode].label} import`;
        }
        async function submitItemBuild() {
            if (itemBuildSubmitting) return;

            // Run native browser range/step validation while controls are still enabled.
            hideItemBuildErrors();
            let config = collectItemConfig();
            const errors = validateItemConfig(config);
            if (errors.length) { showItemBuildErrors(errors); return; }

            itemBuildSubmitting = true;
            const btn = document.getElementById('ibSubmit');
            const modalShell = document.querySelector('#itemBuildModal .wf-build-modal');
            const controls = [...modalShell.querySelectorAll('button, input, select, textarea')];
            const previousDisabled = controls.map(control => control.disabled);
            const status = document.getElementById('ibReadyState');
            const old = btn.innerHTML;
            controls.forEach(control => { control.disabled = true; });
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validating…';
            modalShell.setAttribute('aria-busy', 'true');
            status.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validating item configuration…';
            status.style.borderColor = ''; status.style.color = '';
            status.focus({ preventScroll: true });
            try {

                // Capture the reviewed source and geometry controls before asynchronous spell validation.
                const mode = itemBuildState.mode;
                const familyKey = itemBuildState.familyKey;
                let vanillaSource = null;
                const fd = new FormData();
                if (mode === 'vanilla') {
                    // Nothing to package: no file, no mesh controls, no glow or recolor bake. Just
                    // which stock weapon to copy and what the new item should be.
                    if (!VANILLA.sel) throw new Error('The selected vanilla weapon is no longer available.');
                    // Snapshot it: two awaits follow (spell validation, then the POST) and a debounced
                    // list repaint queued before the modal opened can null VANILLA.sel mid-flight. The
                    // success renderer below reads the source name, so without this a clone that
                    // actually landed reported a TypeError into an already-closed modal.
                    vanillaSource = VANILLA.sel;
                    fd.append('entry', vanillaSource.entry);
                    // A recolor cannot be a clone: it needs its own display and art. Same selection,
                    // same config modal — it just goes down the packaging route instead. The server
                    // resolves model and display row from the entry alone.
                    if (vanillaRecolorOn()) {
                        fd.append('weaponType', vanillaSource.family || '');
                        if (document.getElementById('vanillaRcOn').checked) {
                            appendRecolorPick(fd, document.getElementById('vanillaRcColor').value);
                            fd.append('recolorTheory', (VANILLA.rcTheory && VANILLA.rcTheory()) || 'none');
                            fd.append('recolorTier', document.getElementById('vanillaRcTier').value || 'improved');
                        }
                        if (document.getElementById('vanillaRcGlowOn').checked)
                            fd.append('glowColor', document.getElementById('vanillaRcGlowColor').value);
                    }
                } else if (mode === 'glb') {
                    const file = document.getElementById('glbFile').files[0];
                    if (!file) throw new Error('The selected GLB is no longer available.');
                    fd.append('file', file);
                    importParams(fd);
                    fd.set('weaponType', familyKey);
                } else {
                    const lane = LEGACY[mode];
                    if (!lane || !lane.sel) throw new Error(`The selected ${lane ? lane.label : 'import'} weapon is no longer available.`);
                    fd.append('entry', lane.sel.entry);
                    fd.append('model', lane.sel.model);
                    fd.append('displayRow', lane.sel.displayRow);
                    fd.append('weaponType', familyKey);
                    fd.append('targetTriangles', lane.targetTris());
                    laneGlowParams(lane, fd);
                    laneRecolorParams(lane, fd);           // bake the previewed skin recolor
                    const glowTint = laneGlowTint(lane);   // bake the flame/glow colour
                    if (glowTint) fd.append('glowColor', glowTint);
                }

                const spellErrors = await validateItemSpells(config);
                if (spellErrors.length) { showItemBuildErrors(spellErrors); setItemBuildTab('effects'); return; }

                // Exact-ID resolution may have populated the selected stock slot values.
                config = collectItemConfig();
                const resolvedErrors = validateItemConfig(config);
                if (resolvedErrors.length) { showItemBuildErrors(resolvedErrors); return; }

                // A recolored vanilla item is NOT a clone — it mints its own display and art — so it
                // goes down the packaging route. Same card, same selection, same config modal.
                const cloning = mode === 'vanilla' && !vanillaRecolorOn();
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${cloning ? 'Cloning…' : 'Forging…'}`;
                status.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${cloning ? 'Cloning the item…' : 'Forging the final item…'}`;
                fd.append('name', config.name);
                fd.append('itemConfig', JSON.stringify(config));
                const url = cloning ? '/WeaponForge/CloneVanilla'
                    : mode === 'vanilla' ? '/WeaponForge/ForgeVanilla'
                    : mode === 'glb' ? '/WeaponForge/ForgeGlb'
                    : LEGACY[mode].urls.forge;
                const response = await fetch(url, { method: 'POST', body: fd });
                const d = await response.json().catch(() => null);
                if (!response.ok || !d?.ok) {
                    showItemBuildErrors([d?.error || d?.message || (cloning ? 'Clone failed.' : 'Forge failed.'), ...(d?.errors || []), ...(d?.diagnostics || [])]);
                    return;
                }
                // A recolored vanilla item forges from the clone card, which has no lane Name field
                // to write back into — same as a plain clone.
                if (cloning || mode === 'vanilla') { /* no lane name field — the source list is unchanged */ }
                else if (mode === 'glb') document.getElementById('glbName').value = config.name;
                else LEGACY[mode].el('Name').value = config.name;
                closeItemBuild(true);
                if (cloning) {
                    setResult({
                        title: 'Vanilla weapon cloned',
                        kv: {
                            'Item entry': d.itemEntry,
                            'Name': d.name,
                            'Cloned from': `${(vanillaSource && vanillaSource.name) || d.sourceEntry} (${d.sourceEntry})`,
                            'Display': `${d.displayId} (source's own — nothing packaged)`,
                            'Slot': d.inventoryTypeLabel || d.inventoryType,
                            'Add in game': `.additem ${d.itemEntry}`,
                        },
                        diagnostics: [applyLine(d.reloaded, 'Reload', d.reloadMessage || '')],
                        note: d.note,
                    });
                } else {
                    forgeResult(d, mode === 'glb' ? 'GLB forged'
                        : mode === 'vanilla' ? 'Vanilla weapon forged (recolored)'
                        : `${LEGACY[mode].label} weapon forged`);
                }
            } catch (e) {
                showItemBuildErrors([String(e)]);
            } finally {
                itemBuildSubmitting = false;
                modalShell.removeAttribute('aria-busy');
                controls.forEach((control, index) => { control.disabled = previousDisabled[index]; });
                btn.innerHTML = old;
            }
        }

        document.querySelectorAll('[data-build-tab]').forEach(btn => btn.addEventListener('click', () => setItemBuildTab(btn.dataset.buildTab)));
        document.getElementById('ibClose').addEventListener('click', closeItemBuild);
        document.getElementById('ibCancel').addEventListener('click', closeItemBuild);
        document.getElementById('ibBack').addEventListener('click', () => setItemBuildTab(ITEM_BUILD_TABS[Math.max(0, ITEM_BUILD_TABS.indexOf(itemBuildState.tab) - 1)]));
        document.getElementById('ibNext').addEventListener('click', () => setItemBuildTab(ITEM_BUILD_TABS[Math.min(ITEM_BUILD_TABS.length - 1, ITEM_BUILD_TABS.indexOf(itemBuildState.tab) + 1)]));
        document.getElementById('ibSubmit').addEventListener('click', submitItemBuild);
        document.getElementById('ibAddStat').addEventListener('click', () => addItemStat());
        document.getElementById('ibAddEquip').addEventListener('click', () => addItemSpell(1));
        document.getElementById('ibAddSpell').addEventListener('click', () => addItemSpell(0));
        document.getElementById('itemBuildModal').addEventListener('click', e => {
            if (e.target === e.currentTarget) closeItemBuild();
            if (!e.target.closest('.wf-spell-search-wrap')) document.querySelectorAll('.wf-spell-results.open').forEach(x => x.classList.remove('open'));
        });
        document.getElementById('itemBuildModal').addEventListener('input', updateItemBuildReview);
        document.getElementById('itemBuildModal').addEventListener('change', updateItemBuildReview);
        for (const kind of ['class', 'race']) {
            document.querySelector(`[data-mask-all="${kind}"]`).addEventListener('change', e => {
                document.querySelectorAll(`[data-mask="${kind}"]`).forEach(x => x.checked = e.target.checked);
                updateItemBuildReview();
            });
            document.querySelectorAll(`[data-mask="${kind}"]`).forEach(x => x.addEventListener('change', () => {
                const bits = [...document.querySelectorAll(`[data-mask="${kind}"]`)];
                document.querySelector(`[data-mask-all="${kind}"]`).checked = bits.every(b => b.checked);
                updateItemBuildReview();
            }));
        }
        window.addEventListener('keydown', e => {
            const modal = document.getElementById('itemBuildModal');
            if (!modal.classList.contains('open')) return;
            if (itemBuildSubmitting) { e.preventDefault(); return; }
            if (e.key === 'Escape') { closeItemBuild(); return; }
            if (e.key !== 'Tab') return;
            const focusable = [...modal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled])')]
                .filter(x => x.offsetParent !== null);
            if (!focusable.length) return;
            const first = focusable[0], last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });

        // ---------- import actions ----------
        const targetEl = document.getElementById('impTarget');
        const targetVal = document.getElementById('impTargetVal');
        let previewedOnce = false, sliderTimer = null;
        function targetTris() { return +targetEl.value; }
        function importParams(fd) {
            fd.append('weaponType', document.getElementById('impType').value || 'sword1h');
            fd.append('targetTriangles', targetTris());
            fd.append('rollDegrees', +document.getElementById('impRoll').value || 0);
            fd.append('flipGripEnd', document.getElementById('impFlip').checked);
            fd.append('straightenBlade', document.getElementById('impStraighten').checked);
            fd.append('bladeProfile', +document.getElementById('impProfile').value || 0);
            fd.append('brightness', +document.getElementById('impBright').value || 0);
            fd.append('saturation', +document.getElementById('impSat').value || 0);
            // Shape + hand-placement sliders (bind to GlbShapeControls server-side).
            fd.append('flipUpsideDown', document.getElementById('impFlipUp').checked);
            fd.append('mirrorSide', document.getElementById('impMirror').checked);
            fd.append('sizePercent', +document.getElementById('impSize').value || 100);
            fd.append('lengthPercent', +document.getElementById('impLength').value || 100);
            fd.append('widthPercent', +document.getElementById('impWidth').value || 100);
            fd.append('depthPercent', +document.getElementById('impDepth').value || 100);
            fd.append('headPercent', +document.getElementById('impHead').value || 100);
            fd.append('haftPercent', +document.getElementById('impHaft').value || 100);
            fd.append('gripPercent', +document.getElementById('impGrip').value);
            fd.append('offsetUpCm', +document.getElementById('impUp').value || 0);
            fd.append('offsetSideCm', +document.getElementById('impSide').value || 0);
            fd.append('pitchDegrees', +document.getElementById('impPitch').value || 0);
            fd.append('yawDegrees', +document.getElementById('impYaw').value || 0);
            // Enchant-style glow (ItemDisplayInfo field 22). A GLB has nothing to suggest from, so
            // 0 = none is the default; the forge anchors whatever is picked along the imported mesh
            // (and the preview mounts the effect models on those same anchors).
            fd.append('itemVisual', +document.getElementById('impVisual').value || 0);
            fd.append('glowStartPercent', +document.getElementById('impGlowFrom').value);
            fd.append('glowEndPercent', +document.getElementById('impGlowTo').value);
            // Pre-import recolor of the embedded texture — same fields the lanes send; preview and
            // forge share the sha-seeded palette roll so what previews is what bakes.
            if (document.getElementById('impRcOn').checked) {
                appendRecolorPick(fd, document.getElementById('impRcColor').value);
                fd.append('recolorTheory', impRcTheory);
                fd.append('recolorTier', document.getElementById('impRcTier').value || 'improved');
            }
        }
        function schedulePreviewIfLive() {
            // After the first preview, orientation/budget changes re-preview automatically.
            if (!previewedOnce || !document.getElementById('glbFile').files[0]) return;
            clearTimeout(sliderTimer);
            sliderTimer = setTimeout(() => actions.uploadGlb(null), 500);
        }
        targetEl.addEventListener('input', () => {
            targetVal.textContent = targetTris() + ' tris';
            schedulePreviewIfLive();
        });
        document.getElementById('impFlip').addEventListener('change', schedulePreviewIfLive);
        document.getElementById('impStraighten').addEventListener('change', schedulePreviewIfLive);
        document.getElementById('impType').addEventListener('change', schedulePreviewIfLive);
        // The enchant glow now renders in the preview — re-preview when the pick or placement changes.
        document.getElementById('impVisual').addEventListener('change', schedulePreviewIfLive);
        bindGrade('impGlowFrom', 'impGlowFromVal', v => v + '%');
        bindGrade('impGlowTo', 'impGlowToVal', v => v + '%');
        // GLB recolor controls: theory chips + live re-preview, mirroring the import lanes.
        let impRcTheory = 'none';
        {
            const host = document.getElementById('impRcTheories');
            const schedule = () => {
                document.getElementById('impRcStatus').textContent = document.getElementById('impRcOn').checked
                    ? 'Recolor will apply on the next preview.' : 'Recolor off.';
                schedulePreviewIfLive();
            };
            for (const [key, label] of RC_THEORIES) {
                const b = document.createElement('button');
                b.type = 'button'; b.className = 'wf-btn secondary';
                b.style.cssText = 'padding:3px 10px;font-size:12px;';
                b.textContent = label;
                b.title = RC_THEORY_HINTS[key] || '';
                if (key === impRcTheory) b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                b.addEventListener('click', () => {
                    impRcTheory = key;
                    host.querySelectorAll('button').forEach(x => x.style.outline = '');
                    b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                    if (!document.getElementById('impRcOn').checked) document.getElementById('impRcOn').checked = true;
                    schedule();
                });
                host.appendChild(b);
            }
            let impRcColorTimer = null;
            document.getElementById('impRcColor').addEventListener('input', () => {
                if (!document.getElementById('impRcOn').checked) document.getElementById('impRcOn').checked = true;
                clearTimeout(impRcColorTimer); impRcColorTimer = setTimeout(schedule, 200);
            });
            document.getElementById('impRcOn').addEventListener('change', schedule);
            document.getElementById('impRcTier').addEventListener('change', () => { if (document.getElementById('impRcOn').checked) schedule(); });
        }
        function bindGrade(id, valId, fmt) {
            const el = document.getElementById(id), lab = document.getElementById(valId);
            el.addEventListener('input', () => { lab.textContent = fmt(+el.value); schedulePreviewIfLive(); });
        }
        bindGrade('impRoll', 'impRollVal', v => (v > 0 ? '+' : '') + v + '°');
        bindGrade('impProfile', 'impProfileVal', v => v === 0 ? 'off' : v + '%');
        bindGrade('impBright', 'impBrightVal', v => (v > 0 ? '+' : '') + v);
        bindGrade('impSat', 'impSatVal', v => (v > 0 ? '+' : '') + v);
        // Shape + hand-placement sliders.
        bindGrade('impSize', 'impSizeVal', v => v + '%');
        bindGrade('impLength', 'impLengthVal', v => v + '%');
        bindGrade('impWidth', 'impWidthVal', v => v + '%');
        bindGrade('impDepth', 'impDepthVal', v => v + '%');
        bindGrade('impHead', 'impHeadVal', v => v + '%');
        bindGrade('impHaft', 'impHaftVal', v => v + '%');
        bindGrade('impGrip', 'impGripVal', v => v + '%' + (Math.abs(v - donorGripPercent()) < 0.5 ? ' (stock)' : ''));
        bindGrade('impUp', 'impUpVal', v => (v > 0 ? '+' : '') + v + ' cm');
        bindGrade('impSide', 'impSideVal', v => (v > 0 ? '+' : '') + v + ' cm');
        bindGrade('impPitch', 'impPitchVal', v => (v > 0 ? '+' : '') + v + '°');
        bindGrade('impYaw', 'impYawVal', v => (v > 0 ? '+' : '') + v + '°');
        document.getElementById('impFlipUp').addEventListener('change', schedulePreviewIfLive);
        document.getElementById('impMirror').addEventListener('change', schedulePreviewIfLive);
        // Every family gets every control; the only family-specific thing is where the stock hand sits.
        function donorGripPercent() {
            const meta = weaponTypeMeta.get(document.getElementById('impType').value || 'sword1h');
            return Math.round(((meta && meta.ok ? meta.palmBackFraction : 0.188) || 0) * 100);
        }
        function applyImportFamilyControls(resetGrip) {
            if (resetGrip) {
                const g = donorGripPercent();
                document.getElementById('impGrip').value = g;
                document.getElementById('impGripVal').textContent = g + '% (stock)';
            }
        }
        document.getElementById('impType').addEventListener('change', () => applyImportFamilyControls(true));
        document.getElementById('impResetPlacement').addEventListener('click', () => {
            for (const [id, v] of [['impSize', 100], ['impLength', 100], ['impWidth', 100], ['impDepth', 100], ['impHead', 100], ['impHaft', 100], ['impProfile', 0], ['impRoll', 0], ['impUp', 0], ['impSide', 0], ['impPitch', 0], ['impYaw', 0]]) {
                const el = document.getElementById(id); el.value = v; el.dispatchEvent(new Event('input'));
            }
            for (const id of ['impFlip', 'impFlipUp', 'impMirror', 'impStraighten']) document.getElementById(id).checked = false;
            applyImportFamilyControls(true);
            schedulePreviewIfLive();
        });
        // Seed once the family catalog (with stock hand positions) has loaded.
        const seedFamilyControls = setInterval(() => {
            if (weaponTypeMeta.size) { clearInterval(seedFamilyControls); applyImportFamilyControls(true); }
        }, 250);

        const actions = {
            async uploadGlb(btn) {
                const f = document.getElementById('glbFile').files[0];
                if (!f) return setResult({ title: 'No file', error: 'Choose a .glb first.' });
                const fd = new FormData();
                fd.append('file', f);
                importParams(fd);
                const d = await (await fetch('/WeaponForge/UploadGlb', { method: 'POST', body: fd })).json();
                lastGrip = d.grip || null;
                wfGlowWanted = null; // the GLB route has no live glow tint — drop any lane leftover
                if (document.getElementById('impRcOn').checked)
                    document.getElementById('impRcStatus').textContent = d.recolorApplied
                        ? `Recolored at ${Math.round(hexToHue(document.getElementById('impRcColor').value))}° (${impRcTheory}, ${document.getElementById('impRcTier').value}) — will bake on forge.`
                        : 'No recolorable colour families in the embedded texture — showing the original.';
                setResult({
                    title: d.ok ? 'Imported & decimated (preview only)' : 'Import finished with issues',
                    kv: {
                        'Type': d.weaponTypeLabel || d.weaponType || '1H Sword',
                        'Source triangles': (d.originalTriangleCount ?? 0).toLocaleString(),
                        'After decimation': (d.triangleCount ?? 0).toLocaleString() + (d.withinForgeBudget === false ? '  — OVER the 1000 forge ceiling' : ''),
                        'Vertices': (d.vertexCount ?? 0).toLocaleString(),
                        'Texture': d.hasTexture ? 'embedded ✓' : 'MISSING',
                        'Source sha': (d.sourceSha256 || '').slice(0, 12),
                    },
                    diagnostics: [...(d.decimation ? [d.decimation] : []), ...(d.diagnostics || [])],
                    note: [d.grip && d.grip.note, d.note].filter(Boolean).join(' '), error: d.error,
                });
                previewedOnce = true;
                loadGlb(previewUrl(d), 'glb');
            },
            async forgeGlb(btn) {
                const f = document.getElementById('glbFile').files[0];
                if (!f) return setResult({ title: 'No file', error: 'Choose a .glb first.' });
                itemBuildOpen('glb');
            },
            async tbcBrowse(btn) { await laneBrowse(LEGACY.tbc); },
            async tbcPreview(btn) { await lanePreview(LEGACY.tbc); },
            async tbcForge(btn) { laneForge(LEGACY.tbc); },
            async wotlkBrowse(btn) { await laneBrowse(LEGACY.wotlk); },
            async wotlkPreview(btn) { await lanePreview(LEGACY.wotlk); },
            async wotlkForge(btn) { laneForge(LEGACY.wotlk); },
            async vanillaClone(btn) {
                if (!VANILLA.sel) return setResult({ title: 'No weapon selected', error: 'Search and pick a vanilla weapon first.' });
                await itemBuildOpen('vanilla');
            },
            async rebuildPatch(btn) {
                const d = await (await fetch('/WeaponForge/RebuildPatch', { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Rebuild failed', error: d.error });
                setResult({
                    title: 'Patch repackaged',
                    kv: { 'Weapons': d.weaponCount, 'Patch': d.patchRemoved ? 'removed (no weapons in registry)' : 'rebuilt' },
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-4.MPQ', url: d.patchDownloadUrl }] : [],
                    diagnostics: [applyLine(d.patchDeployed || d.patchRemoved, 'Deploy', d.patchDeployMessage || ''), ...(d.diagnostics || [])]
                });
                loadWeapons();
                loadStatus();
            },
        };
        document.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', async () => {
                busy(btn, true);
                try { await actions[btn.dataset.action](btn); }
                catch (e) { setResult({ title: 'Request failed', error: String(e) }); }
                finally { busy(btn, false); }
            });
        });

        // ---------- Later-client import lanes: TBC + WotLK ----------
        // Both lanes are the same UI and the same server contract; only element ids (`${key}Xxx`),
        // endpoint urls and labels differ. The item-build modal receives the lane key as its mode.
        // idPrefix defaults to the key and exists so a lane's element ids can differ from the key it
        // sends to the server. Note mode 'vanilla' is NOT in here: the vanilla card is its own block
        // (clone, or a recolored forge) and is handled before LEGACY[mode] is ever consulted.
        function makeLane(key, label, urls, idPrefix) {
            const ids = idPrefix || key;
            const lane = {
                key, label, urls, idPrefix: ids, sel: null, page: 1, searchTimer: null, previewSerial: 0, previewTimer: null,
                el(suffix) { return document.getElementById(ids + suffix); },
                targetTris() { return +(lane.el('Target')?.value || 0); },
                invalidatePreview() { ++lane.previewSerial; lane.el('ForgeBtn').disabled = true; },
            };
            return lane;
        }
        // Glow controls of a lane → request fields (bind to itemVisual / glowSpread).
        function laneGlowParams(lane, target) {
            const add = (k, v) => target.append(k, v);
            add('itemVisual', +lane.el('Visual').value);
            add('glowSpread', lane.el('GlowSpread').checked);
        }
        function wireLaneGlow(lane) {
            const schedule = () => { if (!lane.sel) return; lane.invalidatePreview(); clearTimeout(lane.previewTimer); lane.previewTimer = setTimeout(() => lanePreview(lane), 450); };
            lane.el('Visual').addEventListener('change', schedule);
            lane.el('GlowSpread').addEventListener('change', schedule);
        }
        // Recolor controls of a lane → request fields (recolorHue/recolorTheory/recolorTier). Used
        // by both the preview (live server-side recolor of the source skin) and the forge (bake).
        function laneRecolorParams(lane, target) {
            if (!lane.el('RcOn').checked) return;
            appendRecolorPick(target, lane.el('RcColor').value);
            target.append('recolorTheory', lane.rcTheory || 'none');
            target.append('recolorTier', lane.el('RcTier').value || 'improved');
        }
        // Imported material effects need a real hue-shifted texture, not material.color
        // multiplication (which cannot turn a green Warglaive reflection into arbitrary hues).
        // The same glowColor now drives the server preview and the forge bake.
        function laneGlowTint(lane) { return lane.el('RcGlowOn').checked ? lane.el('RcGlowColor').value : null; }
        function wireLaneRecolor(lane) {
            lane.rcTheory = 'none';
            const schedule = () => {
                if (!lane.sel) { lane.el('RcStatus').textContent = 'Browse and pick a weapon first.'; return; }
                lane.el('RcStatus').textContent = lane.el('RcOn').checked ? 'Recoloring preview…' : 'Recolor off — previewing the original skin.';
                lane.invalidatePreview();
                clearTimeout(lane.previewTimer);
                lane.previewTimer = setTimeout(() => lanePreview(lane), 350);
            };
            const scheduleEffectTint = () => {
                // The returned GLB already contains hue-shifted effect pixels. Never multiply its
                // material color again: the environment-mapped pass must remain free to animate.
                wfGlowWanted = null;
                wfClearGlow();
                const enabled = lane.el('RcGlowOn').checked;
                lane.el('RcGlowNote').textContent = enabled
                    ? 'Recoloring effect preview…'
                    : 'Recolors compositing effect sheets and rebuilt emitters in preview and forge; movement stays intact.';
                if (!lane.sel) return;
                lane.invalidatePreview();
                clearTimeout(lane.previewTimer);
                lane.previewTimer = setTimeout(() => lanePreview(lane), 220);
            };
            const host = lane.el('RcTheories');
            for (const [key, label] of RC_THEORIES) {
                const b = document.createElement('button');
                b.type = 'button'; b.className = 'wf-btn secondary'; b.dataset.theory = key;
                b.style.cssText = 'padding:3px 10px;font-size:12px;';
                b.textContent = label;
                b.title = RC_THEORY_HINTS[key] || '';
                if (key === lane.rcTheory) b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                b.addEventListener('click', () => {
                    lane.rcTheory = key;
                    host.querySelectorAll('button').forEach(x => x.style.outline = '');
                    b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                    if (!lane.el('RcOn').checked) lane.el('RcOn').checked = true;
                    schedule();
                });
                host.appendChild(b);
            }
            let colorTimer = null;
            lane.el('RcColor').addEventListener('input', () => {
                if (!lane.el('RcOn').checked) lane.el('RcOn').checked = true;
                clearTimeout(colorTimer); colorTimer = setTimeout(schedule, 200);
            });
            lane.el('RcOn').addEventListener('change', schedule);
            lane.el('RcTier').addEventListener('change', () => { if (lane.el('RcOn').checked) schedule(); });
            lane.el('RcDetect').addEventListener('click', async () => {
                if (!lane.sel) { lane.el('RcStatus').textContent = 'Browse and pick a weapon first.'; return; }
                lane.el('RcStatus').textContent = 'Detecting primary colour…';
                try {
                    const q = new URLSearchParams({ expansion: lane.key, entry: lane.sel.entry, model: lane.sel.model, displayRow: lane.sel.displayRow });
                    const d = await (await fetch('/WeaponForge/PrimaryColor?' + q)).json();
                    if (d.success && d.primaryHex) {
                        lane.el('RcColor').value = d.primaryHex;
                        if (lane.el('RcOn').checked) schedule();
                        else lane.el('RcStatus').textContent = 'Primary colour loaded — tick "recolor skin" or pick a theory to recolor.';
                    } else lane.el('RcStatus').textContent = d.error || 'Could not detect a primary colour.';
                } catch (e) { lane.el('RcStatus').textContent = 'Detect failed: ' + e; }
            });
            lane.el('RcGlowOn').addEventListener('change', scheduleEffectTint);
            lane.el('RcGlowColor').addEventListener('input', () => {
                if (!lane.el('RcGlowOn').checked) lane.el('RcGlowOn').checked = true;
                scheduleEffectTint();
            });
        }
        async function loadItemVisuals() {
            try {
                const d = await (await fetch('/WeaponForge/ItemVisuals')).json();
                if (!d.ok) return;
                const selects = [...LEGACY_LANES.map(lane => lane.el('Visual')), document.getElementById('impVisual')];
                for (const sel of selects) {
                    if (!sel) continue;
                    for (const v of d.visuals) {
                        const o = document.createElement('option');
                        o.value = v.id; o.textContent = `${v.label} (#${v.id})`;
                        if (v.effects && v.effects.length) o.title = v.effects.join(' + ');
                        sel.appendChild(o);
                    }
                }
            } catch (e) { console.warn('ItemVisuals unavailable', e); }
        }
        const LEGACY = {
            tbc: makeLane('tbc', 'TBC', {
                status: '/WeaponForge/TbcStatus', weapons: '/WeaponForge/TbcWeapons',
                preview: '/WeaponForge/TbcPreviewWeapon', forge: '/WeaponForge/ForgeTbc' }),
            wotlk: makeLane('wotlk', 'WotLK', {
                status: '/WeaponForge/WotlkStatus', weapons: '/WeaponForge/WotlkWeapons',
                preview: '/WeaponForge/WotlkPreviewWeapon', forge: '/WeaponForge/ForgeWotlk' }),
        };
        const LEGACY_LANES = [LEGACY.tbc, LEGACY.wotlk];

        // ---------- vanilla clone lane ----------
        // Deliberately NOT a makeLane(): that abstraction is built around a mounted client archive
        // (status probe, paged MPQ browse, mesh preview, triangle budget, glow and recolor bakes).
        // The vanilla lane reads the live world DB; a pure clone packages nothing, while an art edit
        // packages a source-preserved M2 plus private BLPs. It still gets its own small block rather
        // than a lane object with most import-only fields unused.
        const VANILLA = { sel: null, searchTimer: null, rows: [], previewSerial: 0, searchSerial: 0, seeded: false, seedInFlight: false };

        // Recolor on the clone card. Ticking either box promotes the clone into a real forge: a
        // recolored weapon needs its OWN display, texture and model, which is exactly what a clone
        // does not have. The submit path routes on this, and the readout says which one you will get.
        function vanillaRecolorOn() {
            return document.getElementById('vanillaRcOn').checked
                || document.getElementById('vanillaRcGlowOn').checked;
        }
        function vanillaRecolorNote() {
            const skin = document.getElementById('vanillaRcOn').checked;
            const glow = document.getElementById('vanillaRcGlowOn').checked;
            document.getElementById('vanillaRcStatus').textContent = glow && skin
                ? 'Skin + native effects on — private effect sheets and in-place hue shifts; the original animated graph is preserved (client restart needed).'
                : glow
                    ? 'Native effect recolor on — private effect sheets and hue-shifted color values; timing and animation tracks stay live.'
                    : skin
                    ? 'Skin recolor on — new display/BLP, original animated M2 preserved byte-for-byte (client restart needed).'
                    : 'Both off — pure clone, nothing packaged.';
        }
        function wireVanillaRecolor() {
            const host = document.getElementById('vanillaRcTheories');
            let theory = 'none';
            for (const [key, label] of RC_THEORIES) {
                const b = document.createElement('button');
                b.type = 'button'; b.className = 'wf-btn secondary'; b.dataset.theory = key;
                b.style.cssText = 'padding:3px 10px;font-size:12px;';
                b.textContent = label;
                b.title = RC_THEORY_HINTS[key] || '';
                if (key === theory) b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                b.addEventListener('click', () => {
                    theory = key;
                    host.querySelectorAll('button').forEach(x => x.style.outline = '');
                    b.style.outline = '2px solid var(--accent-color, #3b6fd4)';
                    const on = document.getElementById('vanillaRcOn');
                    if (!on.checked) on.checked = true;
                    if (VANILLA.repreview) VANILLA.repreview();
                });
                host.appendChild(b);
            }
            VANILLA.rcTheory = () => theory;
            let rcTimer = null;
            const repreview = () => {
                vanillaRecolorNote();
                if (!VANILLA.sel) return;
                clearTimeout(rcTimer);
                rcTimer = setTimeout(() => vanillaPreview(VANILLA.sel), 300);
            };
            VANILLA.repreview = repreview;
            for (const id of ['vanillaRcOn', 'vanillaRcColor', 'vanillaRcTier', 'vanillaRcGlowOn', 'vanillaRcGlowColor'])
                document.getElementById(id).addEventListener(id.endsWith('Color') ? 'input' : 'change', repreview);
            vanillaRecolorNote();
        }

        function vanillaSetSelection(w) {
            VANILLA.sel = w;
            document.getElementById('vanillaSelected').value = w
                ? `${w.name} — ${w.familyLabel}, ${w.inventoryTypeLabel} (item ${w.entry}, display ${w.displayId})`
                : '';
            document.getElementById('vanillaCloneBtn').disabled = !w;
            document.querySelectorAll('#vanillaResults tr[data-entry]').forEach(tr =>
                tr.classList.toggle('sel', !!(w && +tr.dataset.entry === +w.entry)));
            if (w) vanillaPreview(w);
            else { ++VANILLA.previewSerial; clearViewerOwnedBy('vanilla'); }
        }

        // Selecting a row previews the source's own display straight away — exactly what selectLane()
        // does for the import lanes. There is no re-emitted mesh here to differ from the source, so
        // this preview IS the cloned item: same display, same model, same texture, same enchant glow.
        // /WeaponForge/VanillaPreview hands back the on-demand item-GLB cache path, which comes out of
        // the same GlbWriter as every other preview on this page, so loadGlb's blend-suffix, env-map,
        // m2fx and item-rig passes all apply unchanged.
        async function vanillaPreview(w) {
            const serial = ++VANILLA.previewSerial;
            // Every bail-out below clears the lane's own model. vanillaSetSelection has ALREADY moved
            // the readout, the Configure button and the row highlight to `w`, so leaving the previous
            // weapon on screen puts the viewer and the selection in disagreement — which is exactly the
            // state this preview was added to remove.
            if (!w || !w.displayId) { clearViewerOwnedBy('vanilla'); return; }
            lastGrip = null;        // a stock display carries no forge grip payload
            // Vanilla native effects are recolored in their actual texture/track data. Do not also
            // multiply material.color every frame: that was freezing the M2's animated colour track
            // and could turn a coloured effect sheet black.
            wfGlowWanted = null;
            wfClearGlow();
            try {
                // Any Vanilla art edit keeps the source M2 graph. Skin swaps the Type-2 display
                // texture; native-effect tinting uses private Type-0 sheets and in-place hue shifts.
                let url;
                if (vanillaRecolorOn() && w.entry) {
                    const q = new URLSearchParams({
                        entry: w.entry,
                        weaponType: w.family || '',
                    });
                    if (document.getElementById('vanillaRcOn').checked) {
                        appendRecolorPick(q, document.getElementById('vanillaRcColor').value);
                        q.append('recolorTheory', (VANILLA.rcTheory && VANILLA.rcTheory()) || 'none');
                        q.append('recolorTier', document.getElementById('vanillaRcTier').value || 'improved');
                    }
                    if (document.getElementById('vanillaRcGlowOn').checked)
                        q.append('glowColor', document.getElementById('vanillaRcGlowColor').value);
                    url = '/WeaponForge/VanillaPreviewWeapon?' + q.toString();
                } else {
                    url = '/WeaponForge/VanillaPreview?displayId=' + encodeURIComponent(w.displayId);
                }
                const d = await (await fetch(url)).json();
                if (serial !== VANILLA.previewSerial) return;   // a newer selection already won
                // ok:false is an EXPECTED outcome (quivers, ammo pouches, a few off-hand tomes have no
                // ObjectComponents M2), not just an error path — so it has to empty the viewer too.
                if (!d.ok) { clearViewerOwnedBy('vanilla'); return setResult({ title: `No preview for ${w.name}`, error: d.error }); }
                loadGlb(previewUrl(d), 'vanilla');
                setResult({
                    title: `Previewing ${w.name}`,
                    kv: {
                        'Source item': w.entry,
                        'Display': vanillaRecolorOn()
                            ? `${w.displayId} source (forge creates a new display)`
                            : `${w.displayId} (the clone keeps it)`,
                        'Type': w.familyLabel || '—',
                        'Equip slot': w.inventoryTypeLabel || '—',
                        'Enchant glow': d.itemVisual ? `ItemVisual ${d.itemVisual}` : 'none',
                        'Native effects': document.getElementById('vanillaRcGlowOn').checked
                            ? `${d.nativeEffectTexturesRecolored || 0} private texture(s), ${d.nativeColorTracksRecolored || 0} material track(s), ${d.nativeEmittersRecolored || 0} emitter(s)`
                            : 'stock',
                    },
                    note: vanillaRecolorOn()
                        ? (document.getElementById('vanillaRcGlowOn').checked
                            ? (d.note || 'The stock animation/render graph stays alive, changed Type-0 sheets become private to this weapon, and shared ItemVisual / Type-3 effects remain stock.')
                            : 'The recolored preview uses the original stock M2, not a rigid rebuild. Forge packages that exact M2 plus the new Type-2 skin.')
                        : 'This is the finished look — a clone packages no art, so nothing about the model changes. "Configure item…" sets the name, quality, damage, stats and effects of the new item.',
                });
            } catch (e) {
                if (serial !== VANILLA.previewSerial) return;
                clearViewerOwnedBy('vanilla');
                setResult({ title: 'Preview failed', error: String(e) });
            }
        }

        // isError styles the empty state as a failure rather than "nothing matched" — a dead world DB
        // used to read as "No vanilla weapons matched.", the same sentence as a bad search term.
        function vanillaRenderResults(rows, note, isError) {
            const host = document.getElementById('vanillaResults');
            // Remember the picked entry across a re-render. The list repaints on every (debounced)
            // keystroke and on every family change, and clearing the selection unconditionally meant
            // one more character after picking a weapon silently greyed out Configure — and now that
            // selection drives the preview, emptied the viewer with it.
            const keep = VANILLA.sel && VANILLA.sel.entry;
            VANILLA.rows = rows || [];
            if (!VANILLA.rows.length) {
                if (keep) vanillaClearSelection();
                const colour = isError ? '#b42318' : 'var(--text-muted)';
                host.innerHTML = `<div style="padding:14px;color:${colour};font-size:12px;">${esc(note || 'No vanilla weapons matched.')}</div>`;
                return;
            }
            let html = '<table><tr><th>Name</th><th>ilvl</th><th>Family</th><th>Slot</th><th>DPS</th><th>ID</th></tr>';
            for (const w of VANILLA.rows) {
                // Shields have no damage or delay, so no dps line — the same shape the item modal uses.
                const dps = w.delayMs > 0 && w.damageMax > 0
                    ? (((w.damageMin + w.damageMax) / 2) / (w.delayMs / 1000)).toFixed(1)
                    : '—';
                const col = QUALITY_COLORS[w.quality] || QUALITY_COLORS[1];
                html += `<tr data-entry="${w.entry}" title="display ${w.displayId}">` +
                        `<td style="color:${col};font-weight:600;">${esc(w.name)}</td>` +
                        `<td class="muted">${w.itemLevel || '—'}</td>` +
                        `<td class="muted">${esc(w.familyLabel || '—')}</td>` +
                        `<td class="muted">${esc(w.inventoryTypeLabel || '—')}</td>` +
                        `<td class="muted">${dps}</td><td class="muted">${w.entry}</td></tr>`;
            }
            host.innerHTML = html + '</table>';
            host.querySelectorAll('tr[data-entry]').forEach(tr => tr.addEventListener('click', () =>
                vanillaSetSelection(VANILLA.rows.find(x => +x.entry === +tr.dataset.entry) || null)));
            // Re-assert the previous pick AFTER the rows exist, so the highlight lands on live nodes.
            // Done silently: it is the same weapon already in the viewer, so it needs no re-preview.
            const survivor = keep ? VANILLA.rows.find(x => +x.entry === +keep) : null;
            if (survivor) {
                VANILLA.sel = survivor;
                host.querySelectorAll('tr[data-entry]').forEach(tr =>
                    tr.classList.toggle('sel', +tr.dataset.entry === +survivor.entry));
            } else if (keep) {
                vanillaClearSelection();
            }
        }

        // Drop the selection and everything downstream of it: the readout, the Configure button and
        // the viewer (which would otherwise keep showing a weapon that is no longer in the list).
        function vanillaClearSelection() {
            VANILLA.sel = null;
            document.getElementById('vanillaSelected').value = '';
            document.getElementById('vanillaCloneBtn').disabled = true;
            ++VANILLA.previewSerial;
            // Ownership, not merely "this lane had a selection": the operator may have previewed a TBC
            // weapon since, and an empty vanilla search must not blank that.
            clearViewerOwnedBy('vanilla');
        }

        async function vanillaSearch() {
            const host = document.getElementById('vanillaResults');
            // Request serial, the same guard previewSerial gives the preview: the 350 ms debounce
            // coalesces keystrokes but cannot cancel a request already in flight, so a slow "thunder"
            // resolving after a fast "thunderfury" repainted the older, wider list over the newer one.
            const serial = ++VANILLA.searchSerial;
            const q = new URLSearchParams({
                search: document.getElementById('vanillaSearch').value.trim(),
                family: document.getElementById('vanillaFamily').value || '',
                limit: 60,
            });
            host.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">Searching…</div>';
            try {
                const response = await fetch('/WeaponForge/VanillaWeapons?' + q);
                const d = await response.json().catch(() => null);
                if (serial !== VANILLA.searchSerial) return;
                if (!response.ok || !d || !d.ok) {
                    const msg = (d && d.error) || `Vanilla browse failed (HTTP ${response.status}).`;
                    vanillaRenderResults([], msg, true);
                    return vanillaSetState(null, msg);
                }
                VANILLA.seeded = true;   // a real payload arrived; the lazy seed is done
                vanillaRenderResults(d.weapons || [], 'No vanilla weapons matched.');
                vanillaSetState(d);
            } catch (e) {
                if (serial !== VANILLA.searchSerial) return;
                vanillaRenderResults([], 'Vanilla browse failed: ' + e, true);
                vanillaSetState(null, String(e));
            }
        }

        // #vanillaState was a dead id nothing ever wrote — the card's static blurb sat there whether the
        // world DB answered or not. Give it the lane's real state, as the import lanes' status lines do
        // for their archives.
        function vanillaSetState(d, error) {
            const el = document.getElementById('vanillaState');
            if (!el) return;
            if (error || !d) {
                el.textContent = 'The vanilla clone lane reads the live world database, which is not answering: ' + (error || 'unknown error');
                el.style.color = '#b42318';
                return;
            }
            el.style.color = '';
            el.textContent = (d.total || 0).toLocaleString() + ' stock weapon(s) and shield(s) match. A clone reuses the '
                + 'source\u2019s own display \u2014 model, texture, icon, sheath, grip and sound are already in your client '
                + '\u2014 so nothing is packaged: no patch, no download, no client restart. Usable via .additem as soon as '
                + 'the core reloads.';
        }

        // Seeded on FIRST USE, not at page load: this is a live world-DB query and the card ships
        // collapsed, so a bootstrap call would hit MySQL for a card nobody opened. Without it the list
        // sat on "Search to browse vanilla weapons." until something was typed.
        function seedVanillaLane() {
            // VANILLA.seeded is set by vanillaSearch only on a SUCCESSFUL payload, so a first open that
            // hits a dead world DB can be retried simply by closing and reopening the card. inFlight
            // stops the focus and header-click triggers from firing two browses at once.
            if (VANILLA.seeded || VANILLA.seedInFlight) return;
            VANILLA.seedInFlight = true;
            vanillaSearch().finally(() => { VANILLA.seedInFlight = false; });
        }

        // The family filter lists only the families the catalog knows. A clone needs no donor
        // scaffold, so the browse also returns the subclasses the import lanes decline (fist
        // weapons, spears, fishing poles) — they are reachable through "All families".
        function vanillaFillFamilies() {
            const sel = document.getElementById('vanillaFamily');
            if (sel.options.length > 1 || !weaponTypeMeta.size) return;
            for (const [key, meta] of weaponTypeMeta) sel.add(new Option(meta.label || key, key));
        }

        document.getElementById('vanillaSearch').addEventListener('input', () => {
            clearTimeout(VANILLA.searchTimer);
            VANILLA.searchTimer = setTimeout(vanillaSearch, 350);
        });
        document.getElementById('vanillaSearch').addEventListener('focus', seedVanillaLane);
        document.getElementById('vanillaFamily').addEventListener('change', vanillaSearch);
        const seedVanillaFamilies = setInterval(() => {
            if (weaponTypeMeta.size) { clearInterval(seedVanillaFamilies); vanillaFillFamilies(); }
        }, 250);

        function wireLane(lane) {
            lane.el('Target').addEventListener('input', () => {
                lane.el('TargetVal').textContent = lane.targetTris() === 0 ? 'exact source' : lane.targetTris() + ' tris';
                if (lane.sel) {
                    lane.invalidatePreview();
                    clearTimeout(lane.previewTimer);
                    lane.previewTimer = setTimeout(() => lanePreview(lane), 500);
                }
            });
            lane.el('Type').addEventListener('change', () => {
                if (!lane.sel) return;
                lane.invalidatePreview();
                lanePreview(lane);
            });
            lane.el('ModalClose').addEventListener('click', () => lane.el('Modal').classList.remove('open'));
            lane.el('Modal').addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.classList.remove('open'); });
            lane.el('Prev').addEventListener('click', () => loadLanePage(lane, lane.page - 1));
            lane.el('Next').addEventListener('click', () => loadLanePage(lane, lane.page + 1));
            lane.el('Search').addEventListener('input', () => {
                clearTimeout(lane.searchTimer);
                lane.searchTimer = setTimeout(() => loadLanePage(lane, 1), 350);
            });
            wireLaneGlow(lane);
            wireLaneRecolor(lane);
        }

        async function loadLaneStatus(lane) {
            const el = lane.el('State');
            try {
                const s = await (await fetch(lane.urls.status)).json();
                if (!s.configured) {
                    el.innerHTML = `No ${lane.label} Data path configured — set <b>${lane.label} Client Data Path</b> on the Settings page.`;
                    return;
                }
                if (s.error) { el.innerHTML = `<span style="color:#b42318;">${lane.label} mount problem: ${esc(s.error)}</span>`; return; }
                el.innerHTML = `Mounted <b>${s.archiveCount}</b> archive(s) from <code>${esc(s.path)}</code> — ` +
                               (s.itemCount > 0
                                   ? `<b>${s.itemCount.toLocaleString()}</b> named ${lane.label} weapons browsable ` +
                                     `(${s.weaponCount.toLocaleString()} models).`
                                   : `<b>${s.weaponCount.toLocaleString()}</b> weapon models browsable (no item-name catalog).`);
                lane.el('BrowseBtn').disabled = !(s.weaponCount > 0);
            } catch (e) { el.textContent = `${lane.label} status unavailable: ` + e; }
        }

        // WoW quality colors (0 poor … 6 artifact).
        // Common is white in-game; on the site's themed card background that is invisible, so it follows the text color.
        const QUALITY_COLORS = ['#9d9d9d', 'var(--text-primary)', '#1eff00', '#0070dd', '#a335ee', '#ff8000', '#e6cc80'];

        async function loadLanePage(lane, page) {
            lane.page = page;
            const list = lane.el('List');
            list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">Loading…</div>';
            const q = new URLSearchParams({ page, search: lane.el('Search').value.trim() });
            try {
                const d = await (await fetch(lane.urls.weapons + '?' + q)).json();
                if (!d.ok) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(d.error || 'failed')}</div>`; return; }
                if (!d.weapons.length) { list.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px;">No matches.</div>'; }
                else {
                    const itemMode = d.mode === 'items';
                    let html = itemMode
                        ? '<table><tr><th>Name</th><th>ilvl</th><th>Type</th><th>Slot</th><th>Model</th><th>ID</th></tr>'
                        : '<table><tr><th>Model</th><th>Texture</th><th>Row</th></tr>';
                    for (const w of d.weapons) {
                        const attrs = `data-entry="${w.entry || 0}" data-model="${esc(w.model)}" data-row="${w.displayRow}"` +
                                      ` data-type="${esc(w.typeKey || '')}" data-name="${esc(w.name)}"` +
                                      ` data-inventory-type="${w.inventoryType ?? ''}" data-slot-label="${esc(w.inventoryTypeLabel || '')}"`;
                        if (itemMode) {
                            const col = QUALITY_COLORS[w.quality] || QUALITY_COLORS[1];
                            html += `<tr ${attrs}><td style="color:${col};font-weight:600;">${esc(w.name)}</td>` +
                                    `<td class="muted">${w.itemLevel || '—'}</td><td class="muted">${esc(w.typeLabel || '—')}</td>` +
                                    `<td class="muted">${esc(w.inventoryTypeLabel || '—')}</td>` +
                                    `<td class="muted">${esc(w.model)}</td><td class="muted">${w.entry}</td></tr>`;
                        } else {
                            html += `<tr ${attrs}><td>${esc(w.model)}</td><td class="muted">${esc(w.texture)}</td>` +
                                    `<td class="muted">${w.displayRow}</td></tr>`;
                        }
                    }
                    list.innerHTML = html + '</table>';
                    list.querySelectorAll('tr[data-model]').forEach(tr => tr.addEventListener('click', () => selectLane(lane, tr)));
                }
                lane.el('PageInfo').textContent = `${d.total.toLocaleString()} weapon(s) — page ${d.page}/${d.pages}`;
                lane.el('Prev').disabled = d.page <= 1;
                lane.el('Next').disabled = d.page >= d.pages;
                lane.page = d.page;
            } catch (e) { list.innerHTML = `<div style="padding:14px;font-size:12px;color:#b42318;">${esc(String(e))}</div>`; }
        }

        function selectLane(lane, tr) {
            lane.sel = {
                entry: +tr.dataset.entry || 0,
                model: tr.dataset.model,
                displayRow: +tr.dataset.row,
                name: tr.dataset.name || tr.dataset.model,
                typeKey: tr.dataset.type || '',
                inventoryType: +(tr.dataset.inventoryType || 0),
                inventoryTypeLabel: tr.dataset.slotLabel || '',
            };
            lane.el('Selected').value =
                lane.sel.entry
                    ? `${lane.sel.name} — ${lane.sel.inventoryTypeLabel || 'unknown slot'} (item ${lane.sel.entry})`
                    : `${lane.sel.model} (row ${lane.sel.displayRow})`;
            // Pre-select the family from the source subclass; the name field defaults to the item name.
            const typeSel = lane.el('Type');
            if (lane.sel.typeKey && [...typeSel.options].some(o => o.value === lane.sel.typeKey && !o.disabled))
                typeSel.value = lane.sel.typeKey;
            lane.el('Name').placeholder = lane.sel.name;
            lane.el('PreviewBtn').disabled = false;
            lane.el('Visual').value = '-1';
            lane.invalidatePreview();
            lane.el('Modal').classList.remove('open');
            lanePreview(lane);
        }

        async function laneBrowse(lane) {
            lane.el('Modal').classList.add('open');
            lane.el('Search').focus();
            await loadLanePage(lane, 1);
        }

        async function lanePreview(lane) {
            if (!lane.sel) return setResult({ title: `No ${lane.label} weapon selected`, error: 'Browse and pick one first.' });
            const requestId = ++lane.previewSerial;
            const selected = { ...lane.sel };
            const weaponType = lane.el('Type').value || 'sword1h';
            const targetTriangles = lane.targetTris();
            const configureButton = lane.el('ForgeBtn');
            configureButton.disabled = true;
            const q = new URLSearchParams({
                entry: selected.entry, model: selected.model, displayRow: selected.displayRow,
                weaponType,
                targetTriangles,
            });
            laneGlowParams(lane, q);
            laneRecolorParams(lane, q);
            const effectTint = laneGlowTint(lane);
            if (effectTint) q.append('glowColor', effectTint);
            // The server hue-shifts the actual effect sheet and emitter color. A second client-side
            // material multiplier would distort the requested hue and can blacken a colored matcap.
            wfGlowWanted = null;
            wfClearGlow();
            let d;
            try {
                const response = await fetch(lane.urls.preview + '?' + q);
                d = await response.json();
                if (!response.ok) throw new Error(d.error || `${lane.label} preview failed.`);
            } catch (error) {
                if (requestId !== lane.previewSerial) return;
                configureButton.disabled = true;
                setResult({ title: `${lane.label} preview failed`, error: String(error) });
                return;
            }
            if (requestId !== lane.previewSerial) return;
            lastGrip = d.grip || null;
            configureButton.disabled = !d.ok || d.withinForgeBudget === false;
            if (lane.el('RcOn').checked)
                lane.el('RcStatus').textContent = d.recolorApplied
                    ? `Recolored at ${Math.round(hexToHue(lane.el('RcColor').value))}° (${lane.rcTheory}, ${lane.el('RcTier').value}) — will bake on forge.`
                    : 'No recolorable colour families on this skin — previewing the original.';
            if (lane.el('RcGlowOn').checked) {
                const sheets = Number(d.effectTexturesRecolored || 0);
                const emitters = Number(d.effectEmittersRecolored || 0);
                lane.el('RcGlowNote').textContent = sheets || emitters
                    ? `${sheets} compositing effect sheet(s) and ${emitters} rebuilt emitter(s) recolored — the forge uses the same bake.`
                    : 'This model has no safely isolated compositing effect sheet or rebuildable emitter; its separate ItemVisual stays stock.';
            }
            const p = d.particles || {};
            const sug = d.suggestedItemVisual;
            const autoOpt = lane.el('Visual').querySelector('option[value="-1"]');
            if (autoOpt) autoOpt.textContent = sug && sug.id ? `Auto — ${sug.label} (#${sug.id})` : 'Auto (this model has no glow → none)';
            // Two possible glow sources, reported separately so it is obvious which one this weapon
            // actually uses: the display row's own ItemVisual (the common case), or model emitters.
            const parts = [];
            if (p.sourceVisual) {
                parts.push(`The source display row carries <b>ItemVisual ${p.sourceVisual.id}</b>` +
                    (p.sourceVisual.effects && p.sourceVisual.effects.length ? ` (${esc(p.sourceVisual.effects.join(' + '))})` : '') +
                    ` \u2192 <b>${esc(p.sourceVisual.mappedLabel || 'no 1.12 equivalent')}</b>` +
                    (p.sourceVisual.reason ? ` \u2014 ${esc(p.sourceVisual.reason)}` : '') + '.');
            }
            if (p.count) {
                parts.push(`Model has <b>${p.count}</b> particle emitter(s)${p.textures && p.textures.length ? ' \u2014 ' + esc(p.textures.join(', ')) : ''}` +
                    (p.colours && p.colours.length ? ' ' + p.colours.map(c => `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${esc(c)};border:1px solid #0006;vertical-align:middle;"></span>`).join('') : '') +
                    (p.emitterSuggested ? `, nearest vanilla: <b>${esc(p.emitterSuggested.label)}</b>` : '') + '.');
            }
            if (!parts.length) parts.push('This model has no glow of its own \u2014 no ItemVisual on its display row, no particle emitters. Pick one anyway if you want one.');
            // Where the glow will hang. Vanilla fills all five anchor slots, so a clustered source
            // set is the difference between an enchant along the weapon and a lump on the blade.
            if (p.anchorsSpread) parts.push('Anchors spread evenly hilt-to-tip.');
            else if (p.anchorSpanPercent != null && p.anchorSpanPercent < 25)
                parts.push(`The source's glow anchors span only <b>${p.anchorSpanPercent}%</b> of the weapon \u2014 tick <b>spread glow along weapon</b> for the hilt-to-tip look.`);
            parts.push(`Forging with: <b>${esc(p.chosen ? p.chosen.label : 'none')}</b>. Glows render in-game only.`);
            lane.el('VisualNote').innerHTML = parts.join(' ');
            setResult({
                title: d.ok ? `${lane.label} preview — ${d.itemName || selected.name}` : `${lane.label} preview failed`,
                kv: d.ok ? {
                    'Type': d.weaponTypeLabel || '1H Sword',
                    'Equip slot': d.inventoryTypeLabel || (d.inventoryType != null ? `Inventory type ${d.inventoryType}` : '—'),
                    'Model': d.model,
                    'Triangles': (d.triangleCount ?? 0).toLocaleString() +
                        (d.withinForgeBudget === false ? ' — OVER vanilla UInt16 limit' : ''),
                    'Vertices': (d.vertexCount ?? 0).toLocaleString(),
                    'Texture': d.hasTexture ? d.texture : 'MISSING — fidelity import stopped',
                    'Glow': p.chosen ? p.chosen.label + (sug && sug.id === (p.chosen.id|0) ? ' (suggested)' : '') : 'none',
                } : undefined,
                diagnostics: d.diagnostics, note: d.grip && d.grip.note, error: d.error,
            });
            loadGlb(previewUrl(d), lane.idPrefix);
        }

        function laneForge(lane) {
            if (!lane.sel) return setResult({ title: `No ${lane.label} weapon selected`, error: 'Browse and pick one first.' });
            itemBuildOpen(lane.idPrefix);
        }

        LEGACY_LANES.forEach(wireLane);
        wireVanillaRecolor();

        // ---------- forged weapons registry ----------
        async function loadWeapons() {
            const host = document.getElementById('wfWeapons');
            try {
                const d = await (await fetch('/WeaponForge/ListWeapons')).json();
                if (!d.ok) { host.innerHTML = `<span class="empty">Could not load: ${esc(d.error || 'unknown')}</span>`; return; }
                if (!d.weapons.length) { host.innerHTML = '<span class="empty">Nothing forged yet.</span>'; return; }
                let html = '<table><tr><th class="sel"><input type="checkbox" id="wfSelAll" title="Select all"></th><th>Name</th><th>Type</th><th>Slot</th><th>Entry</th><th>Display</th><th>Source</th><th>Created</th><th></th></tr>';
                for (const w of d.weapons) {
                    html += `<tr><td class="sel"><input type="checkbox" class="wf-sel" data-sel="${w.displayId}" data-name="${esc(w.name)}"></td><td>${esc(w.name)}</td><td class="muted">${esc(w.weaponTypeLabel || '—')}</td>` +
                            `<td class="muted">${esc(w.inventoryTypeLabel || (w.inventoryType != null ? `Inventory type ${w.inventoryType}` : '—'))}</td>` +
                            `<td class="muted">${w.itemEntry || '—'}</td>` +
                            `<td class="muted">${w.displayId}</td><td class="muted">${esc(w.sourceKind)}</td>` +
                            `<td class="muted">${esc(w.createdAt)}</td>` +
                            `<td style="white-space:nowrap;"><button class="wf-del" data-view="${w.displayId}" data-name="${esc(w.name)}" style="background:var(--bg-input,#1c2029);color:var(--text-primary);border-color:var(--border-color);margin-right:5px;">View</button>` +
                            `<button class="wf-del" data-del="${w.displayId}" data-name="${esc(w.name)}">Delete</button></td></tr>`;
                }
                host.innerHTML = html + '</table>';
                host.querySelectorAll('[data-del]').forEach(btn => btn.addEventListener('click', () => deleteWeapon(btn)));
                host.querySelectorAll('[data-view]').forEach(btn => btn.addEventListener('click', () => viewForged(btn)));
                wireSelection(host);
            } catch (e) { host.innerHTML = `<span class="empty">Could not load: ${esc(e)}</span>`; }
            updateSelection();
        }

        // ---------- multi-select delete ----------
        function selectedWeapons() {
            return [...document.querySelectorAll('#wfWeapons .wf-sel:checked')].map(cb => ({ id: +cb.dataset.sel, name: cb.dataset.name }));
        }
        function updateSelection() {
            const sel = selectedWeapons();
            const all = document.querySelectorAll('#wfWeapons .wf-sel');
            const btn = document.getElementById('wfDeleteSelected');
            btn.disabled = sel.length === 0;
            btn.textContent = sel.length ? `Delete selected (${sel.length})` : 'Delete selected';
            const head = document.getElementById('wfSelAll');
            if (head) { head.checked = all.length > 0 && sel.length === all.length; head.indeterminate = sel.length > 0 && sel.length < all.length; }
            all.forEach(cb => cb.closest('tr').classList.toggle('selected', cb.checked));
        }
        function wireSelection(host) {
            host.querySelectorAll('.wf-sel').forEach(cb => cb.addEventListener('change', updateSelection));
            const head = host.querySelector('#wfSelAll');
            if (head) head.addEventListener('change', () => { host.querySelectorAll('.wf-sel').forEach(cb => { cb.checked = head.checked; }); updateSelection(); });
        }
        document.getElementById('wfDeleteSelected').addEventListener('click', async () => {
            const sel = selectedWeapons();
            if (!sel.length) return;
            const names = sel.slice(0, 8).map(w => `• ${w.name}`).join('\n') + (sel.length > 8 ? `\n• …and ${sel.length - 8} more` : '');
            if (!confirm(`Delete ${sel.length} weapon${sel.length === 1 ? '' : 's'}?\n\n${names}\n\nRemoves them from the world database and the registry; the client patch rebuild is queued once for the whole batch. IDs return to the pool.`)) return;
            const btn = document.getElementById('wfDeleteSelected');
            busy(btn, true);
            try {
                const d = await (await fetch('/WeaponForge/DeleteWeapons', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ displayIds: sel.map(w => w.id) }),
                })).json();
                if (!d.ok) return setResult({ title: 'Delete failed', error: d.error });
                const failed = d.failed || [];
                setResult({
                    title: failed.length ? `Deleted ${d.deleted.length} of ${sel.length} weapons` : `Deleted ${d.deleted.length} weapon${d.deleted.length === 1 ? '' : 's'} everywhere`,
                    kv: { 'Weapons remaining': d.weaponsRemaining, 'Patch': d.patchQueued ? 'rebuild queued' : d.patchRemoved ? 'removed' : 'repackaged' },
                    diagnostics: [
                        ...d.deleted.map(w => `✓ Deleted: ${w.name} (entry ${w.itemEntry}, display ${w.displayId})`),
                        ...failed.map(f => `✗ Display ${f.displayId}: ${f.error}`),
                        applyLine(d.reloaded, 'Reload', d.reloadMessage || ''),
                        d.patchQueued ? queuedLine('Client patch', d.patchDeployMessage || '') : applyLine(d.patchDeployed || d.patchRemoved, 'Patch', d.patchDeployMessage || ''),
                    ],
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-4.MPQ', url: d.patchDownloadUrl }] : [],
                    note: 'IDs returned to the pool. The weapons stay in the client until you close WoW and click Rebuild patch.',
                    error: failed.length ? `${failed.length} could not be deleted — see the lines above.` : undefined,
                });
            } catch (e) { setResult({ title: 'Delete failed', error: String(e) }); }
            finally { busy(btn, false); updateSelection(); loadWeapons(); loadStatus(); }
        });
        async function viewForged(btn) {
            const id = btn.dataset.view, name = btn.dataset.name || ('display ' + id);
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/PreviewForged?displayId=${encodeURIComponent(id)}`)).json();
                if (!d.ok) return setResult({ title: 'Could not load weapon', error: d.error });
                lastGrip = null; // stored-bytes view has no grip payload
                wfGlowWanted = null; // a stored weapon shows its own baked colours, not the lane's live tint
                loadGlb(previewUrl(d), 'forged');
                setResult({ title: `Viewing ${name}`, kv: { 'Display': id, 'Texture': d.hasTexture ? 'yes' : 'no' },
                    note: 'Rendered from the stored M2+BLP in the registry.' });
            } catch (e) { setResult({ title: 'Load failed', error: String(e) }); }
            finally { btn.disabled = false; }
        }
        async function deleteWeapon(btn) {
            const id = btn.dataset.del, name = btn.dataset.name;
            if (!confirm(`Delete "${name}" (display ${id})?\n\nRemoves the item from the world database and the packaged patch. Its IDs return to the pool.`)) return;
            btn.disabled = true;
            try {
                const d = await (await fetch(`/WeaponForge/DeleteWeapon?displayId=${encodeURIComponent(id)}`, { method: 'POST' })).json();
                if (!d.ok) return setResult({ title: 'Delete failed', error: d.error });
                setResult({
                    title: `Deleted "${d.deleted.name}" everywhere`,
                    kv: { 'Weapons remaining': d.weaponsRemaining, 'Patch': d.patchQueued ? 'rebuild queued' : d.patchRemoved ? 'removed' : 'repackaged & redeployed' },
                    diagnostics: [
                        applyLine(d.itemRowDeleted, 'World DB', d.itemRowMessage || ''),
                        applyLine(d.reloaded, 'Reload', d.reloadMessage || ''),
                        d.patchQueued ? queuedLine('Client patch', d.patchDeployMessage || '') : applyLine(d.patchDeployed || d.patchRemoved, 'Patch', d.patchDeployMessage || ''),
                    ],
                    downloads: d.patchDownloadUrl ? [{ label: 'patch-4.MPQ', url: d.patchDownloadUrl }] : [],
                    note: 'IDs returned to the pool. The weapon stays in the client until you close WoW and click Rebuild patch. If a reused entry shows cached item metadata, remove WDB\\itemcache.wdb (or the whole WDB cache directory); WoW recreates it.'
                });
            } finally { btn.disabled = false; loadWeapons(); loadStatus(); }
        }

        // ---------- status pills + weapon-type dropdown ----------
        async function loadStatus() {
            try {
                const s = await (await fetch('/WeaponForge/Status')).json();
                pill('pillFixture', s.fixtureVerified, 'fixture verified', 'fixture FAILED');
                pill('pillDonor', s.donorM2Found, `donor ${(s.donorM2Bytes || 0).toLocaleString()} B`, 'donor not mounted', true);
                document.getElementById('pillContract').textContent = 'contract v' + s.coordinateContractVersion;
                const dp = s.deployedPatch || {};
                const dpEl = document.getElementById('pillDeploy');
                // Queue depth first: it is the thing the operator acts on. Stale is the failure
                // mode (client was running during the deploy); the rest is plain state.
                dpEl.textContent = !dp.configured ? 'deploy: no client path'
                    : dp.pending > 0 ? `${dp.pending} change${dp.pending === 1 ? '' : 's'} queued — close WoW, Rebuild patch`
                    : dp.stale ? 'patch-4 STALE in client — close WoW, Rebuild patch'
                    : dp.deployedExists ? 'patch-4 deployed ✓'
                    : dp.built ? 'patch-4 not deployed yet' : 'no patch yet';
                dpEl.className = 'wf-pill ' + (!dp.configured ? 'warn' : dp.pending > 0 ? 'warn' : dp.stale ? 'bad' : dp.deployedExists ? 'ok' : '');
                dpEl.title = (dp.message || '') + (dp.pendingReasons && dp.pendingReasons.length ? '\n\nPending:\n• ' + dp.pendingReasons.join('\n• ') : '');
                fillWeaponTypes(s.weaponTypes || []);
            } catch { pill('pillFixture', false, '', 'status unavailable'); }
        }
        // Options come from the server catalog; a family whose stock donor could not be resolved is
        // listed but disabled so the reason is visible instead of the type silently missing.
        function fillWeaponTypes(types) {
            if (!types.length) return;
            weaponTypeMeta.clear();
            for (const t of types) weaponTypeMeta.set(t.key, t);
            for (const id of ['impType', 'tbcType', 'wotlkType']) {
                const sel = document.getElementById(id);
                const keep = sel.value;
                sel.innerHTML = '';
                for (const t of types) {
                    const o = document.createElement('option');
                    o.value = t.key;
                    // Families without an arbitrary-GLB route (shields: no long axis/grip to find)
                    // are client-import only (TBC/WotLK), so the GLB card lists them disabled with the reason.
                    const glbBlocked = id === 'impType' && t.glbImport === false;
                    o.textContent = !t.ok ? `${t.label} (no donor)` : glbBlocked ? `${t.label} (TBC/WotLK import only)` : t.label;
                    o.disabled = !t.ok || glbBlocked;
                    if (glbBlocked) o.title = 'Shields have no long axis or grip for the GLB heuristics — import them from the TBC or WotLK browse instead.';
                    else if (t.ok && t.donorModel) o.title = `donor: ${t.donorModel} (row ${t.donorDisplayRow})`;
                    else if (!t.ok && t.error) o.title = t.error;
                    sel.appendChild(o);
                }
                sel.value = [...sel.options].some(o => o.value === keep && !o.disabled) ? keep : 'sword1h';
            }
        }
        function pill(id, ok, okText, badText, warnIfBad) {
            const el = document.getElementById(id);
            el.textContent = ok ? okText : badText;
            el.className = 'wf-pill ' + (ok ? 'ok' : (warnIfBad ? 'warn' : 'bad'));
        }

        // ---------- collapsible control cards: folded on load, header click toggles ----------
        document.querySelectorAll('.wf-controls > .wf-card').forEach(card => {
            card.classList.add('collapsed');
            const h3 = card.querySelector(':scope > h3');
            if (h3) h3.addEventListener('click', e => {
                if (e.target.closest('button, a, input, select, textarea')) return;
                card.classList.toggle('collapsed');
            });
        });

        // Seed the vanilla lane when its card is first opened. Registered AFTER the toggler above so
        // this handler sees the state the click just produced, and after `collapsed` has been applied
        // so nothing queries the world DB for a card that is still folded.
        (function () {
            const card = document.getElementById('vanillaSearch').closest('.wf-card');
            if (!card) return;
            const h3 = card.querySelector(':scope > h3');
            if (h3) h3.addEventListener('click', () => { if (!card.classList.contains('collapsed')) seedVanillaLane(); });
        })();

        initViewer();
        loadStatus();
        LEGACY_LANES.forEach(loadLaneStatus);
        loadItemVisuals();
        loadGlowCoverage();

        // How much of the mounted client's weapon glow this lane can actually reproduce. DBC-only on
        // the server, so it is instant; failures leave the line blank rather than shouting.
        async function loadGlowCoverage() {
            for (const lane of LEGACY_LANES) {
                const el = lane.el('GlowCoverage');
                if (!el) continue;
                try {
                    const d = await (await fetch(`/WeaponForge/GlowCoverage?expansion=${lane.key}`)).json();
                    if (!d.ok) { el.textContent = ''; continue; }
                    const pct = d.weaponRows ? Math.round(d.withGlow * 1000 / d.weaponRows) / 10 : 0;
                    el.innerHTML = `<b>Glow coverage:</b> ${d.withGlow.toLocaleString()} of ${d.weaponRows.toLocaleString()} ` +
                        `${lane.label} weapon models (${pct}%) carry a permanent glow on their display row — ` +
                        `${d.exact.toLocaleString()} copy across to 1.12 unchanged, ${d.mapped.toLocaleString()} map to the nearest vanilla glow, ` +
                        `${d.unmatched.toLocaleString()} are cast animations with no equivalent.`;
                    el.title = d.note || '';
                } catch (e) { el.textContent = ''; }
            }
        }
        loadWeapons();
    </script>
}
