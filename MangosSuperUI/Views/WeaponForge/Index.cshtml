            host.innerHTML = rows.map((r, i) => `<button type="button" class="wf-spell-result" data-result-index="${i}">
                <b>${esc(r.name || `Spell ${r.id}`)} <small>#${r.id}</small></b>
                <span>${esc(r.triggerLabel || ITEM_TRIGGER_NAMES[r.trigger] || 'Item effect')} · ${esc(nativeSlotSummary(r))} · used by ${r.usedByCount || 0} stock item(s)${r.hidden ? ' · hidden helper' : ''}${r.description ? ` — ${esc(r.description)}` : ''}</span></button>`).join('');
