@{
    ViewData["Title"] = "Item Assets";
}

@section Styles {
    <style>
        .wf-wrap { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .wf-header { padding: 20px 28px 14px; border-bottom: 1px solid var(--border-light); }
        .wf-header h1 { font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px; }
        .wf-header-sub { font-size: 13px; color: var(--text-muted); }
        .wf-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
        .wf-pill { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
            border: 1px solid var(--border-light); color: var(--text-muted); background: var(--bg-card); }
        .wf-pill.ok { color: #14804a; border-color: #14804a55; background: #14804a14; }
        .wf-pill.bad { color: #b42318; border-color: #b4231855; background: #b4231814; }
        .wf-pill.warn { color: #b54708; border-color: #b5470855; background: #b5470814; }

        .wf-body { flex: 1; display: grid; grid-template-columns: 1fr minmax(400px, 44%);
            gap: 20px; padding: 20px 28px; overflow: hidden; }
        @@media (max-width: 1100px) { .wf-body { grid-template-columns: 1fr; overflow-y: auto; } }

        .wf-controls { overflow-y: auto; padding-right: 6px; display: flex; flex-direction: column; gap: 16px; }
        .wf-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 10px; padding: 16px 18px; }
        .wf-card h3 { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 3px; display: flex; align-items: center; gap: 8px; }
        /* Control cards fold to a single header line; click the header to open. */
        .wf-controls > .wf-card > h3 { cursor: pointer; user-select: none; }
        .wf-controls > .wf-card > h3::before { content: '▾'; font-size: 10px; color: var(--text-muted); flex: 0 0 12px; }
        .wf-controls > .wf-card.collapsed > h3 { margin-bottom: 0; }
        .wf-controls > .wf-card.collapsed > h3::before { content: '▸'; }
        .wf-controls > .wf-card.collapsed > :not(h3) { display: none !important; }
        .wf-card .phase { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
            color: var(--text-muted); border: 1px solid var(--border-light); border-radius: 4px; padding: 1px 6px; }
        .wf-card p { font-size: 12px; color: var(--text-muted); margin: 0 0 12px; line-height: 1.5; }
        .wf-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
        .wf-field { display: flex; flex-direction: column; gap: 4px; }
        .wf-field label { font-size: 11px; color: var(--text-muted); font-weight: 600; }
        .wf-field input[type=text], .wf-field input[type=number], .wf-field select {
            width: 150px; padding: 6px 8px; font-size: 13px; border-radius: 6px;
            border: 1px solid var(--border-light); background: var(--bg-input, var(--bg-card)); color: var(--text-primary); }
        .wf-field input[type=number] { width: 90px; }
        .wf-field select { width: auto; min-width: 120px; }
        .wf-btn { padding: 8px 14px; font-size: 13px; font-weight: 600; border-radius: 7px; cursor: pointer;
            border: 1px solid var(--accent, #2563eb); background: var(--accent, #2563eb); color: #fff; }
        .wf-btn:hover { filter: brightness(1.08); }
        .wf-btn.secondary { background: transparent; color: var(--text-primary); border-color: var(--border-light); }
        .wf-btn:disabled { opacity: .55; cursor: default; }
        .wf-file { font-size: 12px; color: var(--text-muted); }
        .wf-note { font-size: 11px; color: var(--text-muted); margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border-light); }

        .wf-preview { display: flex; flex-direction: column; gap: 12px; min-height: 0; overflow-y: auto; padding-right: 6px; }
        .wf-preview > :not(.wf-viewer) { flex-shrink: 0; }
        .wf-viewer { flex: 1; min-height: 420px; border: 1px solid var(--border-light); border-radius: 10px;
            overflow: hidden; background: linear-gradient(180deg, #1a1d24, #0f1115); position: relative; }
        .wf-viewer.expanded { position: fixed; inset: 20px; z-index: 60; min-height: 0; border-radius: 12px;
            box-shadow: 0 20px 60px #000a; }
        .wf-viewer canvas { display: block; width: 100%; height: 100%; }
        .wf-viewer .hint { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            color: #8a93a6; font-size: 13px; pointer-events: none; }
        .wf-cameras { position:absolute; z-index:2; top:8px; right:8px; display:flex; gap:5px; }
        .wf-cameras button { border:1px solid #ffffff33; background:#111722cc; color:#dce2ee; border-radius:5px;
            padding:4px 7px; font-size:10px; cursor:pointer; }
        .wf-result { max-height: 34%; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 10px;
            padding: 12px 14px; background: var(--bg-card); font-size: 12px; }
        .wf-result .title { font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
        .wf-kv { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; color: var(--text-muted); }
        .wf-kv b { color: var(--text-primary); font-weight: 600; }
        .wf-diag { margin-top: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; line-height: 1.5; color: var(--text-muted); }
        .wf-diag .err { color: #d9534f; }
        .wf-diag .warn { color: #d98800; }
        .wf-dl { display: inline-block; margin-top: 8px; margin-right: 14px; font-size: 13px; font-weight: 600; color: var(--accent, #2563eb); }

        /* Triangle-budget slider */
        .wf-slider { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px; }
        .wf-slider input[type=range] { flex: 1; }
        .wf-slider .val { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px;
            color: var(--text-primary); min-width: 88px; text-align: right; }

        /* GLB import adjustment groups: labelled boxes of compact "label · slider · value" rows. */
        .wf-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px; margin-top: 12px; }
        .wf-group { border: 1px solid var(--border-light); border-radius: 8px; padding: 10px 12px 11px; background: var(--bg-input, transparent); }
        .wf-group-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px;
            font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); }
        .wf-ctl { display: grid; grid-template-columns: 96px 1fr 56px; align-items: center; gap: 8px; min-height: 24px; }
        .wf-ctl + .wf-ctl { margin-top: 2px; }
        .wf-ctl label { font-size: 11px; color: var(--text-muted); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .wf-ctl input[type=range] { width: 100%; min-width: 0; margin: 0; }
        .wf-ctl .val { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11px; color: var(--text-primary); text-align: right; white-space: nowrap; }
        .wf-checks { display: flex; flex-wrap: wrap; gap: 6px 14px; }
        .wf-checks label, .wf-check { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-muted); cursor: pointer; white-space: nowrap; }
        .wf-checks input, .wf-check input { margin: 0; }
        .wf-mini { padding: 2px 8px; font-size: 10.5px; font-weight: 600; border-radius: 5px; cursor: pointer; text-transform: none; letter-spacing: 0;
            border: 1px solid var(--border-light); background: transparent; color: var(--text-primary); }
        .wf-mini:hover { border-color: var(--accent, #2563eb); color: var(--accent, #2563eb); }
        .wf-actions { align-items: center; }
        .wf-actions .wf-ctl label { white-space: nowrap; }
        .wf-group-stack { display: flex; flex-direction: column; gap: 10px; }
        .wf-group-stack .wf-group { flex: 0 0 auto; }

        /* TBC browse modal */
        .wf-modal-backdrop { position: fixed; inset: 0; z-index: 70; background: #000a; display: none; }
        .wf-modal-backdrop.open { display: flex; align-items: center; justify-content: center; }
        .wf-modal { width: min(720px, 92vw); max-height: 84vh; display: flex; flex-direction: column;
            background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px;
            box-shadow: 0 20px 60px #000c; padding: 16px 18px; }
        .wf-modal h3 { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 10px;
            display: flex; align-items: center; justify-content: space-between; }
        .wf-modal .wf-close { border: none; background: none; color: var(--text-muted); font-size: 16px; cursor: pointer; }
        .wf-modal-list { flex: 1; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 8px; margin-top: 10px; }
        .wf-modal-list table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .wf-modal-list th { position: sticky; top: 0; background: var(--bg-card); text-align: left;
            color: var(--text-muted); font-weight: 600; font-size: 11px; padding: 6px 10px;
            border-bottom: 1px solid var(--border-light); }
        .wf-modal-list td { padding: 5px 10px; color: var(--text-primary); border-bottom: 1px dashed var(--border-light); cursor: pointer; }
        /* Hover wash. Was a flat white alpha, which is invisible on the light theme the site ships;
           the vanilla lane's list is permanently on-page, so a dead hover state shows there most. */
        .wf-modal-list tr:hover td { background: color-mix(in srgb, var(--accent) 9%, transparent); }
        /* Selected source row. The vanilla lane previews on selection, so which row is live has to
           read at a glance — and it has to read on a LIGHT theme too, which a flat white wash does not. */
        .wf-modal-list tr.sel td { background: color-mix(in srgb, var(--accent) 18%, transparent); }
        .wf-modal-list td.muted { color: var(--text-muted); }
        .wf-modal-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px;
            font-size: 12px; color: var(--text-muted); }

        /* Forged Weapons registry list */
        .wf-weapons table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .wf-weapons th { text-align: left; color: var(--text-muted); font-weight: 600; font-size: 11px;
            padding: 4px 8px 4px 0; border-bottom: 1px solid var(--border-light); }
        .wf-weapons td { padding: 5px 8px 5px 0; color: var(--text-primary); border-bottom: 1px dashed var(--border-light); }
        .wf-weapons td.muted { color: var(--text-muted); }
        .wf-weapons .wf-del { padding: 3px 9px; font-size: 11.5px; font-weight: 600; border-radius: 6px; cursor: pointer;
            border: 1px solid #b4231855; background: #b4231814; color: #b42318; }
        .wf-weapons .wf-del:hover { background: #b4231828; }
        .wf-weapons .empty { color: var(--text-muted); font-size: 12px; }
        .wf-weapons td.sel, .wf-weapons th.sel { width: 22px; padding-right: 4px; }
        .wf-weapons input[type=checkbox] { margin: 0; cursor: pointer; }
        .wf-weapons tr.selected td { background: #4f8ef714; }

        /* Final item configuration — one shared build step for GLB and TBC sources. */
        body.wf-build-open { overflow: hidden; }
        .wf-build-backdrop { position: fixed; inset: 0; z-index: 120; display: none; padding: clamp(10px, 2vw, 28px);
            align-items: center; justify-content: center; background: #000a;
            -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
        .wf-build-backdrop.open { display: flex; animation: wfBuildFade .16s ease-out; }
        .wf-build-modal { width: min(1500px, 97vw); height: min(930px, calc(100vh - 56px)); min-height: 0;
            display: grid; grid-template-rows: auto minmax(0, 1fr) auto; overflow: hidden;
            color: var(--text-primary); background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: 18px; box-shadow: 0 20px 60px #000a;
            animation: wfBuildLift .2s cubic-bezier(.2,.8,.2,1); }
        .wf-build-head { display: flex; align-items: center; gap: 14px; padding: 16px 20px;
            border-bottom: 1px solid var(--border-light);
            background: linear-gradient(110deg, color-mix(in srgb, var(--accent, #3b82c4) 8%, transparent), transparent 56%); }
        .wf-build-modal[aria-busy="true"] { pointer-events: none; cursor: wait; }
        .wf-build-mark { width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center;
            border-radius: 11px; color: var(--text-on-accent, #fff);
            background: linear-gradient(145deg, var(--accent, #3b82c4), var(--accent-hover, #2d6da8));
            box-shadow: 0 8px 24px color-mix(in srgb, var(--accent, #3b82c4) 27%, transparent); }
        .wf-build-heading { min-width: 0; flex: 1; }
        .wf-build-kicker { display: flex; align-items: center; gap: 7px; color: var(--text-muted);
            font-size: 10px; font-weight: 800; letter-spacing: .75px; text-transform: uppercase; }
        .wf-build-kicker span { padding: 2px 7px; border: 1px solid color-mix(in srgb, var(--accent, #3b82c4) 35%, transparent);
            border-radius: 999px; color: var(--accent, #3b82c4); background: color-mix(in srgb, var(--accent, #3b82c4) 10%, transparent); }
        .wf-build-head h2 { margin: 2px 0 0; font-size: 19px; line-height: 1.2; color: var(--text-primary); }
        .wf-build-head-sub { margin-left: auto; max-width: 38%; overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; font-size: 12px; color: var(--text-muted); }
        .wf-build-x { width: 34px; height: 34px; display: grid; place-items: center; flex: 0 0 34px;
            border: 1px solid var(--border-light); border-radius: 9px; background: transparent;
            color: var(--text-muted); cursor: pointer; }
        .wf-build-x:hover { color: var(--text-primary); background: color-mix(in srgb, var(--text-primary) 8%, transparent); }

        .wf-build-body { min-height: 0; display: grid; grid-template-columns: 210px minmax(460px, 1fr) minmax(270px, 330px); }
        .wf-build-nav { min-height: 0; padding: 16px 12px; overflow-y: auto; border-right: 1px solid var(--border-light);
            background: var(--bg-card-alt, var(--bg-card)); }
        .wf-build-nav button { width: 100%; display: flex; align-items: center; gap: 9px; margin-bottom: 5px;
            padding: 10px 11px; border: 1px solid transparent; border-radius: 9px; background: transparent;
            color: var(--text-muted); font-size: 12px; font-weight: 650; text-align: left; cursor: pointer; }
        .wf-build-nav button i { width: 15px; text-align: center; }
        .wf-build-nav button.active { color: var(--accent, #3b82c4);
            border-color: color-mix(in srgb, var(--accent, #3b82c4) 35%, transparent);
            background: color-mix(in srgb, var(--accent, #3b82c4) 12%, transparent); }
        .wf-build-source { margin: 18px 4px 0; padding: 11px; border: 1px solid var(--border-light);
            border-radius: 10px; background: var(--bg-card); }
        .wf-build-source .label { margin-bottom: 5px; font-size: 9px; font-weight: 800; letter-spacing: .6px;
            text-transform: uppercase; color: var(--text-muted); }
        .wf-build-source strong { display: block; overflow-wrap: anywhere; font-size: 12px; color: var(--text-primary); }
        .wf-build-source span { display: block; margin-top: 3px; font-size: 10.5px; color: var(--text-muted); }

        .wf-build-work { min-width: 0; min-height: 0; overflow-y: auto; padding: 20px clamp(16px, 2vw, 28px) 34px; }
        .wf-build-pane { display: none; }
        .wf-build-pane.active { display: block; animation: wfBuildPane .14s ease-out; }
        .wf-build-pane-title { margin-bottom: 14px; }
        .wf-build-pane-title h3 { margin: 0; color: var(--text-primary); font-size: 16px; }
        .wf-build-pane-title p { margin: 4px 0 0; color: var(--text-muted); font-size: 11.5px; line-height: 1.45; }
        .wf-build-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .wf-build-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .wf-build-card { padding: 14px; margin-bottom: 12px; border: 1px solid var(--border-light);
            border-radius: 12px; background: var(--bg-card-alt, transparent); }
        .wf-build-card > h4 { display: flex; align-items: center; justify-content: space-between; gap: 10px;
            margin: 0 0 10px; color: var(--text-primary); font-size: 12px; }
        .wf-build-card > h4 span { color: var(--text-muted); font-size: 10px; font-weight: 500; }
        .wf-build-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
        .wf-build-field.wide { grid-column: 1 / -1; }
        .wf-build-field > label { display: flex; justify-content: space-between; gap: 7px; color: var(--text-muted);
            font-size: 10.5px; font-weight: 700; }
        .wf-build-field > label em { color: #b42318; font-style: normal; }
        .wf-build-field input, .wf-build-field select, .wf-build-field textarea,
        .wf-build-row input, .wf-build-row select { width: 100%; min-height: 36px; padding: 7px 9px;
            border: 1px solid var(--border-light); border-radius: 8px;
            background: var(--bg-input, var(--bg-card));
            color: var(--text-primary); font-size: 12px; outline: none; }
        .wf-build-field textarea { min-height: 72px; resize: vertical; }
        .wf-build-field input:focus, .wf-build-field select:focus, .wf-build-field textarea:focus,
        .wf-build-row input:focus, .wf-build-row select:focus { border-color: var(--accent, #3b82c4);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #3b82c4) 15%, transparent); }
        .wf-build-field input[readonly] { opacity: .82; cursor: default; }
        .wf-build-help { color: var(--text-muted); font-size: 10px; line-height: 1.35; }
        .wf-quality-readout { font-size: 10px; font-weight: 800; }

        .wf-build-list { display: flex; flex-direction: column; gap: 8px; }
        .wf-build-empty { padding: 15px; border: 1px dashed var(--border-light); border-radius: 9px;
            color: var(--text-muted); font-size: 11px; text-align: center; }
        .wf-build-row { display: grid; grid-template-columns: minmax(130px, 1fr) 110px 32px; gap: 7px;
            align-items: center; padding: 8px; border: 1px solid var(--border-light); border-radius: 9px;
            background: color-mix(in srgb, var(--text-primary) 4%, transparent); }
        .wf-build-remove { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid #b4231855;
            border-radius: 7px; color: #b42318; background: #b4231814; cursor: pointer; }
        .wf-build-add { padding: 7px 10px; border: 1px dashed color-mix(in srgb, var(--accent, #3b82c4) 45%, transparent); border-radius: 8px;
            color: var(--accent, #3b82c4); background: color-mix(in srgb, var(--accent, #3b82c4) 7%, transparent);
            font-size: 11px; font-weight: 700; cursor: pointer; }
        .wf-build-add:hover { background: color-mix(in srgb, var(--accent, #3b82c4) 14%, transparent); }

        .wf-spell-card { position: relative; padding: 12px; border: 1px solid var(--border-light); border-radius: 11px;
            background: color-mix(in srgb, var(--text-primary) 4%, transparent); }
        .wf-spell-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 9px; }
        .wf-spell-head strong { font-size: 11.5px; color: var(--text-primary); }
        .wf-spell-primary { display: grid; grid-template-columns: minmax(180px, 1fr) 94px 145px; gap: 8px; align-items: end; }
        .wf-spell-search-wrap { position: relative; }
        .wf-spell-results { position: absolute; z-index: 6; top: calc(100% + 4px); left: 0; right: 0; display: none;
            max-height: 240px; overflow-y: auto; border: 1px solid color-mix(in srgb, var(--accent, #3b82c4) 40%, transparent); border-radius: 9px;
            background: var(--bg-card); box-shadow: 0 15px 38px #0006; }
        .wf-spell-results.open { display: block; }
        .wf-spell-result { display: block; width: 100%; padding: 8px 9px; border: 0;
            border-bottom: 1px solid var(--border-light); background: transparent; color: inherit; text-align: left; cursor: pointer; }
        .wf-spell-result:last-child { border-bottom: 0; }
        .wf-spell-result:hover { background: color-mix(in srgb, var(--accent, #3b82c4) 10%, transparent); }
        .wf-spell-result b { display: block; color: var(--text-primary); font-size: 11px; }
        .wf-spell-result span { display: block; margin-top: 2px; color: var(--text-muted); font-size: 9.5px; line-height: 1.3; }
        .wf-spell-resolved { min-height: 18px; margin-top: 6px; color: var(--text-muted); font-size: 10px; }
        .wf-spell-resolved.ok { color: #14804a; }
        .wf-spell-resolved.bad { color: #b42318; }
        .wf-spell-advanced { display: grid; grid-template-columns: repeat(5, minmax(80px, 1fr)); gap: 8px;
            margin-top: 9px; padding-top: 9px; border-top: 1px dashed var(--border-light); }

        .wf-mask { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px 9px; }
        .wf-mask label { display: flex; align-items: center; gap: 5px; min-width: 0; color: var(--text-muted);
            font-size: 10.5px; cursor: pointer; }
        .wf-mask label:first-child { grid-column: 1 / -1; padding-bottom: 4px; margin-bottom: 2px; border-bottom: 1px dashed var(--border-light); }
        .wf-mask input { width: auto; min-height: 0; }

        .wf-build-review { min-width: 0; min-height: 0; overflow-y: auto; padding: 17px 16px;
            border-left: 1px solid var(--border-light); background: var(--bg-card-alt, var(--bg-card)); }
        .wf-build-review h3 { margin: 0 0 4px; font-size: 13px; color: var(--text-primary); }
        .wf-build-review > p { margin: 0 0 13px; color: var(--text-muted); font-size: 10.5px; line-height: 1.4; }
        .wf-review-block { padding: 10px 0; border-top: 1px solid var(--border-light); }
        .wf-review-block:first-of-type { border-top: 0; padding-top: 0; }
        .wf-review-block h5 { margin: 0 0 6px; color: var(--text-muted); font-size: 9px; letter-spacing: .6px; text-transform: uppercase; }
        .wf-review-line { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 9px; margin: 3px 0;
            color: var(--text-muted); font-size: 10.5px; }
        .wf-review-line b { max-width: 165px; overflow-wrap: anywhere; color: var(--text-primary); font-weight: 650; text-align: right; }
        .wf-build-valid { margin-top: 12px; padding: 9px 10px; border: 1px solid #14804a55; border-radius: 9px;
            color: #14804a; background: #14804a14; font-size: 10.5px; line-height: 1.35; }
        .wf-build-errors { display: none; margin: 0 0 12px; padding: 10px 12px; border: 1px solid #b4231855;
            border-radius: 9px; color: #b42318; background: #b4231814; font-size: 11px; line-height: 1.45; }
        .wf-build-errors.open { display: block; }

        .wf-build-foot { display: flex; align-items: center; gap: 8px; padding: 12px 18px;
            border-top: 1px solid var(--border-light); background: var(--bg-card-alt, var(--bg-card)); }
        .wf-build-foot-note { margin-right: auto; color: var(--text-muted); font-size: 10.5px; }
        .wf-build-foot-status { padding: 5px 8px; border: 1px solid #14804a44; border-radius: 8px;
            color: #14804a; background: #14804a10; outline: none; }
        .wf-build-final { min-width: 165px; box-shadow: 0 8px 24px color-mix(in srgb, var(--accent, #3b82c4) 24%, transparent); }

        @@keyframes wfBuildFade { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes wfBuildLift { from { opacity: 0; transform: translateY(10px) scale(.992); } to { opacity: 1; transform: none; } }
        @@keyframes wfBuildPane { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
        @@media (max-width: 1100px) {
            .wf-build-modal { width: 98vw; }
            .wf-build-body { grid-template-columns: 170px minmax(0, 1fr); }
            .wf-build-review { display: none; }
        }
        @@media (max-width: 720px) {
            .wf-build-backdrop { padding: 0; }
            .wf-build-modal { width: 100vw; height: 100vh; min-height: 0; border-radius: 0; }
            .wf-build-head { padding: 12px; }
            .wf-build-head-sub { display: none; }
            .wf-build-body { display: block; overflow-y: auto; }
            .wf-build-nav { display: flex; gap: 4px; position: sticky; top: 0; z-index: 4; padding: 8px;
                overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--border-light); }
            .wf-build-nav button { flex: 0 0 auto; width: auto; margin: 0; padding: 8px 9px; }
            .wf-build-nav button span { display: none; }
            .wf-build-source { display: none; }
            .wf-build-work { overflow: visible; padding: 15px 12px 28px; }
            .wf-build-grid, .wf-build-grid.three { grid-template-columns: 1fr; }
            .wf-spell-primary, .wf-spell-advanced { grid-template-columns: 1fr 1fr; }
            .wf-spell-primary > :first-child { grid-column: 1 / -1; }
            .wf-mask { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .wf-build-foot-note { display: none; }
            .wf-build-foot-status { display: block; order: 2; flex: 1 1 100%; margin: 2px 0 0; text-align: center; }
            .wf-build-foot { padding: 8px; gap: 5px; flex-wrap: wrap; }
            .wf-build-foot #ibCancel { display: none; }
            .wf-build-foot .wf-btn { padding: 7px 9px; }
            .wf-build-final { min-width: 140px; }
        }
    </style>
}

<div class="app-shell">
    <partial name="_Sidebar" />

    <div class="main-content">
<div class="wf-wrap">
    <div class="wf-header">
        <h1><i class="fa-solid fa-hammer"></i> Weapon Forge</h1>
        <div class="wf-header-sub">
            The import station: bring a <strong>finished GLB</strong> (UVs + texture authored elsewhere), decimate it
            to a game budget, and forge it into the game. Forging inserts the item into the world database, reloads
            <code>item_template</code>, and deploys <code>patch-4.MPQ</code> to the client Data folder. Restart the
            client, then <code>.additem</code> the new entry. If an existing custom entry shows an old name or equip
            slot, fully close WoW and remove <code>WDB\itemcache.wdb</code> (or the whole <code>WDB</code> cache
            directory) before relaunching; the client recreates it. All build files are also kept in the artifact folder.
        </div>
        <div class="wf-pills" id="wfPills">
            <span class="wf-pill" id="pillFixture">fixture …</span>
            <span class="wf-pill" id="pillDonor">donor …</span>
            <span class="wf-pill" id="pillContract">contract …</span>
            <span class="wf-pill" id="pillDeploy" title="Forges and deletes are queued; the patch-4.MPQ in the client is only rebuilt and deployed when you click Rebuild patch. The game client locks its MPQs while running, so close it first.">deploy …</span>
        </div>
    </div>

    <div class="wf-body">
        <div class="wf-controls">

            <div class="wf-card">
                <h3><span class="phase">Import</span> Pre-textured GLB → Game item</h3>
                <p>Accepts any triangle count — a ZBrush export, a TRELLIS reconstruction, anything with
                   <strong>UV0 and an embedded texture</strong> already authored. The slider decimates it with a
                   UV-preserving edge collapse (seams locked, the texture never smears), so what you preview is
                   byte-for-byte what forges. Vanilla weapons are ~100–250 triangles; detail-heavy exports (separate gems,
                   fittings, pommels) keep their pieces best at 1,000–2,000 — every part keeps a floor of detail, so nothing
                   vanishes, it just gets coarser. The Forge ceiling is 4,000.</p>
                <div class="wf-row">
                    <div class="wf-field" style="flex:1;min-width:220px;">
                        <label>Finished GLB (.glb, UVs + texture)</label>
                        <input type="file" id="glbFile" accept=".glb" class="wf-file">
                    </div>
                    <div class="wf-field" title="Drives the gameplay row (subclass/inventory/sheath/delay; ranged slot, ammo and range for bows, guns, crossbows, thrown and wands), the donor scaffold the M2 is built on (bones, attachments, sounds, icon, projectile visual), and where the grip lands — a staff grips mid-shaft, an axe low on the haft, a bow at the centre of its limbs">
                        <label>Weapon type</label>
                        <select id="impType"><option value="sword1h" selected>1H Sword</option></select>
                    </div>
                    <div class="wf-field"><label>Name (optional)</label>
                        <input type="text" id="glbName" placeholder="Imported Blade"></div>
                </div>
                <!-- Adjustment groups. Every family gets every control; each group is one labelled box of
                     compact "label · slider · value" rows so the card reads as sections, not a wall. -->
                <div class="wf-groups">
                    <div class="wf-group-stack">
                    <div class="wf-group" title="Discrete orientation fixes, applied after the automatic orientation">
                        <div class="wf-group-title"><span>Orientation</span></div>
                        <div class="wf-checks">
                            <label title="Rotate 180° so the grip and tip swap ends"><input type="checkbox" id="impFlip"> flip grip/tip</label>
                            <label title="Roll 180° about the long axis — bow string side, rifle stock, crossbow stock or axe blade ended up on the wrong side"><input type="checkbox" id="impFlipUp"> flip upside down</label>
                            <label title="Mirror left/right across the hand (true reflection; faces stay outward) — bolt handles, one-sided ornaments"><input type="checkbox" id="impMirror"> mirror left/right</label>
                            <label title="Straighten the blade centerline (off by default — don't bend a finished model unless it needs it)"><input type="checkbox" id="impStraighten"> straighten centerline</label>
                        </div>
                        <div class="wf-ctl" style="margin-top:8px;" title="Tilt about the blade axis, applied after auto-orientation — fix a wrongly-rolled import (±90 stands a flat blade up)">
                            <label>Extra roll</label>
                            <input type="range" id="impRoll" min="-180" max="180" step="5" value="0">
                            <span class="val" id="impRollVal">0°</span>
                        </div>
                    </div>
                    <div class="wf-group" title="Embedded texture grading — applied to the PNG before it becomes the BLP">
                        <div class="wf-group-title"><span>Texture</span></div>
                        <div class="wf-ctl" title="Multiplies the embedded texture's brightness: +100 ≈ double, −100 ≈ half; blacks stay black">
                            <label>Brightness</label>
                            <input type="range" id="impBright" min="-100" max="100" step="5" value="0">
                            <span class="val" id="impBrightVal">0</span>
                        </div>
                        <div class="wf-ctl" title="Saturation: +100 vivid, −100 grayscale — lift a muted texture with brightness and saturation together">
                            <label>Saturation</label>
                            <input type="range" id="impSat" min="-100" max="100" step="5" value="0">
                            <span class="val" id="impSatVal">0</span>
                        </div>
                    </div>
                    <div class="wf-group" title="Pre-import recolor: tick 'recolor texture' and pick a primary colour — the palette engine shifts the embedded texture to match (applied before brightness/saturation), live in the preview and baked into the BLP when you forge. Cycle the theories to compare.">
                        <div class="wf-group-title"><span>Recolor</span></div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="impRcOn"> recolor texture</label>
                            <input type="color" id="impRcColor" value="#3b6fd4" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                            <label style="display:flex;align-items:center;gap:5px;font-size:12px;">Tier
                                <select id="impRcTier">
                                    <option value="subtle">Subtle</option>
                                    <option value="improved" selected>Improved</option>
                                    <option value="bold">Bold</option>
                                    <option value="extreme">Extreme</option>
                                </select>
                            </label>
                        </div>
                        <div id="impRcTheories" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>
                        <div id="impRcStatus" style="font-size:11px;color:var(--text-muted);margin-top:6px;"></div>
                    </div>
                    <div class="wf-group" title="Hang one of vanilla's own enchant-style glows (ItemVisual) on the finished item, permanently — the same mechanism that makes Ashbringer glow. There is nothing to suggest from on a GLB, so this is your pick: it defaults to none. A vanilla visual fills up to FIVE anchor slots (one effect copy per anchor); the start/end sliders place those five stations along the weapon — 0% = pommel end, 100% = tip. Set start = end to pile the whole glow at one point (a pommel gem, a blade rune).">
                        <div class="wf-group-title"><span>Glow (ItemVisual)</span></div>
                        <div class="wf-ctl">
                            <label>Enchant glow</label>
                            <select id="impVisual" style="flex:1;min-width:160px;"><option value="0" selected>None</option></select>
                        </div>
                        <div class="wf-ctl" style="margin-top:6px;" title="Where the FIRST of the five glow anchors sits along the weapon's length — 0% = pommel/butt end">
                            <label>Glow start</label>
                            <input type="range" id="impGlowFrom" min="0" max="100" step="5" value="10">
                            <span class="val" id="impGlowFromVal">10%</span>
                        </div>
                        <div class="wf-ctl" title="Where the LAST of the five glow anchors sits — 100% = tip. Equal to start = all five anchors on one point">
                            <label>Glow end</label>
                            <input type="range" id="impGlowTo" min="0" max="100" step="5" value="90">
                            <span class="val" id="impGlowToVal">90%</span>
                        </div>
                        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">
                            Five anchor stations spread evenly between start and end (vanilla visuals hang one effect copy per anchor) —
                            previewed here on those same anchors after the first mesh preview.
                        </div>
                    </div>
                    </div>

                    <div class="wf-group" title="The forged mesh is rigid on the hand bone: these move the model relative to its origin — the green band in the preview is the hand">
                        <div class="wf-group-title"><span>Hand placement</span>
                            <button type="button" class="wf-mini" id="impResetPlacement" title="Back to the family's stock hand position, no offsets or tilt, 100% shape, flips off">Reset all</button></div>
                        <div class="wf-ctl" title="Where the hand sits along the length, as % of the length from the back (pommel/butt) end — 19% for a sword, ~50% for a bow. Defaults to the family's stock measurement; move it to slide the grip toward the tip or the butt">
                            <label>Hand position</label>
                            <input type="range" id="impGrip" min="0" max="100" step="1" value="19">
                            <span class="val" id="impGripVal">19%</span>
                        </div>
                        <div class="wf-ctl" title="Shift the model up/down through the hand (cm; + raises the model above the palm, e.g. a rifle barrel)">
                            <label>Up / down</label>
                            <input type="range" id="impUp" min="-50" max="50" step="1" value="0">
                            <span class="val" id="impUpVal">0 cm</span>
                        </div>
                        <div class="wf-ctl" title="Shift the model sideways through the hand (cm)">
                            <label>Sideways</label>
                            <input type="range" id="impSide" min="-50" max="50" step="1" value="0">
                            <span class="val" id="impSideVal">0 cm</span>
                        </div>
                        <div class="wf-ctl" title="Tilt the tip up or down around the hand (degrees)">
                            <label>Pitch</label>
                            <input type="range" id="impPitch" min="-45" max="45" step="1" value="0">
                            <span class="val" id="impPitchVal">0°</span>
                        </div>
                        <div class="wf-ctl" title="Tilt the tip sideways around the hand (degrees)">
                            <label>Yaw</label>
                            <input type="range" id="impYaw" min="-45" max="45" step="1" value="0">
                            <span class="val" id="impYawVal">0°</span>
                        </div>
                    </div>

                    <div class="wf-group" title="Shape — 100% = the family's stock proportions; labels read per family (a crossbow's Width is its prod span, a rifle's Length its barrel, an axe's Tip end its head)">
                        <div class="wf-group-title"><span>Shape</span></div>
                        <div class="wf-ctl" title="Uniform size about the hand — 100% = the family's stock weapon length (the import is scaled to it automatically)">
                            <label>Size</label>
                            <input type="range" id="impSize" min="50" max="200" step="5" value="100">
                            <span class="val" id="impSizeVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Length along the long axis only, about the hand — longer barrel / haft / blade / limbs, cross-section unchanged">
                            <label>Length</label>
                            <input type="range" id="impLength" min="50" max="200" step="5" value="100">
                            <span class="val" id="impLengthVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Width across the family's wide axis — blade flat, bow limb depth, crossbow prod span, axe blade height">
                            <label>Width</label>
                            <input type="range" id="impWidth" min="25" max="250" step="5" value="100">
                            <span class="val" id="impWidthVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Depth across the narrow axis — blade thickness, rifle/crossbow stock height, haft roundness">
                            <label>Depth</label>
                            <input type="range" id="impDepth" min="25" max="250" step="5" value="100">
                            <span class="val" id="impDepthVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Tip end size — scales the front 40% of the length across the long axis (axe/mace/thrown heads, wand ornaments, gun muzzle, crossbow prod end); the shaft is untouched">
                            <label>Tip end size</label>
                            <input type="range" id="impHead" min="50" max="200" step="5" value="100">
                            <span class="val" id="impHeadVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Shaft thickness — fattens or slims the thin handle/haft/barrel/limb vertices; fat parts (heads, stocks, prods) stay put">
                            <label>Shaft thickness</label>
                            <input type="range" id="impHaft" min="50" max="200" step="5" value="100">
                            <span class="val" id="impHaftVal">100%</span>
                        </div>
                        <div class="wf-ctl" title="Lens cross-section: pushes depth out at the centreline, tapering to nothing at the edges — gives a paper-flat blade a diamond profile without touching its silhouette">
                            <label>Centre thickness</label>
                            <input type="range" id="impProfile" min="0" max="100" step="5" value="0">
                            <span class="val" id="impProfileVal">off</span>
                        </div>
                    </div>

                </div>

                <div class="wf-row wf-actions" style="margin-top:12px;">
                    <div class="wf-ctl" style="flex:1;min-width:260px;grid-template-columns:110px 1fr 64px;" title="Target triangle budget — the decimator collapses down to this before preview/forge">
                        <label>Target triangles</label>
                        <input type="range" id="impTarget" min="100" max="4000" step="50" value="800">
                        <span class="val" id="impTargetVal">800 tris</span>
                    </div>
                    <label class="wf-check" title="Show where the hands land: green band = main-hand palm (model origin, exact); blue band ≈ off-hand on the handle behind the main hand on two-handers (animation-placed, approximate)"><input type="checkbox" id="impShowGrip" checked> grip markers</label>
                    <button class="wf-btn secondary" data-action="uploadGlb">Preview mesh</button>
                    <button class="wf-btn" data-action="forgeGlb"><i class="fa-solid fa-sliders"></i> Configure item…</button>
                </div>
                <div class="wf-note">
                    Requirements: single mesh, <code>TEXCOORD_0</code>, normals, embedded texture. After the first
                    preview, moving the slider re-previews automatically at the new budget. Vanilla look ≈ 100–250 tris;
                    800 is a comfortable default for multi-piece imports; the forge refuses anything still above 4,000.
                </div>
            </div>

            <div class="wf-card">
                <h3><span class="phase">TBC</span> Import from TBC client</h3>
                <p>Browse the weapon models of a <strong>TBC (2.4.3) client</strong> and forge them into vanilla
                   items. The TBC mesh and texture pass through the same pipeline as a GLB import: the geometry is
                   re-emitted as a native vanilla M2 on the selected family's donor scaffold (TBC files are v260+,
                   which the 1.12 client refuses as-is), while compatible source BLP2 textures are packaged
                   byte-for-byte. Set the <strong>TBC Client Data Path</strong> on the <a href="/Settings">Settings page</a>.</p>
                <div id="tbcState" style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Checking TBC mount…</div>
                <div class="wf-row">
                    <button class="wf-btn secondary" data-action="tbcBrowse" id="tbcBrowseBtn" disabled>
                        <i class="fa-solid fa-magnifying-glass"></i> Browse TBC weapons…</button>
                    <div class="wf-field" style="flex:1;min-width:200px;"><label>Selected model</label>
                        <input type="text" id="tbcSelected" readonly placeholder="nothing selected" style="width:100%;"></div>
                    <div class="wf-field" title="Chooses the vanilla weapon family and donor scaffold; a named TBC item's own One-Hand/Main Hand/Off Hand slot is preserved separately">
                        <label>Weapon family</label>
                        <select id="tbcType"><option value="sword1h" selected>1H Sword</option></select>
                    </div>
                    <div class="wf-field"><label>Name (optional)</label>
                        <input type="text" id="tbcName" placeholder="auto from model"></div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field" title="TBC fidelity mode preserves the complete source topology and render-pass structure">
                        <label style="min-width:96px;">Geometry</label>
                        <input type="hidden" id="tbcTarget" value="0">
                        <span class="val" id="tbcTargetVal">exact source</span>
                    </div>
                    <label class="wf-check" title="Show where the hands land: green band = main-hand palm (model origin, exact); blue band ≈ off-hand on two-handers (approximate). Off by default — a TBC import keeps the source's own hand placement, so it is always in the right spot."><input type="checkbox" id="tbcShowGrip"> grip markers</label>
                    <button class="wf-btn secondary" data-action="tbcPreview" id="tbcPreviewBtn" disabled>Preview</button>
                    <button class="wf-btn" data-action="tbcForge" id="tbcForgeBtn" disabled><i class="fa-solid fa-sliders"></i> Configure item…</button>
                </div>
                <div class="wf-groups" style="margin-top:10px;">
                    <div class="wf-group" title="Auto carries the source weapon's OWN glow across: TBC hangs most permanent glows on the display row (ItemDisplayInfo.ItemVisual) exactly as vanilla does, and 1.12 ships most of the same ids, so they copy over unchanged. Models that glow through particle emitters instead get the nearest vanilla match. Anchors are moved onto the TBC blade.">
                        <div class="wf-group-title"><span>Glow (ItemVisual)</span></div>
                        <div class="wf-ctl">
                            <label>Enchant glow</label>
                            <select id="tbcVisual" style="flex:1;min-width:160px;"><option value="-1">Auto (source glow, else suggest from effects)</option><option value="0">None</option></select>
                        </div>
                        <div class="wf-checks" style="margin-top:6px;">
                            <label title="A vanilla glow visual fills all five anchor slots, so where anchors 0..4 sit is the whole look. Many source models bunch all five on the blade — spreading them evenly hilt-to-tip gives the vanilla enchant look instead of one lump."><input type="checkbox" id="tbcGlowSpread"> spread glow along weapon</label>
                        </div>
                        <div id="tbcVisualNote" style="font-size:11px;color:var(--text-muted);margin-top:4px;">Preview a weapon to see its source glow and the chosen one. Glows render in-game only.</div>
                        <div id="tbcGlowCoverage" style="font-size:11px;color:var(--text-muted);margin-top:6px;padding-top:6px;border-top:1px dashed var(--border-light);">Checking TBC glow coverage…</div>
                    </div>
                    <div class="wf-group" title="Pre-import recolor: tick 'recolor skin' and pick a primary colour — the palette engine shifts the rest of the skin to match, live in the preview, and bakes it into the shipped BLP when you forge. Cycle the theories to compare. 'Tint glow / flame' recolors the animated glow/particle effects: live in the preview, baked into the M2 emitter colour on forge.">
                        <div class="wf-group-title"><span>Recolor (pre-import)</span></div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="tbcRcOn"> recolor skin</label>
                            <input type="color" id="tbcRcColor" value="#3b6fd4" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                            <button type="button" class="wf-btn secondary" id="tbcRcDetect" style="padding:4px 10px;font-size:12px;">Detect from item</button>
                            <label style="display:flex;align-items:center;gap:5px;font-size:12px;">Tier
                                <select id="tbcRcTier">
                                    <option value="subtle">Subtle</option>
                                    <option value="improved" selected>Improved</option>
                                    <option value="bold">Bold</option>
                                    <option value="extreme">Extreme</option>
                                </select>
                            </label>
                        </div>
                        <div id="tbcRcTheories" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px dashed var(--border-light);">
                            <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="tbcRcGlowOn"> tint glow / flame effects</label>
                            <input type="color" id="tbcRcGlowColor" value="#33aaff" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                            <span id="tbcRcGlowNote" style="font-size:11px;color:var(--text-muted);">Recolors compositing effect sheets and rebuilt emitters in preview and forge; movement stays intact.</span>
                        </div>
                        <div id="tbcRcStatus" style="font-size:11px;color:var(--text-muted);margin-top:6px;"></div>
                    </div>
                </div>
                <div class="wf-note">
                    The forged item gets the chosen family's vanilla stats/sounds while a named TBC item's authentic
                    equip slot, sheath, and swing delay are preserved. Enchant-glow attachment points come from the
                    vanilla donor scaffold, not the TBC model. Source geometry, texture units, wrap flags,
                    blend modes, overlay order, UV0/UV1, rest-pose color/transparency/UV transforms, and BLP2 mip
                    data are preserved. Compatible global UV animation is transplanted into vanilla; the Web preview
                    shows its rest frame. Unsupported animated material tracks and TBC ribbon/particle emitters are
                    reported instead of being silently discarded.
                </div>
            </div>

            <div class="wf-card">
                <h3><span class="phase">WotLK</span> Import from WotLK client</h3>
                <p>Browse the weapons of a <strong>WotLK (3.3.5a) client</strong> by item name and forge them into vanilla
                   items — the same fidelity route as the TBC import. 3.3.5a models are v264 with external <code>.skin</code>
                   profiles; the forge reads both, re-emits the geometry as a native vanilla M2 on the selected family's
                   donor scaffold and packages compatible BLP2 textures byte-for-byte. Item names, quality, ilvl, slot,
                   sheath and swing delay come from the shipped open-source 3.3.5a item catalog (no WotLK database needed).
                   Set the <strong>WotLK Client Data Path</strong> on the <a href="/Settings">Settings page</a>.</p>
                <div id="wotlkState" style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Checking WotLK mount…</div>
                <div class="wf-row">
                    <button class="wf-btn secondary" data-action="wotlkBrowse" id="wotlkBrowseBtn" disabled>
                        <i class="fa-solid fa-magnifying-glass"></i> Browse WotLK weapons…</button>
                    <div class="wf-field" style="flex:1;min-width:200px;"><label>Selected model</label>
                        <input type="text" id="wotlkSelected" readonly placeholder="nothing selected" style="width:100%;"></div>
                    <div class="wf-field" title="Chooses the vanilla weapon family and donor scaffold; a named WotLK item's own One-Hand/Main Hand/Off Hand slot is preserved separately">
                        <label>Weapon family</label>
                        <select id="wotlkType"><option value="sword1h" selected>1H Sword</option></select>
                    </div>
                    <div class="wf-field"><label>Name (optional)</label>
                        <input type="text" id="wotlkName" placeholder="auto from model"></div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field" title="Fidelity mode preserves the complete source topology and render-pass structure">
                        <label style="min-width:96px;">Geometry</label>
                        <input type="hidden" id="wotlkTarget" value="0">
                        <span class="val" id="wotlkTargetVal">exact source</span>
                    </div>
                    <label class="wf-check" title="Show where the hands land: green band = main-hand palm (model origin, exact); blue band ≈ off-hand on two-handers (approximate). Off by default — a WotLK import keeps the source's own hand placement, so it is always in the right spot."><input type="checkbox" id="wotlkShowGrip"> grip markers</label>
                    <button class="wf-btn secondary" data-action="wotlkPreview" id="wotlkPreviewBtn" disabled>Preview</button>
                    <button class="wf-btn" data-action="wotlkForge" id="wotlkForgeBtn" disabled><i class="fa-solid fa-sliders"></i> Configure item…</button>
                </div>
                <div class="wf-groups" style="margin-top:10px;">
                    <div class="wf-group" title="Auto carries the source weapon's OWN glow across: WotLK hangs most permanent glows on the display row (ItemDisplayInfo.ItemVisual) exactly as vanilla does, and 1.12 ships most of the same ids, so they copy over unchanged. Models that glow through particle emitters instead get the nearest vanilla match. Anchors are moved onto the WotLK blade.">
                        <div class="wf-group-title"><span>Glow (ItemVisual)</span></div>
                        <div class="wf-ctl">
                            <label>Enchant glow</label>
                            <select id="wotlkVisual" style="flex:1;min-width:160px;"><option value="-1">Auto (source glow, else suggest from effects)</option><option value="0">None</option></select>
                        </div>
                        <div class="wf-checks" style="margin-top:6px;">
                            <label title="A vanilla glow visual fills all five anchor slots, so where anchors 0..4 sit is the whole look. Many source models bunch all five on the blade — spreading them evenly hilt-to-tip gives the vanilla enchant look instead of one lump."><input type="checkbox" id="wotlkGlowSpread"> spread glow along weapon</label>
                        </div>
                        <div id="wotlkVisualNote" style="font-size:11px;color:var(--text-muted);margin-top:4px;">Preview a weapon to see its source glow and the chosen one. Glows render in-game only.</div>
                        <div id="wotlkGlowCoverage" style="font-size:11px;color:var(--text-muted);margin-top:6px;padding-top:6px;border-top:1px dashed var(--border-light);">Checking WotLK glow coverage…</div>
                    </div>
                    <div class="wf-group" title="Pre-import recolor: tick 'recolor skin' and pick a primary colour — the palette engine shifts the rest of the skin to match, live in the preview, and bakes it into the shipped BLP when you forge. Cycle the theories to compare. 'Tint glow / flame' recolors the animated glow/particle effects: live in the preview, baked into the M2 emitter colour on forge.">
                        <div class="wf-group-title"><span>Recolor (pre-import)</span></div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="wotlkRcOn"> recolor skin</label>
                            <input type="color" id="wotlkRcColor" value="#3b6fd4" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                            <button type="button" class="wf-btn secondary" id="wotlkRcDetect" style="padding:4px 10px;font-size:12px;">Detect from item</button>
                            <label style="display:flex;align-items:center;gap:5px;font-size:12px;">Tier
                                <select id="wotlkRcTier">
                                    <option value="subtle">Subtle</option>
                                    <option value="improved" selected>Improved</option>
                                    <option value="bold">Bold</option>
                                    <option value="extreme">Extreme</option>
                                </select>
                            </label>
                        </div>
                        <div id="wotlkRcTheories" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px dashed var(--border-light);">
                            <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="wotlkRcGlowOn"> tint glow / flame effects</label>
                            <input type="color" id="wotlkRcGlowColor" value="#33aaff" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                            <span id="wotlkRcGlowNote" style="font-size:11px;color:var(--text-muted);">Recolors compositing effect sheets and rebuilt emitters in preview and forge; movement stays intact.</span>
                        </div>
                        <div id="wotlkRcStatus" style="font-size:11px;color:var(--text-muted);margin-top:6px;"></div>
                    </div>
                </div>
                <div class="wf-note">
                    Same contract as the TBC import: the forged item gets the chosen family's vanilla stats/sounds while the
                    WotLK item's authentic equip slot, sheath and swing delay are preserved — <strong>DPS is never carried</strong>,
                    damage is yours to set in the item configuration. Source geometry, texture units, wrap flags, blend modes,
                    overlay order (built-in glow passes included), UV0/UV1, rest-pose color/transparency/UV transforms and BLP2
                    mip data are preserved; compatible global UV animation is transplanted. Unsupported animated material
                    tracks and ribbon/particle emitters are reported, not silently discarded.
                </div>
            </div>


            <div class="wf-card">
                <h3><span class="phase">Clone</span> Vanilla weapon</h3>
                <p id="vanillaState">Clone an existing <strong>vanilla weapon or shield</strong> into a new custom item and
                   re-itemize it (name, quality, damage, speed, stats, effects, price). It reuses the source's own
                   display — model, texture, icon, sheath, grip and sound are already in your client — so
                   <strong>nothing is packaged</strong>: no patch, no download, no client restart. Usable via
                   <code>.additem</code> as soon as the core reloads. <strong>Unless you recolor its skin</strong> — that
                   creates a new display and texture in the patch while copying the stock M2 byte-for-byte. Authored
                   bones, global loops, billboards, material animation and hardcoded glow sheets therefore stay intact.
                   Leave the recolor box unticked and it stays a pure clone. Reads the live world database, so unlike the
                   TBC and WotLK lanes it needs no client path in Settings.</p>
                <div class="wf-row">
                    <div class="wf-field" style="flex:1;min-width:220px;">
                        <label>Search vanilla weapons</label>
                        <input type="text" id="vanillaSearch" placeholder="Search by name or item id — e.g. Thunderfury, Quel'Serrar, 17182…" style="width:100%;">
                    </div>
                    <div class="wf-field" title="Filter by weapon family">
                        <label>Family</label>
                        <select id="vanillaFamily"><option value="">All families</option></select>
                    </div>
                </div>
                <div id="vanillaResults" class="wf-modal-list" style="max-height:260px;margin-top:8px;">
                    <div style="padding:14px;color:var(--text-muted);font-size:12px;">Search to browse vanilla weapons.</div>
                </div>
                <div class="wf-row" style="margin-top:10px;">
                    <div class="wf-field" style="flex:1;min-width:200px;">
                        <label>Selected</label>
                        <input type="text" id="vanillaSelected" readonly placeholder="nothing selected" style="width:100%;">
                    </div>
                    <label class="wf-check" title="Show where the main hand lands: green band at the model origin, where the palm wraps. Off by default — a stock vanilla display is already placed correctly."><input type="checkbox" id="vanillaShowGrip"> grip markers</label>
                    <button class="wf-btn" data-action="vanillaClone" id="vanillaCloneBtn" disabled>
                        <i class="fa-solid fa-sliders"></i> Configure item…</button>
                </div>
                <div class="wf-group" title="Recolor the stock Type-2 display skin without rebuilding its M2. Leave both off and this stays a pure clone: nothing is packaged.">
                    <div class="wf-group-title"><span>Recolor (optional)</span></div>
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="vanillaRcOn"> recolor skin</label>
                        <input type="color" id="vanillaRcColor" value="#3b6fd4" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                        <label style="display:flex;align-items:center;gap:5px;font-size:12px;">Tier
                            <select id="vanillaRcTier">
                                <option value="subtle">Subtle</option>
                                <option value="improved" selected>Improved</option>
                                <option value="bold">Bold</option>
                                <option value="extreme">Extreme</option>
                            </select>
                        </label>
                    </div>
                    <div id="vanillaRcTheories" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;"></div>
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px dashed var(--border-light);">
                        <label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" id="vanillaRcGlowOn"> recolor native glow / material effects</label>
                        <input type="color" id="vanillaRcGlowColor" value="#33aaff" style="width:40px;height:26px;padding:0;border:1px solid var(--border-color);border-radius:6px;background:none;">
                        <span style="font-size:11px;color:var(--text-muted);">Safely isolated Type-0 geometry, particle, and ribbon sheets become private copies; shared ItemVisual and Type-3 effects stay stock.</span>
                    </div>
                    <div id="vanillaRcStatus" style="font-size:11px;color:var(--text-muted);margin-top:8px;">
                        Both off — pure clone, nothing packaged.
                    </div>
                </div>
                <div class="wf-note">
                    The clone keeps the source's <strong>equip slot and weapon subclass</strong> — a stock display cannot be
                    re-scaffolded for a different family, so slot changes belong to the import lanes, which build a model for
                    the family they claim. Everything the config modal does not express (sheath, sound, ammo type, range)
                    rides across from the source verbatim. The Configure modal is <em>pre-filled from the source item</em>, so
                    what you edit starts from its real values rather than from blank defaults. Clones do not appear in the
                    Forged Weapons list below — that list is keyed on custom displays and a clone has none — manage them from
                    the <a href="/Items">Items page</a>, or undo one from the <a href="/Changes">Change Graph</a>.
                </div>
            </div>

            <div class="wf-card">
                <h3><span class="phase">Registry</span> Forged Weapons</h3>
                <p>The weapons currently in the registry — the weapons inside <code>patch-4.MPQ</code>.
                   <strong>View</strong> renders a weapon's stored M2+BLP in the viewer. <strong>Delete</strong>
                   removes it from the game: world-database row, registry entry, and (at the next rebuild) the
                   packaged patch; its IDs return to the pool. Forges and deletes <strong>queue</strong> a patch
                   rebuild rather than running one each time: forge as many as you like, then close WoW and click
                   <strong>Rebuild patch</strong> once to package every lane (weapons, armor, retextures) and deploy
                   it. All forge and delete actions are recorded in the Activity Log.</p>
                <div id="wfWeapons" class="wf-weapons"><span style="color:var(--text-muted);font-size:12px;">Loading…</span></div>
                <div class="wf-row" style="margin-top:10px;">
                    <button class="wf-btn secondary" id="wfDeleteSelected" disabled title="Delete every ticked weapon in one go: one world reload, one repack, one queued patch rebuild.">Delete selected</button>
                    <button class="wf-btn secondary" data-action="rebuildPatch" title="Package every queued change into patch-4.MPQ and deploy it to the client Data folder. Close WoW first — a running client locks the file.">Rebuild patch</button>
                    <a class="wf-btn secondary" href="/WeaponForge/DownloadPatch" style="text-decoration:none;">
                        <i class="fa-solid fa-download"></i> Download current patch-4.MPQ</a>
                </div>
            </div>

        </div>

        <div class="wf-preview">
            <div class="wf-viewer" id="wfViewer"><div class="hint" id="wfHint">Preview a model to inspect it here</div>
                <div class="wf-cameras"><button data-camera="three">3/4</button><button data-camera="front">front</button><button data-camera="edge">edge</button><button id="wfGrid" title="Show or hide the floor grid">grid</button><button id="wfExpand" title="Expand viewer">⤢ expand</button></div></div>
            <div class="wf-result" id="wfResult">
                <div class="title">Ready</div>
                <div style="color:var(--text-muted);">Results, IDs, downloads, and diagnostics appear here.</div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

