    </script>
    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { applyBlendSuffix, applyEnvMapping, applyMultiTexture } from '/js/character-viewer/blend-suffix.js';
        import { installM2Fx } from '/js/character-viewer/m2fx.js';

        // ---------- 3D viewer ----------
        const host = document.getElementById('wfViewer');
        const hint = document.getElementById('wfHint');
        let renderer, scene, camera, controls, current = null, grid = null;
        // Material animation for the previewed weapon: colour / opacity / UV-scroll tracks the
        // server ships as a `suiFx` manifest inside the GLB. A forged weapon that got a glow pulse
        // written into its M2 renders frozen at the pulse's dimmest key without this.
        let fx = null;
        const fxClock = new THREE.Clock();
        let fxElapsedMs = 0;

        function initViewer() {
            const w = host.clientWidth, h = host.clientHeight;
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setPixelRatio(window.devicePixelRatio || 1);
            renderer.setSize(w, h);
            host.appendChild(renderer.domElement);

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, w / h, 0.01, 100);
            camera.position.set(1.4, 0.9, 1.4);

            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;

            scene.add(new THREE.HemisphereLight(0xffffff, 0x30343c, 1.1));
            const dir = new THREE.DirectionalLight(0xffffff, 1.4);
            dir.position.set(2, 3, 2); scene.add(dir);
            grid = new THREE.GridHelper(2, 20, 0x3a4150, 0x262b33);
            grid.position.y = -0.001; scene.add(grid);
            // The grid is a reading aid, not part of the weapon; remember the choice per browser.
            let gridOn = true;
            try { gridOn = localStorage.getItem('wfGrid') !== 'off'; } catch { }
            setGrid(gridOn);

            window.addEventListener('resize', onResize);
            animate();
        }
        function onResize() {
            if (!renderer) return;
            const w = host.clientWidth, h = host.clientHeight;
            renderer.setSize(w, h); camera.aspect = w / h; camera.updateProjectionMatrix();
        }
        function animate() {
            requestAnimationFrame(animate);
            const dt = fxClock.getDelta();
            if (fx) {
                const dtMs = dt * 1000;
                fxElapsedMs += dtMs;
                try { fx.update(fxElapsedMs, dtMs, camera); }
                catch (err) { console.warn('[weaponforge] m2fx failed; dropping it', err); fx = null; }
            }
            controls && controls.update();
            renderer && renderer.render(scene, camera);
        }

        const loader = new GLTFLoader();

        // One serial for the viewer, and a record of which lane's model is on screen.
        //
        // GLTFLoader.load is async and its success callback used to run unconditionally, so a load
        // started before a deselect (or before a newer selection) still painted itself into the scene
        // afterwards. That was theoretical while every preview needed a button press; the vanilla lane
        // fires one on every row click, so it is routine. Both loadGlb and clearViewer bump the serial
        // and the callbacks drop themselves when it has moved on.
        //
        // viewerOwner exists because the viewer is SHARED by four sources (the two import lanes, the
        // GLB upload, the registry's View button and the vanilla lane). Only the source that put the
        // model there may take it away.
        let glbSerial = 0;
        let viewerOwner = null;

        // Empty the viewer and put the hint back. Extracted from loadGlb's teardown so a DESELECT can
        // reach it: the vanilla lane previews on selection, and without this a cleared selection left
        // the previous weapon on screen next to an empty "Selected" box and a greyed Configure button —
        // the operator reading a stale model as the thing they were about to clone.
        function clearViewer() {
            ++glbSerial;                       // invalidate anything still in flight
            if (current) { scene.remove(current); current = null; }
            if (fx) { try { fx.dispose(); } catch { } fx = null; }
            // The glow tint reschedules itself for as long as wfGlow.color is set; without this it kept
            // writing into the materials of the model that was just removed, pinning it alive.
            wfGlowWanted = null;
            wfClearGlow();
            wfGlow.mats = [];
            lastGrip = null;
            drawGripMarkers();
            viewerOwner = null;
            hint.style.display = '';
        }

        // Clear ONLY if the caller is the source whose model is showing. Lets a lane tidy up after
        // itself without blanking a preview another lane put there.
        function clearViewerOwnedBy(owner) { if (viewerOwner === owner) clearViewer(); }

        function loadGlb(url, owner) {
            if (!url) return;
            const serial = ++glbSerial;
            hint.style.display = 'none';
            // The on-demand item-GLB cache stamps its own `?source=` fingerprint onto the path, so the
            // cache-buster has to join with the right separator or it lands inside that query value.
            loader.load(url + (url.includes('?') ? '&' : '?') + 't=' + Date.now(), (gltf) => {
                if (serial !== glbSerial) return;   // a newer load, or a clear, won the race
                if (current) { scene.remove(current); }
                if (fx) { try { fx.dispose(); } catch { } fx = null; }
                viewerOwner = owner || null;
                const model = gltf.scene;
                // Keep the authored glTF material (including its sidedness and alpha mode), then
                // restore the WoW-only blend/static-alpha state encoded in its material name.
                // Replacing materials here used to turn every pass into an alpha-keyed,
                // double-sided opaque surface, hiding culling errors and destroying glow layers.
                applyBlendSuffix(model);
                applyEnvMapping(model);   // WoW env-mapped passes → matcap (flowing blade reflections)
                try { fx = installM2Fx(gltf); }
                catch (err) { console.warn('[weaponforge] m2fx install failed', err); fx = null; }
                applyMultiTexture(model); // multi-texture MODULATE passes → the undulating energy wave
                                          // (after m2fx: it owns the material m2fx animates the scroll on)
                current = model; scene.add(model);
                frameObject(model);
                drawGripMarkers();
                wfGlowRefresh(); // re-apply the recolor group's glow tint to the fresh materials
            }, undefined, (err) => {
                if (serial !== glbSerial) return;
                setResult({ title: 'Preview failed', error: String(err) });
            });
        }

        // ---------- live glow/flame tint (Recolor group) ----------
        // Walk the previewed model, tint additive-glow materials and M2Emitter particle materials,
        // and re-apply each frame so the m2fx engine's per-frame colour writes don't clobber it —
        // the same approach the Armor Forge character viewer uses. The baked equivalent on forge is
        // the M2 emitter colour-track override (glowColor).
        const wfGlow = { color: null, mats: [], raf: null };
        let wfGlowWanted = null; // [r,g,b] 0..1 from the previewing lane's controls, or null
        function wfCollectGlowMats() {
            wfGlow.mats = [];
            if (!current) return;
            current.traverse(node => {
                if (!node.isMesh || !node.material) return;
                const mats = Array.isArray(node.material) ? node.material : [node.material];
                const isEmitter = node.name === 'M2Emitter';
                for (const mat of mats) {
                    if (!mat || !mat.color) continue;
                    // Blend-3/4 name suffix marks WoW additive glow shells; emitters are the flames.
                    const isAdditive = mat.blending === THREE.AdditiveBlending || /_blend[34]/.test(mat.name || '');
                    if (isAdditive || isEmitter) wfGlow.mats.push(mat);
                }
            });
        }
        function wfGlowTick() {
            if (!wfGlow.color) { wfGlow.raf = null; return; }
            for (const mat of wfGlow.mats) { mat.color.setRGB(wfGlow.color[0], wfGlow.color[1], wfGlow.color[2]); mat.needsUpdate = true; }
            wfGlow.raf = requestAnimationFrame(wfGlowTick);
        }
        function wfTintGlow(rgb) { wfCollectGlowMats(); wfGlow.color = rgb; if (!wfGlow.raf) wfGlowTick(); return wfGlow.mats.length; }
        function wfClearGlow() { wfGlow.color = null; }
        function wfGlowRefresh() { if (wfGlowWanted) wfTintGlow(wfGlowWanted); else wfClearGlow(); }

        // ---------- grip markers ----------
        // The weapon mounts to the character's hand bone AT ITS ORIGIN, so the green band at x=0 is
        // exactly where the palm wraps. The blue band (two-handers) marks the approximate off-hand
        // zone — the character animation places that hand, not the weapon file.
        //
        // Each lane owns its own toggle. Only the GLB import defaults ON: a raw web GLB has no
        // idea where the hand goes, so the marker is the whole point of its placement sliders.
        // TBC / WotLK imports and vanilla clones keep the source's own placement, which is always
        // in the right spot, so their markers are opt-in.
        let lastGrip = null, gripGroup = null;
        const GRIP_TOGGLES = { glb: 'impShowGrip', tbc: 'tbcShowGrip', wotlk: 'wotlkShowGrip', vanilla: 'vanillaShowGrip' };
        function gripToggleFor(owner) {
            // A forge result is shown under 'forged'; it came from whichever lane the modal was
            // configuring, so follow that lane's toggle.
            const key = owner === 'forged' ? (itemBuildState.mode || 'glb') : owner;
            return document.getElementById(GRIP_TOGGLES[key] || 'impShowGrip');
        }
        function gripMarkersOn() {
            const cb = gripToggleFor(viewerOwner);
            return !!(cb && cb.checked);
        }
        // A stock display carries no forge grip payload, but its origin IS the palm (the weapon mounts
        // to the hand bone at its origin), so when asked for, size the band from the mesh itself.
        function estimatePalmRadius(model) {
            const box = new THREE.Box3().setFromObject(model);
            const len = Math.max(box.max.x - box.min.x, 1e-3);
            const v = new THREE.Vector3();
            let r = 0;
            model.traverse(node => {
                if (!node.isMesh || !node.geometry || !node.geometry.attributes.position) return;
                const pos = node.geometry.attributes.position;
                for (let i = 0; i < pos.count; i++) {
                    v.fromBufferAttribute(pos, i); node.localToWorld(v);
                    if (Math.abs(v.x) > len * 0.03) continue;   // only the slice through the origin
                    r = Math.max(r, Math.hypot(v.y, v.z));
                }
            });
            return r || Math.min(box.max.y - box.min.y, box.max.z - box.min.z) / 2;
        }
        function drawGripMarkers() {
            if (gripGroup) { scene.remove(gripGroup); gripGroup = null; }
            if (!current || !gripMarkersOn()) return;
            const grip = lastGrip || { palm: { radius: estimatePalmRadius(current) } };
            gripGroup = new THREE.Group();
            addGripBand(0, grip.palm.radius, 0x38e06c);
            if (grip.secondHand) addGripBand(grip.secondHand.x, grip.secondHand.radius, 0x38b6ff);
            scene.add(gripGroup);
        }
        function addGripBand(x, r, color) {
            const R = Math.max((r || 0) * 1.3, 0.028);
            const mat = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.9, depthTest: false });
            const band = new THREE.Mesh(new THREE.TorusGeometry(R, Math.max(R * 0.10, 0.006), 12, 48), mat);
            band.rotation.y = Math.PI / 2;   // torus axis → +X so the band wraps the shaft
            band.position.set(x, 0, 0);
            band.renderOrder = 2;
            gripGroup.add(band);
            // A short axis tick through the band makes the station readable edge-on.
            const tick = new THREE.Mesh(new THREE.CylinderGeometry(R * 0.045, R * 0.045, R * 2.6, 8), mat);
            tick.position.set(x, 0, 0);
            tick.renderOrder = 2;
            gripGroup.add(tick);
        }
        Object.values(GRIP_TOGGLES).forEach(id => document.getElementById(id).addEventListener('change', drawGripMarkers));
        function frameObject(obj) {
            const box = new THREE.Box3().setFromObject(obj);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());
            const maxDim = Math.max(size.x, size.y, size.z) || 1;
            controls.target.copy(center);
            camera.position.copy(center).add(new THREE.Vector3(maxDim * 1.6, maxDim * 1.1, maxDim * 1.6));
            camera.near = maxDim / 100; camera.far = maxDim * 100; camera.updateProjectionMatrix();
            controls.update();
        }
        function setDiagnosticCamera(kind) {
            if (!current) return; const box = new THREE.Box3().setFromObject(current), size=box.getSize(new THREE.Vector3()), center=box.getCenter(new THREE.Vector3());
            const d=Math.max(size.x,size.y,size.z)*1.7; controls.target.copy(center);
            const offset = kind==='front' ? new THREE.Vector3(0,0,d) : (kind==='edge' ? new THREE.Vector3(0,d,0) : new THREE.Vector3(d*.8,d*.55,d*.8));
            camera.position.copy(center).add(offset); camera.up.set(0,1,0); camera.lookAt(center); controls.update();
        }
        document.querySelectorAll('[data-camera]').forEach(b => b.addEventListener('click', () => setDiagnosticCamera(b.dataset.camera)));
        function setGrid(on) {
            if (grid) grid.visible = on;
            const b = document.getElementById('wfGrid');
            b.textContent = on ? 'grid' : 'grid off';
            b.style.opacity = on ? '' : '0.6';
            try { localStorage.setItem('wfGrid', on ? 'on' : 'off'); } catch { }
        }
        document.getElementById('wfGrid').addEventListener('click', () => setGrid(!grid.visible));
        document.getElementById('wfExpand').addEventListener('click', () => {
            const v = document.getElementById('wfViewer');
            const on = v.classList.toggle('expanded');
            document.getElementById('wfExpand').textContent = on ? '⤢ close' : '⤢ expand';
            requestAnimationFrame(() => { onResize(); if (current) frameObject(current); });
        });
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const v = document.getElementById('wfViewer');
                if (v.classList.contains('expanded')) { v.classList.remove('expanded'); document.getElementById('wfExpand').textContent = '⤢ expand'; requestAnimationFrame(() => { onResize(); if (current) frameObject(current); }); }
            }
        });

        // ---------- helpers ----------
        function esc(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function hexToHue(hex) {
            const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex); if (!m) return 0;
            const r = parseInt(m[1], 16) / 255, g = parseInt(m[2], 16) / 255, b = parseInt(m[3], 16) / 255;
            const mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn;
            let h = 0;
            if (d === 0) h = 0; else if (mx === r) h = ((g - b) / d) % 6; else if (mx === g) h = (b - r) / d + 2; else h = (r - g) / d + 4;
            h *= 60; if (h < 0) h += 360; return h;
        }
        // Saturation + lightness of the pick (0..1), so white/grey/black picks mean what they say.
        function hexToSL(hex) {
