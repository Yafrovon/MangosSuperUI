<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Controllers\BaselineController.cs" />
		<Content Include="Services\BodyAtlasTextureService.cs" />
		<!-- One canonical talent-profile manifest feeds both the research validator and
		     SuperUI's read-only visibility service. Embedding it prevents a publish from
		     silently losing the level-by-level plan. -->
		<EmbeddedResource Include="..\docs\bot-spec-research\talent_profiles.json"
		                  Link="BotLogic\Talents\talent_profiles.json"
		                  LogicalName="MangosSuperUI.BotLogic.Talents.talent_profiles.json" />
	</ItemGroup>

	<!-- Ship the canonical admin schema with every publish. The Linux setup script
	     applies it before the first service start, while DbInitializationService
	     remains the upgrade/self-healing path for existing installations. -->
	<ItemGroup>
		<None Update="sql\vmangos_admin_schema.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Scripts\*.sh">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.72" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.5" />
		<PackageReference Include="MySqlConnector" Version="2.5.0" />
		<PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<!-- NoDependencies, deliberately: the plain SkiaSharp.NativeAssets.Linux build
		     links libfontconfig.so.1, which is absent on a headless server install. When
		     it is missing, libSkiaSharp fails to dlopen and EVERY BLP->PNG conversion
		     throws TypeInitializationException — icons and 3D models all silently 404
		     while the MPQ layer reports perfectly healthy. This variant carries no such
		     host dependency, so the deploy works on a bare box with no apt step.
		     Tradeoff: no system font access. SKPaint text draws nothing (it does not
		     throw), which affects only the ItemsController / RetextureEngineController
		     "theory lab" contact-sheet labels. If those labels are ever needed again,
		     bundle a .ttf and load it with SKTypeface.FromFile rather than reinstating
		     the fontconfig-linked package. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
	</ItemGroup>

	<!-- Native StormLib binaries. Auto-discovered by .NET 8's DllImport
       resolver via the runtimes/{rid}/native/ convention. Committing
       these to the repo means anyone cloning SuperUI gets MPQ support
       out of the box — no separate StormLib install step.
       Condition="Exists(...)" so a missing platform binary (e.g. no
       storm.dll yet) doesn't break the build on the other platform. -->
	<ItemGroup>
		<None Include="runtimes\linux-x64\native\libstorm.so" Condition="Exists('runtimes\linux-x64\native\libstorm.so')">
			<Link>libstorm.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="runtimes\win-x64\native\storm.dll" Condition="Exists('runtimes\win-x64\native\storm.dll')">
			<Link>storm.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- server-config.json is the OPERATOR'S OWN config: real connection strings,
	     the RemoteAccess password, and machine-specific paths. The Web SDK's default
	     Content glob picks up **\*.json, so without this Remove it was staged into
	     bin\...\publish and shipped inside every release zip — overwriting the
	     recipient's config on extract (the profile sets DeleteExistingFiles) and
	     leaking the publisher's credentials. It stays gitignored AND out of the
	     publish output; the setup script writes it on the target box instead.
	     Kept as None so it is still visible/editable in Solution Explorer. -->
	<ItemGroup>
		<Content Remove="server-config.json" />
		<None Include="server-config.json" Condition="Exists('server-config.json')">
			<!-- still copied to bin\ so running the built exe locally finds it -->
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="BotLogic\Domains\**" />
		<Content Remove="BotLogic\Domains\**" />
		<!-- A legacy local deployment snapshot lives under publish/. It is not
		     application source and includes an old server-config.json; never nest
		     that tree (or its secrets and generated binaries) inside a fresh publish. -->
		<Compile Remove="publish\**" />
		<Content Remove="publish\**" />
		<EmbeddedResource Remove="publish\**" />
		<None Remove="publish\**" />
		<Content Remove="wwwroot\item_models\**" />
		<Content Remove="wwwroot\minimap\**" />
		<Content Remove="wwwroot\models\**" />
		<Content Remove="wwwroot\icons\**" />
		<EmbeddedResource Remove="BotLogic\Domains\**" />
		<None Remove="BotLogic\Domains\**" />
	</ItemGroup>


	<ItemGroup>
		<Folder Include="wwwroot\addons\MSUI_LootBrowser\" />
		<Folder Include="wwwroot\character_models\" />
		<Folder Include="wwwroot\character_textures\" />
	</ItemGroup>


	<ItemGroup>
	  <Content Update="wwwroot\data\curated-relationships.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- If you still want them available during local dev/build, add them back as None -->
	<!--
	<ItemGroup>
		<None Include="wwwroot\item_models\**" />
		<None Include="wwwroot\minimap\**" />
		<None Include="wwwroot\models\**" />
		<None Include="wwwroot\icons\**" />
	</ItemGroup>-->
	
	<ItemGroup>
    <Content Update="wwwroot\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
	</ItemGroup>

</Project>
